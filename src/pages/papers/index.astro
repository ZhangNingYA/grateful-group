---
import { getCollection } from 'astro:content';
import EditorialIndex from '../../components/EditorialIndex.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const entries = papers.map((paper) => ({
  href: `/papers/${paper.id}/`,
  title: paper.data.title,
  description: paper.data.description,
  date: paper.data.pubDate,
  meta: [paper.data.venue, paper.data.year].filter(Boolean).join(' / ') || 'Research paper',
}));
---

<EditorialIndex
  pageTitle={`Papers | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  active="papers"
  eyebrow="Papers"
  title="Research, read with context."
  lede="保存值得细读的论文、关键论证与方法脉络，把研究结论放回它真正发生作用的上下文。"
  edition="03"
  editionLabel="Research archive"
  sectionTitle="Paper notes"
  sectionNote="按发布日期排序"
  {entries}
/>
