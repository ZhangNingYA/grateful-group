---
import { getCollection, render } from 'astro:content';
import { ArrowDown, ArrowUpRight } from 'lucide-astro';
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import '../../styles/papers.css';

const papers = (await getCollection('papers')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const notes = await Promise.all(papers.map(async (paper) => {
  const { headings } = await render(paper);
  return {
    ...paper,
    questionCount: headings.filter((heading) => heading.depth === 2 && heading.text.startsWith('问：')).length,
  };
}));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Paper notes | ${SITE_TITLE}`}
      description="A personal research notebook. Papers explored one question at a time, with clear answers and the mathematics behind them."
    />
  </head>
  <body class="papers-page papers-index">
    <a class="papers-skip" href="#main">Skip to content</a>
    <BlogHeader active="papers" />

    <main id="main" class="papers-shell">
      <header class="notebook-hero">
        <div>
          <p class="papers-eyebrow"><span class="papers-dot" aria-hidden="true"></span> The research notebook</p>
          <h1>Good papers.<br /><em>Better questions.</em></h1>
          <p class="notebook-intro">A place to think through what I read.<br />One question, one explanation, one idea at a time.</p>
          <a class="notebook-jump" href="#notes">Explore the notes <ArrowDown size={15} stroke-width={1.6} /></a>
        </div>
        <aside class="notebook-margin" aria-label="About this notebook">
          <span class="papers-eyebrow">A reading practice</span>
          <p>Ask the obvious.<br />Follow the maths.<br />Keep what clicks.</p>
          <span class="notebook-total"><strong>{String(notes.length).padStart(2, '0')}</strong> {notes.length === 1 ? 'paper in the notebook' : 'papers in the notebook'}</span>
        </aside>
      </header>

      <section id="notes" class="notebook-collection" aria-labelledby="notes-heading">
        <div class="notebook-section-title">
          <h2 id="notes-heading">The notes <span>({String(notes.length).padStart(2, '0')})</span></h2>
          <span>Latest first</span>
        </div>
        <div class="notebook-list">
          {notes.map((note, index) => (
            <article class="notebook-entry">
              <a href={`/papers/${note.id}/`} class="notebook-entry-link">
                <span class="notebook-entry-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="notebook-entry-copy">
                  <div class="notebook-entry-meta"><span lang="zh-CN">{note.data.topic}</span>{note.data.year && <span>{note.data.year}</span>}</div>
                  <h3 lang="zh-CN">{note.data.indexTitle}</h3>
                  <p lang="zh-CN">{note.data.indexDescription}</p>
                  <div class="notebook-entry-details">
                    {note.questionCount > 0 && <span>{note.questionCount} {note.questionCount === 1 ? 'question' : 'questions'} & answers</span>}
                    <span>Noted <FormattedDate date={note.data.pubDate} /></span>
                  </div>
                </div>
                <span class="notebook-entry-open"><span>Open note</span><ArrowUpRight size={22} stroke-width={1.5} /></span>
              </a>
            </article>
          ))}
        </div>
        {notes.length === 0 && <p class="notebook-empty">The notebook is open. The first question is still to come.</p>}
        <p class="notebook-endnote">An open notebook. Always a question in progress.</p>
      </section>
    </main>

    <footer class="papers-footer papers-shell">
      <a href="/">Tend <span> / A personal practice</span></a>
      <span>Stay curious.</span>
    </footer>
  </body>
</html>
