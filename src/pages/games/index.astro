---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('games')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const togetherDate = new Date(2025, 9, 18);
const now = new Date();
const daysPassed = Math.floor((now.getTime() - togetherDate.getTime()) / 864e5);
const weeks = Math.floor(daysPassed / 7);
const months = Math.floor(daysPassed / 30);
const hoursTotal = daysPassed * 24;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700;1,9..144,900&family=JetBrains+Mono:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <!-- Ambient layered background ------------------------------ -->
        <div class="bg-stage" aria-hidden="true">
            <div class="aurora aurora-1"></div>
            <div class="aurora aurora-2"></div>
            <div class="aurora aurora-3"></div>
            <div class="grain"></div>
        </div>

        <!-- Drifting bokeh dots ------------------------------------- -->
        <div class="bokeh" aria-hidden="true">
            <span class="dot d1"></span>
            <span class="dot d2"></span>
            <span class="dot d3"></span>
            <span class="dot d4"></span>
            <span class="dot d5"></span>
            <span class="dot d6"></span>
            <span class="dot d7"></span>
            <span class="dot d8"></span>
        </div>

        <!-- Cursor halo (follows mouse on desktop) ------------------ -->
        <div class="halo" id="halo" aria-hidden="true"></div>

        <main class="page">
            <!-- Mini chip header ------------------------------------ -->
            <nav class="topchip">
                <span class="chip-pulse"></span>
                <span>diary · vol.001</span>
                <span class="chip-sep">/</span>
                <span id="todayDate">2025.01.01</span>
            </nav>

            <!-- ============== HERO · ORBITAL DIAL =============== -->
            <section class="orbit">
                <p class="orbit-greeting">
                    <span class="hand">致最甜的</span> <em>🐷</em>
                </p>

                <div class="orbit-stage">
                    <!-- Background concentric rings -->
                    <svg class="orbit-rings" viewBox="0 0 600 600" aria-hidden="true">
                        <defs>
                            <radialGradient id="ringGlow" cx="50%" cy="50%" r="50%">
                                <stop offset="60%" stop-color="rgba(255,255,255,0)"/>
                                <stop offset="100%" stop-color="rgba(212,70,123,0.10)"/>
                            </radialGradient>
                            <linearGradient id="ringStroke" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#d4467b"/>
                                <stop offset="50%" stop-color="#e89855"/>
                                <stop offset="100%" stop-color="#a87bd6"/>
                            </linearGradient>
                        </defs>
                        <circle cx="300" cy="300" r="290" fill="url(#ringGlow)" />
                        <circle cx="300" cy="300" r="240" fill="none" stroke="rgba(58,36,71,0.10)" stroke-width="1" stroke-dasharray="2 6" />
                        <circle cx="300" cy="300" r="200" fill="none" stroke="rgba(58,36,71,0.14)" stroke-width="1" />
                        <circle class="orbit-arc" cx="300" cy="300" r="200" fill="none" stroke="url(#ringStroke)" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="60 1200" />
                        <!-- Tick marks (12 around) -->
                        {Array.from({ length: 24 }).map((_, i) => {
                          const a = (i / 24) * Math.PI * 2 - Math.PI / 2;
                          const r1 = i % 2 === 0 ? 218 : 222;
                          const r2 = 230;
                          const x1 = 300 + Math.cos(a) * r1;
                          const y1 = 300 + Math.sin(a) * r1;
                          const x2 = 300 + Math.cos(a) * r2;
                          const y2 = 300 + Math.sin(a) * r2;
                          return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(58,36,71,0.18)" stroke-width={i % 2 === 0 ? 1.4 : 0.7} />
                        })}
                    </svg>

                    <!-- Orbiting heart -->
                    <div class="orbit-heart" aria-hidden="true">
                        <span class="heart-glyph">♥</span>
                    </div>

                    <!-- Center glass disc -->
                    <div class="orbit-center">
                        <div class="orbit-eyebrow">DAYS TOGETHER</div>
                        <div class="orbit-number">
                            <span class="ndigits">{daysPassed}</span>
                            <span class="nunit">天</span>
                        </div>
                        <div class="orbit-since">since 2025·10·18</div>
                    </div>

                    <!-- Floating sparkles inside the stage -->
                    <span class="spark s1">✦</span>
                    <span class="spark s2">✧</span>
                    <span class="spark s3">·</span>
                    <span class="spark s4">✦</span>
                    <span class="spark s5">✧</span>
                </div>

                <!-- Quote + live ticker -->
                <p class="orbit-quote">
                    <span class="qmark">"</span> Every day with you is my <em>favorite</em> day. <span class="qmark">"</span>
                </p>

                <div class="orbit-ticker" id="liveTickerWrap">
                    <span class="dotpulse"></span>
                    <span class="ticker-label">LIVE</span>
                    <span class="ticker-val" id="liveTicker">—</span>
                    <span class="ticker-tag">共度时光</span>
                </div>

                <!-- Stat chips -->
                <div class="chips">
                    <div class="chip"><span class="chip-num">{months}</span><span class="chip-key">月</span></div>
                    <div class="chip"><span class="chip-num">{weeks}</span><span class="chip-key">周</span></div>
                    <div class="chip"><span class="chip-num">{daysPassed}</span><span class="chip-key">天</span></div>
                    <div class="chip"><span class="chip-num">{hoursTotal.toLocaleString()}</span><span class="chip-key">小时</span></div>
                </div>
            </section>

            <!-- ============== WAVE DIVIDER ====================== -->
            <div class="wave-div" aria-hidden="true">
                <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
                    <path d="M0 30 Q 150 0 300 30 T 600 30 T 900 30 T 1200 30 L1200 60 L0 60 Z" fill="rgba(255,255,255,0.4)" />
                    <path d="M0 30 Q 150 60 300 30 T 600 30 T 900 30 T 1200 30" fill="none" stroke="#d4467b" stroke-width="1.4" stroke-dasharray="2 6" opacity="0.45" />
                </svg>
                <span class="wave-glyph">❀</span>
            </div>

            <!-- ============== TIMELINE ========================== -->
            {posts.length > 0 && (
                <section class="timeline">
                    <header class="tl-head">
                        <div class="tl-eyebrow">
                            <span class="eb-dot"></span>
                            <span>MEMORY LANE</span>
                            <span class="eb-count">{String(posts.length).padStart(2, '0')}</span>
                        </div>
                        <h2 class="tl-title">
                            一些<em>琐碎</em>的<br/>日常与心动
                        </h2>
                        <p class="tl-lead">挑一段往下读，时间会替我们记住。</p>
                    </header>

                    <ol class="tl-list">
                        {posts.map((post, i) => (
                            <li class={`tl-item ${i % 2 === 0 ? 'left' : 'right'}`} data-reveal>
                                <span class="tl-line" aria-hidden="true"></span>
                                <span class="tl-node" aria-hidden="true"><span></span></span>
                                <a href={`/games/${post.id}/`} class="tl-card">
                                    <div class="tl-card-stamp">
                                        <span class="tl-card-no">{String(i + 1).padStart(2, '0')}</span>
                                        <span class="tl-card-date">
                                            <FormattedDate date={post.data.pubDate} />
                                        </span>
                                    </div>
                                    <h3 class="tl-card-title">{post.data.title}</h3>
                                    {post.data.description && (
                                        <p class="tl-card-desc">{post.data.description}</p>
                                    )}
                                    <div class="tl-card-foot">
                                        <span>展开阅读</span>
                                        <span class="tl-card-arrow">↗</span>
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )}

            <!-- ============== CLOSING ========================== -->
            <section class="closing" data-reveal>
                <div class="closing-mark">♡</div>
                <p class="closing-line">愿你所及之处，皆是温柔；愿你所求皆得，皆有所应。</p>
                <p class="closing-sign">— forever yours · {new Date().getFullYear()}</p>
            </section>
        </main>

        <script define:vars={{ togetherTime: togetherDate.getTime() }}>
            // -------- today's date in chip --------
            const today = new Date();
            const dateEl = document.getElementById('todayDate');
            if (dateEl) {
                const y = today.getFullYear();
                const m = String(today.getMonth() + 1).padStart(2, '0');
                const d = String(today.getDate()).padStart(2, '0');
                dateEl.textContent = `${y}.${m}.${d}`;
            }

            // -------- live ticker --------
            const ticker = document.getElementById('liveTicker');
            const updateTicker = () => {
                if (!ticker) return;
                const totalSec = Math.floor((Date.now() - togetherTime) / 1000);
                const h = Math.floor(totalSec / 3600);
                const m = Math.floor((totalSec % 3600) / 60);
                const s = totalSec % 60;
                ticker.textContent = `${h.toLocaleString()}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
            };
            updateTicker();
            setInterval(updateTicker, 1000);

            // -------- intersection-observer reveal --------
            const targets = document.querySelectorAll('[data-reveal]');
            if ('IntersectionObserver' in window && targets.length) {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach((e) => {
                        if (e.isIntersecting) {
                            e.target.classList.add('is-visible');
                            io.unobserve(e.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
                targets.forEach((t) => io.observe(t));
            } else {
                targets.forEach((t) => t.classList.add('is-visible'));
            }

            // -------- cursor halo --------
            const halo = document.getElementById('halo');
            if (halo && !matchMedia('(pointer: coarse)').matches) {
                let tx = window.innerWidth / 2;
                let ty = window.innerHeight / 2;
                let cx = tx, cy = ty;
                window.addEventListener('mousemove', (e) => {
                    tx = e.clientX;
                    ty = e.clientY;
                });
                const tick = () => {
                    cx += (tx - cx) * 0.08;
                    cy += (ty - cy) * 0.08;
                    halo.style.transform = `translate3d(${cx - 180}px, ${cy - 180}px, 0)`;
                    requestAnimationFrame(tick);
                };
                tick();
            }

            // -------- gentle parallax on the orbit (mouse only) --------
            const stage = document.querySelector('.orbit-stage');
            if (stage && !matchMedia('(pointer: coarse)').matches) {
                window.addEventListener('mousemove', (e) => {
                    const rect = stage.getBoundingClientRect();
                    const cx = rect.left + rect.width / 2;
                    const cy = rect.top + rect.height / 2;
                    const dx = (e.clientX - cx) / window.innerWidth;
                    const dy = (e.clientY - cy) / window.innerHeight;
                    stage.style.setProperty('--px', `${dx * 8}px`);
                    stage.style.setProperty('--py', `${dy * 6}px`);
                });
            }
        </script>
    </body>
</html>

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        font-family: 'Inter', -apple-system, sans-serif;
        color: #3a2447;
    }

    body {
        background: #fdf6f0;
        position: relative;
    }

    a { text-decoration: none; color: inherit; }

    /* ============== Ambient background ===================== */
    .bg-stage {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
        overflow: hidden;
    }
    .aurora {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.7;
        will-change: transform;
        animation: drift 28s ease-in-out infinite alternate;
    }
    .aurora-1 {
        width: 50vw; height: 50vw;
        top: -10%; left: -8%;
        background: radial-gradient(circle, rgba(255,180,194,0.55), transparent 70%);
    }
    .aurora-2 {
        width: 46vw; height: 46vw;
        top: 30%; right: -10%;
        background: radial-gradient(circle, rgba(214,168,237,0.45), transparent 70%);
        animation-delay: -8s;
    }
    .aurora-3 {
        width: 38vw; height: 38vw;
        bottom: -5%; left: 25%;
        background: radial-gradient(circle, rgba(255,212,140,0.45), transparent 70%);
        animation-delay: -16s;
    }
    @keyframes drift {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(40px, -30px) scale(1.08); }
        100% { transform: translate(-30px, 25px) scale(0.96); }
    }

    .grain {
        position: absolute; inset: 0;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.25 0 0 0 0 0.18 0 0 0 0 0.28 0 0 0 0.10 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
        opacity: 0.5;
        mix-blend-mode: multiply;
    }

    /* ============== Drifting bokeh ========================== */
    .bokeh { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
    .dot {
        position: absolute;
        width: 8px; height: 8px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(212,70,123,0.6), rgba(212,70,123,0));
        opacity: 0;
        animation: rise linear infinite;
    }
    .d1 { left: 8%;  bottom: -4%; animation-duration: 22s; animation-delay: 0s;  width: 10px; height: 10px; }
    .d2 { left: 22%; bottom: -4%; animation-duration: 28s; animation-delay: -6s; background: radial-gradient(circle, rgba(232,152,85,0.6), transparent); }
    .d3 { left: 38%; bottom: -4%; animation-duration: 34s; animation-delay: -12s; }
    .d4 { left: 52%; bottom: -4%; animation-duration: 26s; animation-delay: -3s; background: radial-gradient(circle, rgba(168,123,214,0.6), transparent); width: 12px; height: 12px; }
    .d5 { left: 64%; bottom: -4%; animation-duration: 30s; animation-delay: -9s; }
    .d6 { left: 74%; bottom: -4%; animation-duration: 24s; animation-delay: -15s; background: radial-gradient(circle, rgba(255,212,140,0.7), transparent); }
    .d7 { left: 84%; bottom: -4%; animation-duration: 32s; animation-delay: -18s; }
    .d8 { left: 92%; bottom: -4%; animation-duration: 26s; animation-delay: -22s; }
    @keyframes rise {
        0%   { transform: translateY(0)  scale(1); opacity: 0; }
        12%  { opacity: 0.85; }
        85%  { opacity: 0.55; }
        100% { transform: translateY(-110vh) scale(0.7); opacity: 0; }
    }

    /* ============== Cursor halo ============================ */
    .halo {
        position: fixed; top: 0; left: 0;
        width: 360px; height: 360px;
        pointer-events: none;
        z-index: 2;
        background: radial-gradient(circle, rgba(255,180,194,0.16), transparent 60%);
        mix-blend-mode: screen;
        transform: translate3d(-9999px, -9999px, 0);
    }
    @media (pointer: coarse) { .halo { display: none; } }

    /* ============== Page wrapper ============================ */
    .page {
        position: relative; z-index: 3;
        max-width: 1080px;
        margin: 0 auto;
        padding: 36px 32px 100px;
    }

    /* ============== Top chip ================================ */
    .topchip {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 7px 14px;
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(58,36,71,0.10);
        border-radius: 100px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(58,36,71,0.7);
    }
    .chip-pulse {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #d4467b;
        box-shadow: 0 0 0 0 rgba(212,70,123,0.5);
        animation: chipPulse 2s ease-in-out infinite;
    }
    .chip-sep { opacity: 0.35; }
    @keyframes chipPulse {
        0%   { box-shadow: 0 0 0 0 rgba(212,70,123,0.55); }
        70%  { box-shadow: 0 0 0 10px rgba(212,70,123,0); }
        100% { box-shadow: 0 0 0 0 rgba(212,70,123,0); }
    }

    /* ============== Hero · orbit ============================ */
    .orbit {
        position: relative;
        text-align: center;
        padding: 60px 0 40px;
    }

    .orbit-greeting {
        font-family: 'Fraunces', serif;
        font-style: italic; font-weight: 400;
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: rgba(58,36,71,0.7);
        margin-bottom: 24px;
        letter-spacing: 0.02em;
        animation: fadeUp 0.9s 0.1s ease-out both;
    }
    .orbit-greeting .hand {
        background: linear-gradient(90deg, transparent, rgba(255,212,180,0.35), transparent);
        padding: 2px 10px;
        border-radius: 100px;
    }
    .orbit-greeting em { font-style: normal; font-size: 1.4em; vertical-align: -0.1em; }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .orbit-stage {
        position: relative;
        width: min(540px, 90vw);
        aspect-ratio: 1;
        margin: 0 auto;
        animation: fadeUp 1.2s 0.2s ease-out both;
        transform: translate(var(--px, 0), var(--py, 0));
        transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .orbit-rings {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
    }
    .orbit-arc {
        animation: arcSpin 18s linear infinite;
        transform-origin: center;
    }
    @keyframes arcSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }

    .orbit-heart {
        position: absolute; top: 0; left: 50%;
        width: 0; height: 0;
        transform: translateX(-50%);
        animation: heartOrbit 16s linear infinite;
        z-index: 2;
    }
    .heart-glyph {
        position: absolute;
        top: -14px;
        left: 0;
        transform: translateX(-50%);
        font-size: 1.4rem;
        color: #d4467b;
        text-shadow: 0 0 14px rgba(212,70,123,0.55);
        animation: heartBeat 1.4s ease-in-out infinite;
    }
    @keyframes heartOrbit {
        from { transform: translateX(-50%) rotate(0deg) translateY(calc(min(540px,90vw)/2 * -0.66)) rotate(0deg); }
        to   { transform: translateX(-50%) rotate(360deg) translateY(calc(min(540px,90vw)/2 * -0.66)) rotate(-360deg); }
    }
    @keyframes heartBeat {
        0%, 100% { transform: translateX(-50%) scale(1); }
        25%      { transform: translateX(-50%) scale(1.25); }
        50%      { transform: translateX(-50%) scale(1); }
        75%      { transform: translateX(-50%) scale(1.18); }
    }

    .orbit-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 64%;
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(circle at 30% 25%, rgba(255,255,255,0.95), rgba(255,255,255,0.55) 60%, rgba(255,255,255,0.2) 100%);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.7);
        box-shadow:
            0 12px 40px rgba(212,70,123,0.18),
            inset 0 1px 1px rgba(255,255,255,0.8);
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 6px;
        animation: breathe 6s ease-in-out infinite;
    }
    @keyframes breathe {
        0%, 100% { transform: translate(-50%, -50%) scale(1); }
        50%      { transform: translate(-50%, -50%) scale(1.025); }
    }

    .orbit-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.66rem;
        letter-spacing: 0.32em;
        color: rgba(58,36,71,0.55);
        font-weight: 500;
    }
    .orbit-number {
        display: flex; align-items: baseline; gap: 8px;
        line-height: 0.85;
    }
    .ndigits {
        font-family: 'Fraunces', serif;
        font-style: italic; font-weight: 900;
        font-size: clamp(4.5rem, 14vw, 9rem);
        background: linear-gradient(135deg, #d4467b 0%, #e89855 50%, #a87bd6 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.05em;
    }
    .nunit {
        font-family: 'Fraunces', serif;
        font-weight: 300;
        font-size: clamp(1.4rem, 4vw, 2.4rem);
        color: rgba(58,36,71,0.5);
    }
    .orbit-since {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        color: rgba(58,36,71,0.5);
    }

    .spark {
        position: absolute;
        font-size: 0.95rem;
        color: rgba(212,70,123,0.6);
        pointer-events: none;
        animation: twinkle 4s ease-in-out infinite;
    }
    .s1 { top: 10%; left: 14%;  font-size: 1rem; color: #e89855; animation-delay: 0s; }
    .s2 { top: 18%; right: 12%; color: #a87bd6; animation-delay: -0.8s; }
    .s3 { bottom: 22%; left: 8%; font-size: 1.4rem; animation-delay: -1.6s; color: rgba(58,36,71,0.5); }
    .s4 { bottom: 12%; right: 18%; animation-delay: -2.4s; }
    .s5 { top: 50%; right: 4%; animation-delay: -3.2s; color: #e89855; }
    @keyframes twinkle {
        0%, 100% { opacity: 0.25; transform: scale(0.85); }
        50%      { opacity: 1; transform: scale(1.2); }
    }

    /* Quote */
    .orbit-quote {
        margin: 40px auto 22px;
        max-width: 32em;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.15rem, 2.2vw, 1.5rem);
        line-height: 1.55;
        color: rgba(58,36,71,0.85);
        animation: fadeUp 0.9s 0.5s ease-out both;
    }
    .orbit-quote em {
        font-weight: 700;
        background: linear-gradient(180deg, transparent 60%, rgba(255,212,180,0.7) 60%);
        padding: 0 4px;
        font-style: italic;
        color: #8b3a5c;
    }
    .qmark {
