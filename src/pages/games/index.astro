---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('games')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const togetherDate = new Date(2025, 9, 18);
const now = new Date();
const daysPassed = Math.floor((now.getTime() - togetherDate.getTime()) / 864e5);
const weeks = Math.floor(daysPassed / 7);
const months = Math.floor(daysPassed / 30);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=JetBrains+Mono:wght@300;400;500&family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>

    <body>
        <!-- Paper texture overlay -->
        <div class="paper-grain" aria-hidden="true"></div>

        <!-- Floating stickers -->
        <div class="stickers" aria-hidden="true">
            <span class="sticker sticker-1">🌸</span>
            <span class="sticker sticker-2">♡</span>
            <span class="sticker sticker-3">✦</span>
            <span class="sticker sticker-4">🐷</span>
        </div>

        <div class="magazine">
            <!-- Masthead -->
            <header class="masthead">
                <div class="mast-left">
                    <span class="mast-issue">ISSUE N°001</span>
                    <span class="mast-sep">·</span>
                    <span class="mast-date" id="todayDate"></span>
                </div>
                <div class="mast-title">LOVE · JOURNAL</div>
                <div class="mast-right">
                    <span class="mast-pill">EST. 2025.10.18</span>
                </div>
            </header>

            <!-- Editorial Hero -->
            <section class="cover">
                <div class="cover-side-text" aria-hidden="true">OUR LITTLE UNIVERSE</div>

                <div class="cover-main">
                    <div class="cover-kicker">
                        <span class="kicker-dot"></span>
                        <span>我和 🐖 的第</span>
                    </div>

                    <div class="cover-number">
                        <span class="big-digits">{daysPassed}</span>
                        <span class="big-unit">天</span>
                    </div>

                    <div class="cover-underline"></div>

                    <p class="cover-quote">
                        <span class="quote-mark">"</span>
                        Every day with you is my
                        <em>favorite</em> day.
                        <span class="quote-mark">"</span>
                    </p>

                    <div class="live-ticker">
                        <span class="ticker-label">LIVE</span>
                        <span class="ticker-dot"></span>
                        <span class="ticker-value" id="liveTicker">--:--:--</span>
                        <span class="ticker-note">共度时光</span>
                    </div>
                </div>

                <!-- Numeric index card (polaroid style) -->
                <div class="index-card">
                    <div class="card-header">
                        <span class="card-stamp">♡ MEMO</span>
                        <span class="card-no">N°001</span>
                    </div>

                    <dl class="card-stats">
                        <div class="card-row">
                            <dt>Months</dt>
                            <dd>{months}</dd>
                        </div>
                        <div class="card-row">
                            <dt>Weeks</dt>
                            <dd>{weeks}</dd>
                        </div>
                        <div class="card-row">
                            <dt>Days</dt>
                            <dd>{daysPassed}</dd>
                        </div>
                        <div class="card-row">
                            <dt>Hours</dt>
                            <dd>{daysPassed * 24}</dd>
                        </div>
                    </dl>

                    <div class="card-footer">
                        <span class="card-handwrite">— forever yours 🐷♡</span>
                    </div>
                </div>
            </section>

            <!-- Heartbeat divider -->
            <div class="heartbeat" aria-hidden="true">
                <svg viewBox="0 0 600 40" preserveAspectRatio="none" width="100%" height="40">
                    <path
                        d="M0 20 L80 20 L100 20 L110 10 L120 30 L130 5 L140 35 L150 20 L200 20 L220 20 L230 10 L240 30 L250 5 L260 35 L270 20 L320 20 L340 20 L350 10 L360 30 L370 5 L380 35 L390 20 L440 20 L460 20 L470 10 L480 30 L490 5 L500 35 L510 20 L600 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
                <span class="heart-icon">♡</span>
            </div>

            <!-- Chapter list -->
            {posts.length > 0 && (
                <section class="chapters">
                    <button class="chapters-toggle" id="listToggle" aria-expanded="false">
                        <div class="ch-toggle-left">
                            <span class="ch-toggle-chapter">CHAPTERS</span>
                            <span class="ch-toggle-title">我们的日常</span>
                        </div>
                        <div class="ch-toggle-right">
                            <span class="ch-toggle-count">{posts.length}</span>
                            <span class="ch-toggle-arrow" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </span>
                        </div>
                    </button>

                    <div class="chapters-list" id="listContent">
                        <ol class="entry-list">
                            {posts.map((post, i) => (
                                <li class="entry" style={`animation-delay: ${i * 0.05}s`}>
                                    <a href={`/games/${post.id}/`} class="entry-link">
                                        <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
                                        <span class="entry-rule" aria-hidden="true"></span>
                                        <div class="entry-content">
                                            <h3 class="entry-title">{post.data.title}</h3>
                                            {post.data.description && (
                                                <p class="entry-desc">{post.data.description}</p>
                                            )}
                                        </div>
                                        <time class="entry-date">
                                            <FormattedDate date={post.data.pubDate} />
                                        </time>
                                        <span class="entry-arrow" aria-hidden="true">→</span>
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </div>
                </section>
            )}

            <!-- Colophon -->
            <footer class="colophon">
                <div class="colophon-line"></div>
                <div class="colophon-text">
                    <span>PRINTED WITH</span>
                    <span class="colophon-heart">♥</span>
                    <span>FOR 🐖 · {new Date().getFullYear()}</span>
                </div>
                <div class="colophon-line"></div>
            </footer>
        </div>

        <script define:vars={{ togetherTime: togetherDate.getTime() }}>
            // Today's date in masthead
            const today = new Date();
            const dateEl = document.getElementById('todayDate');
            if (dateEl) {
                const y = today.getFullYear();
                const m = String(today.getMonth() + 1).padStart(2, '0');
                const d = String(today.getDate()).padStart(2, '0');
                dateEl.textContent = `${y}.${m}.${d}`;
            }

            // Live ticker (hours : minutes : seconds since together)
            const ticker = document.getElementById('liveTicker');
            function updateTicker() {
                if (!ticker) return;
                const diffMs = Date.now() - togetherTime;
                const totalSec = Math.floor(diffMs / 1000);
                const hours = Math.floor(totalSec / 3600);
                const minutes = Math.floor((totalSec % 3600) / 60);
                const seconds = totalSec % 60;
                ticker.textContent = `${hours.toLocaleString()}h ${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;
            }
            updateTicker();
            setInterval(updateTicker, 1000);

            // Collapsible list
            const toggle = document.getElementById('listToggle');
            const content = document.getElementById('listContent');
            if (toggle && content) {
                toggle.addEventListener('click', () => {
                    const isOpen = content.classList.toggle('is-open');
                    toggle.classList.toggle('is-open');
                    toggle.setAttribute('aria-expanded', String(isOpen));
                });
            }
        </script>
    </body>
</html>

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        font-family: 'Inter', -apple-system, sans-serif;
    }

    body {
        background:
            radial-gradient(ellipse at top left, rgba(244, 114, 182, 0.08), transparent 50%),
            radial-gradient(ellipse at bottom right, rgba(251, 146, 60, 0.08), transparent 50%),
            #f3ede2;
        color: #2a1f1a;
        position: relative;
    }

    a { text-decoration: none; color: inherit; }

    /* Paper grain texture via SVG noise */
    .paper-grain {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        opacity: 0.5;
        mix-blend-mode: multiply;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.3 0 0 0 0 0.2 0 0 0 0 0.15 0 0 0 0.12 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    }

    /* Floating stickers */
    .stickers {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 2;
    }

    .sticker {
        position: absolute;
        font-size: 1.5rem;
        opacity: 0.35;
        animation: wobble 8s ease-in-out infinite;
    }

    .sticker-1 { top: 12%; left: 6%; font-size: 2.2rem; animation-delay: 0s; }
    .sticker-2 { top: 30%; right: 8%; font-size: 1.6rem; color: #d4467b; animation-delay: -2s; }
    .sticker-3 { bottom: 26%; left: 9%; font-size: 1.3rem; color: #c97524; animation-delay: -4s; }
    .sticker-4 { bottom: 14%; right: 11%; font-size: 2rem; animation-delay: -6s; }

    @keyframes wobble {
        0%, 100% { transform: translate(0, 0) rotate(-4deg); }
        50% { transform: translate(6px, -8px) rotate(4deg); }
    }

    /* ===== Magazine Wrapper ===== */
    .magazine {
        position: relative;
        z-index: 3;
        max-width: 1080px;
        margin: 0 auto;
        padding: 40px 40px 80px;
    }

    /* ===== Masthead ===== */
    .masthead {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid #2a1f1a;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        color: #2a1f1a;
    }

    .mast-left {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .mast-issue { font-weight: 500; }
    .mast-sep { opacity: 0.4; }
    .mast-date { opacity: 0.65; }

    .mast-title {
        font-family: 'Fraunces', serif;
        font-weight: 900;
        font-size: 1.1rem;
        letter-spacing: 0.08em;
        text-align: center;
    }

    .mast-right {
        display: flex;
        justify-content: flex-end;
    }

    .mast-pill {
        padding: 4px 10px;
        border: 1px solid #2a1f1a;
        border-radius: 100px;
        font-size: 0.66rem;
    }

    /* ===== Cover / Editorial Hero ===== */
    .cover {
        position: relative;
        display: grid;
        grid-template-columns: 40px 1fr 300px;
        gap: 40px;
        padding: 50px 0 40px;
        border-bottom: 1px solid #2a1f1a;
    }

    .cover-side-text {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.6em;
        color: #2a1f1a;
        opacity: 0.45;
        align-self: start;
        padding-top: 20px;
    }

    .cover-main {
        min-width: 0;
        animation: slide-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes slide-up {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .cover-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.74rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #7a5c4a;
        margin-bottom: 8px;
    }

    .kicker-dot {
        display: inline-block;
        width: 8px; height: 8px;
        border-radius: 50%;
        background: #d4467b;
        animation: pulse 1.6s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(0.7); opacity: 0.4; }
    }

    .cover-number {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 16px;
    }

    .big-digits {
        font-family: 'Fraunces', serif;
        font-weight: 900;
        font-style: italic;
        font-size: clamp(7rem, 22vw, 16rem);
        line-height: 0.85;
        letter-spacing: -0.06em;
        color: #2a1f1a;
        background: linear-gradient(180deg, #2a1f1a 0%, #8b3a5c 70%, #d4467b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .big-unit {
        font-family: 'Fraunces', serif;
        font-weight: 300;
        font-size: clamp(2.4rem, 6vw, 4rem);
        color: #7a5c4a;
        letter-spacing: -0.02em;
    }

    .cover-underline {
        width: 120px;
        height: 2px;
        background: #2a1f1a;
        margin: 8px 0 24px;
    }

    .cover-quote {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        line-height: 1.5;
        color: #4a3529;
        max-width: 28em;
        margin-bottom: 32px;
    }

    .cover-quote em {
        font-style: italic;
        font-weight: 700;
        color: #d4467b;
        border-bottom: 2px solid #d4467b;
        padding-bottom: 2px;
    }

    .quote-mark {
        font-family: 'Fraunces', serif;
        font-size: 1.6em;
        line-height: 0;
        color: #d4467b;
        font-weight: 900;
        vertical-align: -0.1em;
    }

    /* Live ticker */
    .live-ticker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border: 1px solid #2a1f1a;
        border-radius: 100px;
        background: #fffbf2;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: #2a1f1a;
        box-shadow: 4px 4px 0 #2a1f1a;
    }

    .ticker-label {
        padding: 2px 6px;
        background: #d4467b;
        color: #fff;
        border-radius: 4px;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.08em;
    }

    .ticker-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #d4467b;
        animation: blink 1s ease-in-out infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .ticker-value {
        font-weight: 500;
        letter-spacing: 0.04em;
    }

    .ticker-note {
        font-family: 'Inter', sans-serif;
        font-size: 0.72rem;
        color: #7a5c4a;
        padding-left: 6px;
        border-left: 1px solid rgba(42, 31, 26, 0.2);
    }

    /* Polaroid index card */
    .index-card {
        position: relative;
        width: 100%;
        padding: 18px;
        background: #fffbf2;
        border: 1px solid #2a1f1a;
        box-shadow: 6px 6px 0 #2a1f1a;
        transform: rotate(2deg);
        transition: transform 0.4s ease;
        animation: slide-up 0.9s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .index-card:hover {
        transform: rotate(0deg) translateY(-4px);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px dashed rgba(42, 31, 26, 0.25);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
    }

    .card-stamp {
        color: #d4467b;
        font-weight: 600;
    }

    .card-no {
        opacity: 0.6;
    }

    .card-stats {
        margin: 14px 0;
    }

    .card-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed rgba(42, 31, 26, 0.15);
    }

    .card-row:last-child {
        border-bottom: none;
    }

    .card-row dt {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #7a5c4a;
    }

    .card-row dd {
        font-family: 'Fraunces', serif;
        font-weight: 700;
        font-style: italic;
        font-size: 1.2rem;
        color: #2a1f1a;
    }

    .card-footer {
        padding-top: 12px;
        border-top: 1px dashed rgba(42, 31, 26, 0.25);
        text-align: right;
    }

    .card-handwrite {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 0.82rem;
        color: #8b3a5c;
    }

    /* ===== Heartbeat divider ===== */
    .heartbeat {
        position: relative;
        display: flex;
        align-items: center;
        margin: 40px 0 30px;
        color: #d4467b;
    }

    .heartbeat svg {
        flex: 1;
        opacity: 0.7;
    }

    .heart-icon {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        background: #f3ede2;
        padding: 0 10px;
        font-size: 1.2rem;
        animation: heartbeat 1.4s ease-in-out infinite;
    }

    @keyframes heartbeat {
        0%, 100% { transform: translateY(-50%) scale(1); }
        30% { transform: translateY(-50%) scale(1.3); }
        60% { transform: translateY(-50%) scale(1); }
    }

    /* ===== Chapters ===== */
    .chapters {
        margin-top: 10px;
    }

    .chapters-toggle {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        background: #2a1f1a;
        color: #f3ede2;
        border: 1px solid #2a1f1a;
        border-radius: 0;
        cursor: pointer;
        font-family: inherit;
        transition: all 0.25s ease;
    }

    .chapters-toggle:hover {
        background: #3d2c23;
    }

    .ch-toggle-left {
        display: flex;
        align-items: baseline;
        gap: 18px;
    }

    .ch-toggle-chapter {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.24em;
        opacity: 0.6;
    }

    .ch-toggle-title {
        font-family: 'Fraunces', serif;
        font-weight: 500;
        font-style: italic;
        font-size: 1.3rem;
    }

    .ch-toggle-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ch-toggle-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 28px;
        padding: 0 8px;
        border-radius: 100px;
        background: #d4467b;
        color: #fff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .ch-toggle-arrow {
        display: flex;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .chapters-toggle.is-open .ch-toggle-arrow {
        transform: rotate(180deg);
    }

    .chapters-list {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fffbf2;
        border: 1px solid #2a1f1a;
        border-top: none;
    }

    .chapters-list.is-open {
        max-height: 3000px;
    }

    .entry-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .entry {
        border-bottom: 1px solid rgba(42, 31, 26, 0.1);
        opacity: 0;
        transform: translateY(8px);
        animation: entry-in 0.45s ease forwards;
    }

    .entry:last-child { border-bottom: none; }

    @keyframes entry-in {
        to { opacity: 1; transform: translateY(0); }
    }

    .entry-link {
        display: grid;
        grid-template-columns: 60px 60px 1fr auto 30px;
        align-items: center;
        gap: 18px;
        padding: 20px 24px;
        transition: all 0.25s ease;
        color: #2a1f1a;
    }

    .entry-link:hover {
        background: #f3ede2;
    }

    .entry-num {
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-weight: 400;
        font-size: 1.9rem;
        color: #d4467b;
        letter-spacing: -0.02em;
    }

    .entry-rule {
        height: 1px;
        background: #2a1f1a;
        opacity: 0.4;
        transition: opacity 0.3s ease;
    }

    .entry-link:hover .entry-rule {
        opacity: 1;
    }

    .entry-content {
        min-width: 0;
    }

    .entry-title {
        font-family: 'Fraunces', serif;
        font-weight: 500;
        font-size: 1.12rem;
        line-height: 1.3;
        color: #2a1f1a;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .entry-desc {
        font-size: 0.82rem;
        color: #7a5c4a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .entry-date {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        color: #7a5c4a;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .entry-arrow {
        font-family: 'Fraunces', serif;
        font-size: 1.2rem;
        color: #d4467b;
        transition: transform 0.25s ease;
    }

    .entry-link:hover .entry-arrow {
        transform: translateX(6px);
    }

