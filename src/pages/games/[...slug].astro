---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Lazy from '../../layouts/lazy.astro';
import ReadingPost from '../../layouts/ReadingPost.astro';
export async function getStaticPaths() {
	const posts = await getCollection('games');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'games'>;

const post = Astro.props;
const { Content } = await render(post);
---

{post.data.pageLayout === 'reading' ? (
	<ReadingPost
		{...post.data}
		archiveHref="/games/"
		archiveLabel="Games / Reading practice"
		allLabel="Back to games"
		markReadingNav={false}
		showHeader={false}
	>
		<Content />
	</ReadingPost>
) : (
	<Lazy {...post.data}>
		<Content />
	</Lazy>
)}
