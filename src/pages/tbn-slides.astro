---
import BaseHead from '../components/BaseHead.astro';
import TBNSlidePresentation from '../components/tbn-blog/TBNSlidePresentation.jsx';
---

<html lang="zh-CN">
  <head>
    <BaseHead
      title="TBN 矩阵 — 交互式讲解"
      description="通过交互式 3D 可视化，彻底搞懂 TBN 矩阵的数学推导、几何意义和在法线贴图中的应用"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        height: 100%;
        background: #0a0f1a;
      }
    </style>
  </head>
  <body>
    <TBNSlidePresentation client:only="react" />
    <script>
      // Prevent default space scrolling
      window.addEventListener('keydown', (e) => {
        if (e.key === ' ') e.preventDefault();
      });
    </script>
  </body>
</html>
