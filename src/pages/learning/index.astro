---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const getCet6SortMeta = (id) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet6-reading-(\d+)$/);
  if (!match) return null;

  return {
    period: Number(`${match[1]}${match[2]}`),
    set: Number(match[3]),
  };
};

const posts = (await getCollection('learning')).sort((a, b) => {
  const aCet6 = getCet6SortMeta(a.id);
  const bCet6 = getCet6SortMeta(b.id);

  if (aCet6 && bCet6) {
    return bCet6.period - aCet6.period || aCet6.set - bCet6.set;
  }

  if (aCet6) return -1;
  if (bCet6) return 1;

  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const year = new Date().getFullYear();
const cardTints = ['tint-leaf', 'tint-sage', 'tint-sky', 'tint-butter'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Learning — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="bg-sun" aria-hidden="true"></div>
    <div class="bg-clouds" aria-hidden="true">
      <span class="cloud cloud-1"></span>
      <span class="cloud cloud-2"></span>
      <span class="cloud cloud-3"></span>
    </div>
    <div class="bg-grid" aria-hidden="true"></div>

    <header class="topbar" data-reveal>
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <span class="sun-core"></span>
        </span>
        <span class="brand-text">Quiet Lab</span>
      </a>
      <nav class="topnav">
        <a href="/works/"><span>Works</span></a>
        <a href="/blog/"><span>Journal</span></a>
        <a href="/papers/"><span>Papers</span></a>
        <a href="/about/"><span>About</span></a>
      </nav>
      <div class="status">
        <span class="status-dot"></span>
        <span class="status-text">Open · {year}</span>
      </div>
    </header>

    <main class="shell">
      <section class="page-head">
        <div class="head-tag" data-reveal>
          <span class="head-tag-dot"></span>
          <span>Study Room &nbsp;·&nbsp; Drafts before essays</span>
        </div>

        <h1 class="page-title" data-reveal>
          <span>Learning,</span>
          <span class="ribbon">
            <span class="ribbon-text">mapped</span>
            <svg class="ribbon-shape" viewBox="0 0 220 70" aria-hidden="true" preserveAspectRatio="none">
              <path d="M6 38 C 50 6, 130 6, 214 32 C 200 50, 80 70, 6 50 Z" />
            </svg>
          </span>
          <em>while it is still moving.</em>
        </h1>

        <p class="page-lede" data-reveal>
          A quiet shelf for <span class="hl">study plans</span>,
          <span class="hl">concept maps</span> and <span class="hl">working notes</span>.
          This is where rough understanding gets organized before it becomes a
          Journal essay or an interactive Work.
        </p>

        <div class="head-meta" data-reveal>
          <span class="meta-pill">
            <span class="meta-num">{String(posts.length).padStart(2, '0')}</span>
            <span class="meta-label">notes</span>
          </span>
          <span class="meta-sep">·</span>
          <a href="/" class="meta-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>Back home</span>
          </a>
        </div>
      </section>

      <section class="posts">
        {posts.length > 0 && (
          <article class="featured-card" data-reveal>
            <a href={`/learning/${posts[0].id}/`} class="featured-link">
              <div class="featured-badge">
                <span class="featured-badge-dot"></span>
                <span>Start here</span>
              </div>
              <h2 class="featured-title">{posts[0].data.title}</h2>
              {posts[0].data.description && (
                <p class="featured-desc">{posts[0].data.description}</p>
              )}
              <div class="featured-foot">
                <span class="featured-date">
                  <FormattedDate date={posts[0].data.pubDate} />
                </span>
                <span class="featured-cta">
                  <span>Open note</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </a>
          </article>
        )}

        {posts.length > 1 && (
          <div class="rest-grid">
            {posts.slice(1).map((post, i) => (
              <article class={`rest-card ${cardTints[(i + 1) % cardTints.length]}`} data-reveal>
                <a href={`/learning/${post.id}/`} class="rest-link">
                  <span class="rest-num">{String(i + 2).padStart(2, '0')}</span>
                  <div class="rest-body">
                    <h3 class="rest-title">{post.data.title}</h3>
                    {post.data.description && <p class="rest-desc">{post.data.description}</p>}
                  </div>
                  <div class="rest-foot">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                </a>
              </article>
            ))}
          </div>
        )}
      </section>

      <footer class="foot" data-reveal>
        <span class="foot-left">
          <span class="foot-mark" aria-hidden="true">✦</span>
          © {year} Quiet Lab · Learning in public, one small map at a time.
        </span>
        <span class="foot-right">
          <a href="/">Home</a>
          <span class="sep">·</span>
          <a href="/about/">Contact</a>
        </span>
      </footer>
    </main>

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el, i) => {
        el.style.setProperty('--reveal-delay', `${60 + i * 50}ms`);
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #fbf7ee;
    --ink: #1e2b25;
    --ink-soft: #4f6158;
    --ink-mute: #89968f;
    --line: rgba(30, 43, 37, 0.10);
    --line-strong: rgba(30, 43, 37, 0.22);

    --leaf: #b7dcc5;
    --sage: #d8e9cf;
    --sky: #c9e6ea;
    --butter: #f4e5a2;
    --accent: #3f8f62;
    --sun: #e0ad3c;

    --shadow-soft: 0 6px 20px rgba(30, 43, 37, 0.06), 0 1px 0 rgba(30, 43, 37, 0.04);
    --shadow-card: 0 14px 30px -16px rgba(30, 43, 37, 0.18), 0 2px 0 rgba(30, 43, 37, 0.04);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { background: var(--bg); }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a { color: inherit; text-decoration: none; }

  .bg-sun {
    position: fixed;
    top: -250px;
    right: -160px;
    width: 680px;
    height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(183, 220, 197, 0.8) 0%,
      rgba(216, 233, 207, 0.5) 30%,
      rgba(216, 233, 207, 0) 70%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
    animation: sun-pulse 12s ease-in-out infinite alternate;
  }

  @keyframes sun-pulse {
    to { transform: scale(1.05) translate(-10px, 12px); opacity: 0.94; }
  }

  .bg-clouds {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    filter: blur(60px) saturate(112%);
    opacity: 0.68;
  }

  .cloud { position: absolute; border-radius: 50%; mix-blend-mode: multiply; }
  .cloud-1 {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, var(--leaf) 0%, transparent 70%);
    bottom: -8%;
    left: -6%;
    animation: drift-a 26s ease-in-out infinite alternate;
  }

  .cloud-2 {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, var(--sky) 0%, transparent 70%);
    top: 30%;
    right: -8%;
    animation: drift-b 30s ease-in-out infinite alternate;
  }

  .cloud-3 {
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, var(--butter) 0%, transparent 70%);
    top: 56%;
    left: 32%;
    animation: drift-c 24s ease-in-out infinite alternate;
  }

  @keyframes drift-a { to { transform: translate(60px, -40px) scale(1.08); } }
  @keyframes drift-b { to { transform: translate(-70px, 50px) scale(0.96); } }
  @keyframes drift-c { to { transform: translate(40px, -60px) scale(1.05); } }

  .bg-grid {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(30, 43, 37, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(30, 43, 37, 0.08) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 78%);
  }

  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 12px 18px;
    background: rgba(251, 247, 238, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .topbar.in { opacity: 1; transform: translateY(0); }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-left: 6px;
  }

  .brand-mark {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, var(--accent) 70%);
    box-shadow: 0 0 0 3px rgba(63, 143, 98, 0.18);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    animation: brand-spin 16s linear infinite;
  }

  .sun-core {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.9) inset;
  }

  @keyframes brand-spin { to { transform: rotate(360deg); } }

  .topnav {
    display: flex;
    gap: 6px;
    justify-self: center;
  }

  .topnav a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }

  .topnav a:hover {
    color: var(--ink);
    background: rgba(30, 43, 37, 0.06);
    transform: translateY(-1px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fffaf3;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(63, 143, 98, 0.18);
    animation: blink 2.4s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  .shell {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .page-head {
    padding: 80px 0 48px;
    border-bottom: 1px dashed var(--line-strong);
    margin-bottom: 40px;
  }

  .head-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.52);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .head-tag.in { opacity: 1; transform: translateY(0); }

  .head-tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(63, 143, 98, 0.16);
  }

  .page-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 6.4vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.18em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .page-title.in { opacity: 1; transform: translateY(0); }
  .page-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .ribbon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.18em 0.04em;
    transform: rotate(-2.5deg);
  }

  .ribbon-text {
    position: relative;
    z-index: 2;
    font-style: italic;
    font-weight: 600;
    color: #1f2a12;
  }

  .ribbon-shape {
    position: absolute;
    inset: -0.05em -0.18em -0.12em -0.18em;
    width: calc(100% + 0.36em);
    height: calc(100% + 0.17em);
    z-index: 1;
    fill: var(--leaf);
    filter: drop-shadow(0 4px 0 rgba(30, 43, 37, 0.08));
  }

  .page-lede {
    font-size: 1.04rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 680px;
    margin-bottom: 30px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .page-lede.in { opacity: 1; transform: translateY(0); }

  .page-lede .hl {
    background: linear-gradient(180deg, transparent 60%, var(--leaf) 60%);
    padding: 0 2px;
    color: var(--ink);
    font-weight: 500;
  }

  .head-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .head-meta.in { opacity: 1; transform: translateY(0); }

  .meta-pill,
  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
  }

  .meta-num {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    color: var(--accent);
  }

  .meta-label { color: var(--ink-soft); }
  .meta-sep { color: var(--ink-mute); }

  .meta-link {
    transition: background 0.25s, transform 0.25s, color 0.25s;
  }

  .meta-link:hover {
    background: var(--leaf);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 80px;
  }

  .featured-card {
    border-radius: 22px;
    background: linear-gradient(135deg, #fff 0%, var(--leaf) 180%);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .featured-card.in { opacity: 1; transform: translateY(0); }

  .featured-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 28px 50px -20px rgba(30, 43, 37, 0.24);
  }

  .featured-link {
    display: block;
    padding: 36px 36px 32px;
    color: var(--ink);
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(63, 143, 98, 0.12);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }

  .featured-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 2.4s ease-in-out infinite;
  }

  .featured-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .featured-desc {
    font-size: 1.04rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 640px;
    margin-bottom: 24px;
  }

  .featured-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px dashed var(--line-strong);
  }

  .featured-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }

  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
    transition: transform 0.3s;
  }

  .featured-cta svg { transition: transform 0.3s; }
  .featured-card:hover .featured-cta svg { transform: translateX(4px); }

  .rest-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .rest-card {
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s, border-color 0.3s;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .rest-card.in { opacity: 1; transform: translateY(0); }

  .rest-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -14px rgba(30, 43, 37, 0.2);
    border-color: var(--line-strong);
  }

  .rest-card.tint-leaf { border-left: 3px solid var(--leaf); }
  .rest-card.tint-sage { border-left: 3px solid var(--sage); }
  .rest-card.tint-sky { border-left: 3px solid var(--sky); }
  .rest-card.tint-butter { border-left: 3px solid var(--butter); }

  .rest-link {
    display: flex;
    flex-direction: column;
    padding: 20px 20px 18px;
    color: var(--ink);
    height: 100%;
  }

  .rest-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(30, 43, 37, 0.06);
    color: var(--ink-mute);
    align-self: flex-start;
    margin-bottom: 12px;
  }

  .rest-body { flex: 1; }

  .rest-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .rest-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rest-foot {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-family: 'JetBrains Mono', monospace;
