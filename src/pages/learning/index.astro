---
import { getCollection } from 'astro:content';
import EditorialIndex from '../../components/EditorialIndex.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const getCet6SortMeta = (id: string) => {
  const match = id.match(/^(\d{4})-(\d{2})-cet6-reading-(\d+)$/);
  if (!match) return null;
  return { period: Number(`${match[1]}${match[2]}`), set: Number(match[3]) };
};

const posts = (await getCollection('learning')).sort((a, b) => {
  const aCet6 = getCet6SortMeta(a.id);
  const bCet6 = getCet6SortMeta(b.id);
  if (aCet6 && bCet6) return bCet6.period - aCet6.period || aCet6.set - bCet6.set;
  if (aCet6) return -1;
  if (bCet6) return 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const entries = posts.map((post) => ({
  href: `/learning/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate,
  meta: post.id.includes('cet6') ? 'CET-6 reading' : 'Study note',
}));
---

<EditorialIndex
  pageTitle={`Learning | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  eyebrow="Learning"
  title="Understanding, mapped in public."
  lede="整理阅读练习、概念地图与仍在生长的学习笔记，让零散理解逐渐形成可以回看的路径。"
  edition="03"
  editionLabel="Reading & study"
  sectionTitle="Study archive"
  sectionNote="按考试批次与日期排序"
  {entries}
/>
