---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import StudyMath from '../../components/study/StudyMath.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import '../../styles/study.css';

const studies = (await getCollection('study')).sort((a, b) => {
  const aPart = a.data.part ?? 0;
  const bPart = b.data.part ?? 0;
  if (aPart !== bPart) return aPart - bPart;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const modeLabels = {
  lab: 'Concept lab',
  reading: 'Close reading',
  derivation: 'Derivation notebook',
  build: 'Build lab',
};

const courseCopy = {
  'kalman-filter': {
    title: 'Kalman filtering · course map',
    description: 'A five-part textbook sequence: from probability and models to diagnostics and reliable implementation.',
    subject: 'State estimation',
    units: 'Course map',
    duration: '10 min',
  },
  'kalman-filter-foundations': {
    title: '01 · State, evidence, and probability',
    description: 'Learn what the filter estimates, how uncertainty becomes a distribution, and how to write a defensible state-space model.',
    subject: 'Foundations',
    units: '4 sections',
    duration: '35 min',
  },
  'kalman-filter-recursion': {
    title: '02 · The recursion, derived',
    description: 'Derive prediction, innovation, gain, and covariance update from conditional Gaussians and least squares.',
    subject: 'Derivation',
    units: '4 sections',
    duration: '45 min',
  },
  'kalman-filter-tuning': {
    title: '03 · Q, R, P, and response',
    description: 'Turn covariance assumptions into observable behavior, tune a filter without confusing smoothness for truth, and understand steady state.',
    subject: 'Experiments',
    units: '4 sections',
    duration: '40 min',
  },
  'kalman-filter-diagnostics': {
    title: '04 · Innovation and failure modes',
    description: 'Use innovation tests, NIS, and residual patterns to tell a bad parameter from a bad model or a bad measurement.',
    subject: 'Validation',
    units: '4 sections',
    duration: '35 min',
  },
  'kalman-filter-implementation': {
    title: '05 · From equations to software',
    description: 'Build a numerically stable implementation, handle missing data, and verify the result with tests that catch silent mistakes.',
    subject: 'Engineering',
    units: '4 sections',
    duration: '40 min',
  },
};

const getCourseCopy = (study) => courseCopy[study.id] ?? {
  title: study.data.title,
  description: study.data.description,
  subject: study.data.subject ?? 'Independent study',
  units: 'Self-paced',
  duration: 'Open-ended',
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Study | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="study-index-page">
    <BlogHeader active="study" />

    <main class="study-index-shell">
      <header class="study-index-intro" aria-labelledby="study-hero-title">
        <div class="study-intro-copy">
          <div class="study-hero-kicker"><span>Study / {String(studies.length).padStart(2, '0')} reading units</span><span>Personal curriculum</span></div>
          <h1 id="study-hero-title">Make the next step <em>small enough to take.</em></h1>
          <p class="study-index-lede">A growing set of interactive textbooks for turning difficult ideas into questions, evidence, and better explanations.</p>
        </div>
        <div class="study-intro-index" aria-label="Study desk index">
          <span class="study-section-kicker">Desk index</span>
          <strong>01</strong>
          <div><span>active course</span><span>field notes</span><span>self-paced</span></div>
        </div>
      </header>

      <div class="study-dashboard">
        <section class="study-catalog" aria-labelledby="study-list-title">
          <div class="study-dashboard-header">
            <div><span class="study-section-kicker">The catalogue</span><h2 id="study-list-title">Open a course</h2></div>
            <span class="study-dashboard-count">{String(studies.length).padStart(2, '0')} available</span>
          </div>
          <div class="study-card-list">
            {studies.map((study, index) => {
              const copy = getCourseCopy(study);
              return (
                <a class:list={['study-card', index === 0 && 'study-card-featured']} href={`/study/${study.id}/`}>
                  <div class="study-card-rail"><span>{String(index + 1).padStart(2, '0')}</span><i></i><small>{copy.units}</small></div>
                  <div class="study-card-copy">
                    <div class="study-card-mode">{modeLabels[study.data.mode]} / {copy.subject}</div>
                    <h3>{copy.title}</h3>
                    <p>{copy.description}</p>
                    <div class="study-card-meta"><span>{copy.duration}</span><span>Updated <FormattedDate date={study.data.updatedDate ?? study.data.pubDate} /></span></div>
                  </div>
                  <div class="study-card-mark" aria-hidden="true"><StudyMath expression={'\\rightarrow'} /></div>
                  {index === 0 && <div class="study-card-formula" aria-hidden="true"><StudyMath expression={'x_k\\rightarrow z_k\\rightarrow\\hat x_k'} display /></div>}
                </a>
              );
            })}
          </div>
        </section>

        <aside class="study-principles" aria-labelledby="study-principles-title">
          <div class="study-principles-top"><span class="study-section-kicker">A useful rhythm</span><StudyMath expression={'k\\rightarrow k+1'} /></div>
          <h2 id="study-principles-title">Learn by<br /><em>leaving a trace.</em></h2>
          <ol>
            <li><span>01</span><div><strong>Start with a question</strong><p>Turn “I do not get it” into one thing you can test.</p></div></li>
            <li><span>02</span><div><strong>Make evidence visible</strong><p>Use a formula, chart, or counterexample to challenge intuition.</p></div></li>
            <li><span>03</span><div><strong>Return with context</strong><p>Keep the useful mistake and choose the next small step.</p></div></li>
          </ol>
          <div class="study-principles-footer"><StudyMath expression={'\\text{question}\\rightarrow\\text{evidence}\\rightarrow\\text{revision}'} /></div>
        </aside>
      </div>

      <footer class="study-index-footer">
        <span>Study desk · Tend</span>
        <a href="/about/">About the practice ↗</a>
      </footer>
    </main>
  </body>
</html>
