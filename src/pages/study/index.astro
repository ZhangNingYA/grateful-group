---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import '../../styles/study.css';

const studies = (await getCollection('study')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const modeLabels = {
  lab: 'Concept lab',
  reading: 'Close reading',
  derivation: 'Derivation notebook',
  build: 'Build lab',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`Study | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="study-index-page">
    <BlogHeader active="study" />

    <main class="study-index-shell">
      <header class="study-index-hero">
        <div>
          <p class="study-kicker">Study desk / {String(studies.length).padStart(2, '0')} lab{studies.length === 1 ? '' : 's'}</p>
          <h1>Learn by making the idea answer back.</h1>
          <p class="study-index-lede">把正在学习的东西拆成问题、实验、检查和记录。每一页都应该让理解留下可以回看的痕迹。</p>
        </div>
        <div class="study-index-compass" aria-label="学习循环">
          <span class="study-kicker">A working loop</span>
          <strong>Try →</strong>
          <p>先动手，再解释；先暴露误区，再决定下一步。</p>
        </div>
      </header>

      <div class="study-dashboard">
        <section aria-labelledby="study-list-title">
          <div class="study-dashboard-header">
            <h2 id="study-list-title">Open a study lab</h2>
            <span>内容会随着学习一起生长</span>
          </div>
          <div class="study-card-list">
            {studies.map((study, index) => (
              <a class="study-card" href={`/study/${study.id}/`}>
                <span class="study-card-number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <div class="study-card-mode">{modeLabels[study.data.mode]}{study.data.subject ? ` / ${study.data.subject}` : ''}</div>
                  <h3>{study.data.title}</h3>
                  <p>{study.data.description}</p>
                  <div class="study-index-meta"><FormattedDate date={study.data.pubDate} /></div>
                </div>
                <span class="study-card-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <aside class="study-principles">
          <h2>How a lab works</h2>
          <ol>
            <li><div><strong>Start with a question</strong>先定义要解决的真实问题。</div></li>
            <li><div><strong>Make it visible</strong>用图、数据或操作暴露直觉。</div></li>
            <li><div><strong>Check your model</strong>让题目和反例挑战当前理解。</div></li>
            <li><div><strong>Leave a trace</strong>记录卡住的地方，决定下一次从哪里继续。</div></li>
          </ol>
        </aside>
      </div>

      <footer class="study-index-footer">
        <span>Study desk · Tend</span>
        <a href="/about/">About the practice ↗</a>
      </footer>
    </main>
  </body>
</html>
