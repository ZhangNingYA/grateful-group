---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ThreeDPost from '../../layouts/ThreeDPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('threeD');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'threeD'>;

const post = Astro.props;
const { Content, headings } = await render(post);
---

<ThreeDPost {...post.data} headings={headings}>
  <Content />
</ThreeDPost>
