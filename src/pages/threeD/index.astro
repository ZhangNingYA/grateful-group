---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('threeD')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`ThreeD — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="stage" aria-hidden="true">
      <span class="stage-grid"></span>
      <span class="plane plane-a"></span>
      <span class="plane plane-b"></span>
    </div>

    <header class="topbar" data-reveal>
      <a href="/" class="brand">
        <span class="brand-cube" aria-hidden="true">
          <span></span>
        </span>
        <span>cyan</span>
      </a>
      <nav class="topnav" aria-label="Primary navigation">
        <a href="/works/"><span>Works</span></a>
        <a href="/blog/"><span>Journal</span></a>
        <a href="/papers/"><span>Papers</span></a>
        <a href="/about/"><span>About</span></a>
      </nav>
      <div class="status">
        <span class="status-dot"></span>
        <span>Viewport · {year}</span>
      </div>
    </header>

    <main class="shell">
      <section class="hero">
        <div class="hero-kicker" data-reveal>
          <span class="kicker-line"></span>
          <span>Three.js notes · scenes before essays</span>
        </div>

        <h1 data-reveal>
          ThreeD,
          <span>rendered as notes.</span>
        </h1>

        <p data-reveal>
          A focused shelf for learning Three.js through small scenes, visual tests,
          rendering concepts, and reusable mental models.
        </p>

        <div class="hero-meta" data-reveal>
          <span>
            <strong>{String(posts.length).padStart(2, '0')}</strong>
            notes
          </span>
          <a href="/" aria-label="Back home">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            Back home
          </a>
        </div>
      </section>

      <section class="notes" aria-label="ThreeD notes">
        {posts.length > 0 && (
          <article class="note-card" data-reveal>
            <a href={`/threeD/${posts[0].id}/`}>
              <div class="note-top">
                <span class="note-badge">Start here</span>
                <span class="note-date"><FormattedDate date={posts[0].data.pubDate} /></span>
              </div>
              <h2>{posts[0].data.title}</h2>
              <p>{posts[0].data.description}</p>
              <div class="note-bottom">
                <span>Open guide</span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          </article>
        )}
      </section>

      <footer class="foot" data-reveal>
        <span>© {year} Quiet Lab · Three.js learning notes.</span>
        <span class="foot-links">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/works/">Works</a>
        </span>
      </footer>
    </main>

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el, i) => {
        el.style.setProperty('--delay', `${70 + i * 55}ms`);
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #070a11;
    --panel: rgba(12, 18, 30, 0.78);
    --panel-strong: rgba(16, 24, 39, 0.9);
    --ink: #f6f9ff;
    --soft: #b6c2d6;
    --muted: #7f8fa8;
    --line: rgba(193, 215, 255, 0.15);
    --cyan: #68d8ff;
    --amber: #ffbc66;
    --green: #7df0c1;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: var(--bg); }

  body {
    min-height: 100vh;
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      linear-gradient(130deg, rgba(104, 216, 255, 0.14) 0%, transparent 34%),
      linear-gradient(225deg, rgba(255, 188, 102, 0.12) 0%, transparent 30%),
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.08), transparent 36%),
      linear-gradient(180deg, #101827 0%, #070a11 56%, #05070c 100%);
  }

  .stage-grid {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -18%;
    height: 74%;
    background-image:
      linear-gradient(rgba(150, 178, 222, 0.24) 1px, transparent 1px),
      linear-gradient(90deg, rgba(150, 178, 222, 0.24) 1px, transparent 1px);
    background-size: 44px 44px;
    transform: perspective(680px) rotateX(64deg);
    transform-origin: center bottom;
    opacity: 0.34;
  }

  .plane {
    position: absolute;
    border: 1px solid rgba(193, 215, 255, 0.16);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    transform-style: preserve-3d;
  }

  .plane-a {
    width: 180px;
    height: 120px;
    top: 18%;
    right: 10%;
    transform: rotateX(58deg) rotateZ(-18deg);
  }

  .plane-b {
    width: 140px;
    height: 140px;
    left: 9%;
    top: 48%;
    transform: rotateX(52deg) rotateZ(25deg);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0ms);
  }

  [data-reveal].in {
    opacity: 1;
    transform: translateY(0);
  }

  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 11px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(9, 14, 24, 0.76);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(14px) saturate(125%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    padding-left: 6px;
    font-weight: 800;
  }

  .brand-cube {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--cyan), var(--amber));
    box-shadow: 0 0 28px rgba(104, 216, 255, 0.22);
  }

  .brand-cube span {
    width: 10px;
    height: 10px;
    border: 1px solid rgba(7, 10, 17, 0.65);
    transform: rotate(45deg);
  }

  .topnav {
    display: flex;
    gap: 6px;
    justify-self: center;
  }

  .topnav a {
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--soft);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .topnav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--green);
    box-shadow: 0 0 16px rgba(125, 240, 193, 0.75);
  }

  .shell {
    position: relative;
    z-index: 1;
    width: min(960px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    padding: 94px 0 54px;
    border-bottom: 1px solid var(--line);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    color: var(--soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }

  .kicker-line {
    width: 42px;
    height: 1px;
    background: linear-gradient(90deg, var(--cyan), transparent);
  }

  h1 {
    max-width: 820px;
    margin-bottom: 24px;
    font-size: clamp(3rem, 9vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: 0;
    font-weight: 800;
  }

  h1 span {
    display: block;
    color: var(--soft);
    font-weight: 700;
  }

  .hero p {
    max-width: 680px;
    color: var(--soft);
    font-size: 1.08rem;
    line-height: 1.78;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
    color: var(--soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }

  .hero-meta span,
  .hero-meta a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  .hero-meta strong {
    color: var(--cyan);
    font-size: 0.95rem;
  }

  .notes {
    padding: 34px 0 88px;
  }

  .note-card {
    max-width: 760px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(104, 216, 255, 0.1), rgba(255, 188, 102, 0.08)),
      var(--panel);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.26);
    overflow: hidden;
    transition: transform 0.28s ease, border-color 0.28s ease;
  }

  .note-card:hover {
    transform: translateY(-4px);
    border-color: rgba(104, 216, 255, 0.36);
  }

  .note-card a {
    display: block;
    padding: 30px;
  }

  .note-top,
  .note-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .note-top {
    margin-bottom: 22px;
    color: var(--muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
  }

  .note-badge {
    padding: 5px 10px;
    border: 1px solid rgba(104, 216, 255, 0.28);
    border-radius: 999px;
    color: var(--cyan);
    background: rgba(104, 216, 255, 0.08);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  .note-card h2 {
    margin-bottom: 12px;
    color: #fff;
    font-size: clamp(1.55rem, 4vw, 2.45rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .note-card p {
    max-width: 620px;
    color: var(--soft);
    font-size: 1rem;
    line-height: 1.72;
  }

  .note-bottom {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--cyan);
    font-weight: 700;
  }

  .note-bottom svg {
    transition: transform 0.22s ease;
  }

  .note-card:hover .note-bottom svg {
    transform: translateX(4px);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 26px 0 42px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
  }

  .foot-links {
    display: inline-flex;
    gap: 10px;
  }

  .foot a:hover { color: var(--cyan); }

  @media (max-width: 760px) {
    .topbar {
      grid-template-columns: 1fr auto;
      margin: 12px 14px 0;
      gap: 12px;
    }

    .topnav { display: none; }
    .shell { width: min(100% - 34px, 960px); }
    .hero { padding: 66px 0 42px; }
    .note-card a { padding: 24px; }
  }

  @media (max-width: 520px) {
    .status span:last-child { display: none; }
    .status { padding: 6px; }
    .note-top,
    .note-bottom,
    .foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .note-card,
    .topnav a,
    .note-bottom svg {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
