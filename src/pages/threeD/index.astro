---
import { getCollection } from 'astro:content';
import EditorialIndex from '../../components/EditorialIndex.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('threeD')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const entries = posts.map((post) => ({
  href: `/threeD/${post.id}/`,
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate,
  meta: 'Three.js guide',
}));
---

<EditorialIndex
  pageTitle={`ThreeD | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  active="works"
  eyebrow="ThreeD"
  title="A field guide to the third dimension."
  lede="记录 Three.js 与实时三维网页的基础路径，从场景搭建到可交互的视觉实验。"
  edition="04"
  editionLabel="Three.js field notes"
  sectionTitle="Three-dimensional notes"
  sectionNote="按发布日期排序"
  {entries}
/>
