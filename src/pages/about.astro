---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();

const focusItems = [
  {
    label: 'Real-time Graphics',
    body: 'Shaders, lighting, geometry processing — coaxing pixels into something a little more alive.',
  },
  {
    label: 'Interactive Notes',
    body: 'Turning a textbook chapter into something you can drag, rotate and break.',
  },
  {
    label: 'Quiet Tooling',
    body: 'Small focused web tools and demos that explain themselves with restraint.',
  },
];

const stack = [
  { name: 'Astro', tag: 'site' },
  { name: 'React 19', tag: 'islands' },
  { name: 'Three.js · R3F · Drei', tag: '3D' },
  { name: 'GLSL · WebGL', tag: 'shaders' },
  { name: 'MDX', tag: 'writing' },
  { name: 'TypeScript', tag: 'glue' },
];

const journal = [
  {
    year: '2026',
    title: 'Studio sessions',
    body: 'Re-reading GAMES101 and turning each lecture into a small, hands-on web piece.',
  },
  {
    year: '2025',
    title: 'Quiet beginnings',
    body: 'Started Grateful Group as a slow personal lab for graphics, geometry and shaders.',
  },
  {
    year: '∞',
    title: 'A long apprenticeship',
    body: 'Drawing better frames, one tiny experiment at a time.',
  },
];

const elsewhere = [
  { label: 'GitHub', value: '@ZhangNingYA', href: 'https://github.com/ZhangNingYA' },
  { label: 'Email',  value: 'hello@grateful.group', href: 'mailto:hello@grateful.group' },
  { label: 'RSS',    value: '/rss.xml',             href: '/rss.xml' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Background layers -->
    <div class="bg-sun" aria-hidden="true"></div>
    <div class="bg-clouds" aria-hidden="true">
      <span class="cloud cloud-1"></span>
      <span class="cloud cloud-2"></span>
      <span class="cloud cloud-3"></span>
    </div>
    <div class="bg-paper" aria-hidden="true"></div>

    <!-- Top navigation -->
    <header class="topbar" data-reveal>
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <span class="sun-core"></span>
        </span>
        <span class="brand-text">cyan</span>
      </a>
      <nav class="topnav">
        <a href="/works/"><span>Works</span></a>
        <a href="/blog/"><span>Journal</span></a>
        <a href="/papers/"><span>Papers</span></a>
        <a href="/about/" class="is-active"><span>About</span></a>
      </nav>
      <div class="status">
        <span class="status-dot"></span>
        <span class="status-text">Open · {year}</span>
      </div>
    </header>

    <main class="shell">
      <!-- Page head -->
      <section class="page-head">
        <div class="head-tag" data-reveal>
          <span class="head-tag-dot"></span>
          <span>Studio &nbsp;·&nbsp; A quiet introduction</span>
        </div>

        <h1 class="page-title" data-reveal>
          <span>A small studio of</span>
          <span class="ribbon">
            <span class="ribbon-text">light</span>
            <svg class="ribbon-shape" viewBox="0 0 220 70" aria-hidden="true" preserveAspectRatio="none">
              <path d="M6 38 C 50 6, 130 6, 214 32 C 200 50, 80 70, 6 50 Z" />
            </svg>
          </span>
          <em>and patient code.</em>
        </h1>

        <p class="page-lede" data-reveal>
          Grateful Group is a slow, personal lab for
          <span class="hl">real-time graphics</span>,
          <span class="hl">interactive geometry</span> and
          <span class="hl">careful little tools</span> for the web.
          The goal is modest: take an idea that looks abstract on a chalkboard,
          and turn it into something you can drag, rotate and feel.
        </p>
      </section>

      <!-- Manifesto + Profile -->
      <section class="about-grid">
        <article class="card-large" data-reveal>
          <header class="card-head">
            <span class="card-num">01</span>
            <span class="card-label">Manifesto</span>
          </header>

          <h2 class="card-title">
            Draw every frame a little more <span class="card-em">gently</span>.
          </h2>

          <div class="card-body">
            <p>
              We work in small batches. Each piece is a self-contained note —
              a way of revisiting a familiar idea with fresh hands. We prefer
              calm visuals over loud ones, and clarity over cleverness.
            </p>
            <p>
              Most of what lives here is graphics-adjacent: shaders, geometry,
              ray tracing, mesh operations. Some of it is just play. All of
              it tries to be <em>readable</em> — the way a good notebook is
              readable years later.
            </p>
          </div>

          <footer class="card-foot">
            <span class="card-rule"></span>
            <span class="card-note">Notes &nbsp;·&nbsp; not products</span>
          </footer>
        </article>

        <aside class="card-side" data-reveal>
          <header class="card-head">
            <span class="card-num">02</span>
            <span class="card-label">Profile</span>
          </header>

          <dl class="profile">
            <div class="profile-row">
              <dt>Studio</dt>
              <dd>Grateful Group</dd>
            </div>
            <div class="profile-row">
              <dt>Practice</dt>
              <dd>Real-time graphics, web</dd>
            </div>
            <div class="profile-row">
              <dt>Founded</dt>
              <dd>2025</dd>
            </div>
            <div class="profile-row">
              <dt>Status</dt>
              <dd>
                <span class="profile-dot" aria-hidden="true"></span>
                Open for slow conversations
              </dd>
            </div>
          </dl>
        </aside>
      </section>

      <!-- Focus / what we do -->
      <section class="section">
        <header class="section-head" data-reveal>
          <div class="section-head-left">
            <span class="section-num">03</span>
            <h2 class="section-title">What we make</h2>
            <span class="section-sub">Three quiet directions</span>
          </div>
        </header>

        <ul class="focus-grid">
          {focusItems.map((item, i) => (
            <li class={`focus-card focus-${i + 1}`} data-reveal>
              <span class="focus-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="focus-label">{item.label}</h3>
              <p class="focus-body">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Stack -->
      <section class="section">
        <header class="section-head" data-reveal>
          <div class="section-head-left">
            <span class="section-num">04</span>
            <h2 class="section-title">Tools on the desk</h2>
            <span class="section-sub">Nothing fancy — just trusty ones</span>
          </div>
        </header>

        <ul class="stack-list" data-reveal>
          {stack.map((s) => (
            <li class="stack-item">
              <span class="stack-name">{s.name}</span>
              <span class="stack-tag">{s.tag}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Timeline -->
      <section class="section">
        <header class="section-head" data-reveal>
          <div class="section-head-left">
            <span class="section-num">05</span>
            <h2 class="section-title">A short timeline</h2>
            <span class="section-sub">The studio so far</span>
          </div>
        </header>

        <ol class="timeline">
          {journal.map((entry) => (
            <li class="t-row" data-reveal>
              <span class="t-year">{entry.year}</span>
              <div class="t-body">
                <h3 class="t-title">{entry.title}</h3>
                <p class="t-text">{entry.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Elsewhere -->
      <section class="section section-elsewhere">
        <header class="section-head" data-reveal>
          <div class="section-head-left">
            <span class="section-num">06</span>
            <h2 class="section-title">Elsewhere</h2>
            <span class="section-sub">Ways to say hello</span>
          </div>
        </header>

        <ul class="links-grid">
          {elsewhere.map((link) => (
            <li class="link-card" data-reveal>
              <a href={link.href} class="link-anchor" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <span class="link-label">{link.label}</span>
                <span class="link-value">{link.value}</span>
                <span class="link-arrow" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Closing -->
      <section class="closing" data-reveal>
        <p class="closing-quote">
          <span class="quote-mark">“</span>
          Some afternoons the math feels like sunshine. We try to keep
          chasing those afternoons.
          <span class="quote-mark">”</span>
        </p>
        <span class="closing-sig">— Grateful Group</span>
      </section>

      <footer class="foot" data-reveal>
        <span class="foot-left">
          <span class="foot-mark" aria-hidden="true">✿</span>
          © {year} Grateful Group · Drawing every frame a little more gently.
        </span>
        <span class="foot-right">
          <a href="/rss.xml">RSS</a>
          <span class="sep">·</span>
          <a href="mailto:hello@grateful.group">Contact</a>
        </span>
      </footer>
    </main>

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el, i) => {
        el.style.setProperty('--reveal-delay', `${60 + i * 50}ms`);
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #fff7ec;
    --bg-2: #fff1de;
    --ink: #1f2433;
    --ink-soft: #4a5063;
    --ink-mute: #8a8fa0;
    --line: rgba(31, 36, 51, 0.10);
    --line-strong: rgba(31, 36, 51, 0.22);

    --peach: #ffd4b8;
    --mint:  #c8ecd6;
    --sky:   #c8def0;
    --lilac: #e2d4f3;
    --butter:#fce8a3;
    --coral: #ff8a6a;
    --leaf:  #4ea374;
    --plum:  #8a64c8;
    --sun:   #f6b73c;

    --shadow-soft: 0 6px 20px rgba(31, 36, 51, 0.06), 0 1px 0 rgba(31, 36, 51, 0.04);
    --shadow-card: 0 14px 30px -16px rgba(31, 36, 51, 0.18), 0 2px 0 rgba(31, 36, 51, 0.04);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body { background: var(--bg); }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  a { color: inherit; text-decoration: none; }

  /* ---------- Background ---------- */
  .bg-sun {
    position: fixed;
    top: -260px; right: -160px;
    width: 680px; height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(180, 220, 180, 0.85) 0%,
      rgba(160, 210, 165, 0.55) 28%,
      rgba(160, 210, 165, 0.0) 70%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
    animation: sun-pulse 12s ease-in-out infinite alternate;
  }
  @keyframes sun-pulse { to { transform: scale(1.06) translate(-12px, 14px); opacity: 0.92; } }

  .bg-clouds {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    overflow: hidden;
    filter: blur(60px) saturate(115%);
    opacity: 0.7;
  }
  .cloud { position: absolute; border-radius: 50%; mix-blend-mode: multiply; }
  .cloud-1 {
    width: 460px; height: 460px;
    background: radial-gradient(circle, var(--mint) 0%, transparent 70%);
    bottom: -8%; left: -6%;
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .cloud-2 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, var(--butter) 0%, transparent 70%);
    top: 30%; right: -8%;
    animation: drift-b 30s ease-in-out infinite alternate;
  }
  .cloud-3 {
    width: 360px; height: 360px;
    background: radial-gradient(circle, var(--mint) 0%, transparent 70%);
    top: 55%; left: 32%;
    animation: drift-c 24s ease-in-out infinite alternate;
  }
  @keyframes drift-a { to { transform: translate(60px, -40px) scale(1.08); } }
  @keyframes drift-b { to { transform: translate(-70px, 50px) scale(0.96); } }
  @keyframes drift-c { to { transform: translate(40px, -60px) scale(1.05); } }

  .bg-paper {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    opacity: 0.35;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.42  0 0 0 0 0.36  0 0 0 0 0.28  0 0 0 0.18 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: multiply;
  }

  /* ---------- Top navigation ---------- */
  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 12px 18px;
    background: rgba(255, 247, 236, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .topbar.in { opacity: 1; transform: translateY(0); }

  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-left: 6px;
  }
  .brand-mark {
    position: relative;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, var(--leaf) 70%);
    box-shadow: 0 0 0 3px rgba(78, 163, 116, 0.18);
    display: inline-flex; align-items: center; justify-content: center;
    animation: brand-spin 16s linear infinite;
  }
  .sun-core {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.9) inset;
  }
  @keyframes brand-spin { to { transform: rotate(360deg); } }

  .topnav { display: flex; gap: 6px; justify-self: center; }
  .topnav a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }
  .topnav a:hover { color: var(--ink); background: rgba(31, 36, 51, 0.06); transform: translateY(-1px); }
  .topnav a.is-active {
    color: var(--ink);
    background: var(--mint);
    box-shadow: 0 2px 0 rgba(31, 36, 51, 0.08);
  }

  .status {
    display: inline-flex; align-items: center; gap: 8px;
    justify-self: end;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fffaf3;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgba(78, 163, 116, 0.18);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  /* ---------- Shell ---------- */
  .shell {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- Page head ---------- */
  .page-head {
    padding: 80px 0 56px;
    margin-bottom: 24px;
  }

  .head-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 26px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .head-tag.in { opacity: 1; transform: translateY(0); }
  .head-tag-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 4px rgba(78, 163, 116, 0.16);
  }

  .page-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 6.8vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.18em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .page-title.in { opacity: 1; transform: translateY(0); }
  .page-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .ribbon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.18em 0.04em;
    transform: rotate(-2.5deg);
  }
  .ribbon-text {
    position: relative;
    z-index: 2;
    font-style: italic;
    font-weight: 600;
    color: #2a1a08;
  }
  .ribbon-shape {
    position: absolute;
    inset: -0.05em -0.18em -0.12em -0.18em;
    width: calc(100% + 0.36em);
    height: calc(100% + 0.17em);
    z-index: 1;
    fill: var(--mint);
    filter: drop-shadow(0 4px 0 rgba(31, 36, 51, 0.08));
  }

  .page-lede {
    font-size: 1.06rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 720px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .page-lede.in { opacity: 1; transform: translateY(0); }
  .page-lede .hl {
    background: linear-gradient(180deg, transparent 60%, var(--mint) 60%);
    padding: 0 2px;
    color: var(--ink);
    font-weight: 500;
  }

  /* ---------- About grid: manifesto + profile ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 22px;
    margin-bottom: 80px;
  }

  .card-large,
  .card-side {
    border-radius: 22px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    padding: 28px 28px 24px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s, border-color 0.3s;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .card-large.in,
  .card-side.in { opacity: 1; transform: translateY(0); }
  .card-large:hover,
  .card-side:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 40px -18px rgba(31, 36, 51, 0.22), 0 4px 0 rgba(31, 36, 51, 0.05);
    border-color: var(--line-strong);
  }

  .card-large {
    background: linear-gradient(180deg, #fff 0%, var(--mint) 360%);
  }
  .card-side {
    background: linear-gradient(180deg, #fff 0%, var(--peach) 360%);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 22px;
  }
  .card-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--leaf);
    letter-spacing: 0.08em;
  }
  .card-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }

  .card-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .card-em {
    font-style: italic;
    font-weight: 600;
    background: linear-gradient(180deg, transparent 60%, var(--mint) 60%);
    padding: 0 2px;
  }

  .card-body p {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .card-body p:last-child { margin-bottom: 0; }
