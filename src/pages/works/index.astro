---
import { getCollection } from 'astro:content';
import EditorialIndex from '../../components/EditorialIndex.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const entries = works.map((work) => ({
  href: `/works/${work.id}/`,
  title: work.data.title,
  description: work.data.description,
  date: work.data.pubDate,
  meta: 'Interactive note',
}));
---

<EditorialIndex
  pageTitle={`Projects | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  active="works"
  eyebrow="Projects"
  title="Ideas that move under your hand."
  lede="把图形学、几何与实时渲染中的抽象概念，变成可以拖动、旋转、比较和验证的交互笔记。"
  edition="02"
  editionLabel="Graphics & interaction"
  sectionTitle="Selected projects"
  sectionNote="按发布日期排序"
  {entries}
/>
