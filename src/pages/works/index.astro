---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const year = new Date().getFullYear();

const cardTints = ['tint-peach', 'tint-mint', 'tint-sky', 'tint-lilac', 'tint-butter'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Works — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Background layers -->
    <div class="bg-sun" aria-hidden="true"></div>
    <div class="bg-clouds" aria-hidden="true">
      <span class="cloud cloud-1"></span>
      <span class="cloud cloud-2"></span>
      <span class="cloud cloud-3"></span>
    </div>
    <div class="bg-paper" aria-hidden="true"></div>

    <!-- Top navigation -->
    <header class="topbar" data-reveal>
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true">
          <span class="sun-core"></span>
        </span>
        <span class="brand-text">Quiet Lab</span>
      </a>
      <nav class="topnav">
        <a href="/works/" class="is-active"><span>Works</span></a>
        <a href="/blog/"><span>Journal</span></a>
        <a href="/papers/"><span>Papers</span></a>
        <a href="/about/"><span>About</span></a>
      </nav>
      <div class="status">
        <span class="status-dot"></span>
        <span class="status-text">Open · {year}</span>
      </div>
    </header>

    <main class="shell">
      <!-- Page head -->
      <section class="page-head">
        <div class="head-tag" data-reveal>
          <span class="head-tag-dot"></span>
          <span>Studio &nbsp;·&nbsp; Selected Works</span>
        </div>

        <h1 class="page-title" data-reveal>
          <span>Notes that</span>
          <span class="ribbon">
            <span class="ribbon-text">move</span>
            <svg class="ribbon-shape" viewBox="0 0 220 70" aria-hidden="true" preserveAspectRatio="none">
              <path d="M6 38 C 50 6, 130 6, 214 32 C 200 50, 80 70, 6 50 Z" />
            </svg>
          </span>
          <em>under your hand.</em>
        </h1>

        <p class="page-lede" data-reveal>
          A small archive of <span class="hl">real-time 3D</span>,
          <span class="hl">geometry</span> and <span class="hl">ray tracing</span> studies.
          Each piece is a hands-on revision note — you can drag it, rotate it,
          and watch the abstraction become something physical.
        </p>

        <div class="head-meta" data-reveal>
          <span class="meta-pill">
            <span class="meta-num">{String(works.length).padStart(2, '0')}</span>
            <span class="meta-label">pieces</span>
          </span>
          <span class="meta-sep">·</span>
          <a href="/blog/" class="meta-link">
            <span>Read the journal</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </section>

      <!-- Works grid -->
      <section class="works">
        <ul class="card-grid">
          {works.map((item, i) => (
            <li class={`card ${cardTints[i % cardTints.length]}`} data-reveal>
              <a href={`/works/${item.id}/`} class="card-link">
                <div class="card-top">
                  <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="card-arrow" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </span>
                </div>
                <h3 class="card-title">{item.data.title}</h3>
                {item.data.description && (
                  <p class="card-desc">{item.data.description}</p>
                )}
                <div class="card-foot">
                  <FormattedDate date={item.data.pubDate} />
                  <span class="card-pin" aria-hidden="true"></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="foot" data-reveal>
        <span class="foot-left">
          <span class="foot-mark" aria-hidden="true">✿</span>
          © {year} Quiet Lab · Drawing every frame a little more gently.
        </span>
        <span class="foot-right">
          <a href="/rss.xml">RSS</a>
          <span class="sep">·</span>
          <a href="/about/">Contact</a>
        </span>
      </footer>
    </main>

    <script>
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el, i) => {
        el.style.setProperty('--reveal-delay', `${60 + i * 50}ms`);
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }

      const cards = document.querySelectorAll<HTMLElement>('.card');
      cards.forEach((card, i) => {
        const seed = (i * 137) % 7 - 3;
        card.style.setProperty('--tilt', `${seed * 0.5}deg`);
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #fff7ec;
    --bg-2: #fff1de;
    --ink: #1f2433;
    --ink-soft: #4a5063;
    --ink-mute: #8a8fa0;
    --line: rgba(31, 36, 51, 0.10);
    --line-strong: rgba(31, 36, 51, 0.22);

    --peach: #ffd4b8;
    --mint:  #c8ecd6;
    --sky:   #c8def0;
    --lilac: #e2d4f3;
    --butter:#fce8a3;
    --coral: #ff8a6a;
    --leaf:  #4ea374;
    --plum:  #8a64c8;
    --sun:   #f6b73c;

    --shadow-soft: 0 6px 20px rgba(31, 36, 51, 0.06), 0 1px 0 rgba(31, 36, 51, 0.04);
    --shadow-card: 0 14px 30px -16px rgba(31, 36, 51, 0.18), 0 2px 0 rgba(31, 36, 51, 0.04);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body { background: var(--bg); }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  a { color: inherit; text-decoration: none; }

  /* ---------- Background ---------- */
  .bg-sun {
    position: fixed;
    top: -260px; right: -160px;
    width: 680px; height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(220, 190, 210, 0.85) 0%,
      rgba(200, 175, 195, 0.55) 28%,
      rgba(200, 175, 195, 0.0) 70%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
    animation: sun-pulse 12s ease-in-out infinite alternate;
  }
  @keyframes sun-pulse { to { transform: scale(1.06) translate(-12px, 14px); opacity: 0.92; } }

  .bg-clouds {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    overflow: hidden;
    filter: blur(60px) saturate(115%);
    opacity: 0.7;
  }
  .cloud { position: absolute; border-radius: 50%; mix-blend-mode: multiply; }
  .cloud-1 {
    width: 460px; height: 460px;
    background: radial-gradient(circle, var(--peach) 0%, transparent 70%);
    bottom: -8%; left: -6%;
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .cloud-2 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, var(--lilac) 0%, transparent 70%);
    top: 30%; right: -8%;
    animation: drift-b 30s ease-in-out infinite alternate;
  }
  .cloud-3 {
    width: 360px; height: 360px;
    background: radial-gradient(circle, var(--peach) 0%, transparent 70%);
    top: 55%; left: 32%;
    animation: drift-c 24s ease-in-out infinite alternate;
  }
  @keyframes drift-a { to { transform: translate(60px, -40px) scale(1.08); } }
  @keyframes drift-b { to { transform: translate(-70px, 50px) scale(0.96); } }
  @keyframes drift-c { to { transform: translate(40px, -60px) scale(1.05); } }

  .bg-paper {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    opacity: 0.35;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.42  0 0 0 0 0.36  0 0 0 0 0.28  0 0 0 0.18 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: multiply;
  }

  /* ---------- Top navigation ---------- */
  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 12px 18px;
    background: rgba(255, 247, 236, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .topbar.in { opacity: 1; transform: translateY(0); }

  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-left: 6px;
  }
  .brand-mark {
    position: relative;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #c06080 70%);
    box-shadow: 0 0 0 3px rgba(192, 96, 128, 0.18);
    display: inline-flex; align-items: center; justify-content: center;
    animation: brand-spin 16s linear infinite;
  }
  .sun-core {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.9) inset;
  }
  @keyframes brand-spin { to { transform: rotate(360deg); } }

  .topnav { display: flex; gap: 6px; justify-self: center; }
  .topnav a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }
  .topnav a:hover { color: var(--ink); background: rgba(31, 36, 51, 0.06); transform: translateY(-1px); }
  .topnav a.is-active {
    color: var(--ink);
    background: var(--peach);
    box-shadow: 0 2px 0 rgba(31, 36, 51, 0.08);
  }

  .status {
    display: inline-flex; align-items: center; gap: 8px;
    justify-self: end;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fffaf3;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #c06080;
    box-shadow: 0 0 0 3px rgba(192, 96, 128, 0.18);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  /* ---------- Shell ---------- */
  .shell {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- Page head ---------- */
  .page-head {
    padding: 80px 0 48px;
    border-bottom: 1px dashed var(--line-strong);
    margin-bottom: 40px;
  }

  .head-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .head-tag.in { opacity: 1; transform: translateY(0); }
  .head-tag-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #c06080;
    box-shadow: 0 0 0 4px rgba(192, 96, 128, 0.16);
  }

  .page-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 6.4vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.18em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .page-title.in { opacity: 1; transform: translateY(0); }
  .page-title em {
    font-style: italic;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .ribbon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.18em 0.04em;
    transform: rotate(-2.5deg);
  }
  .ribbon-text {
    position: relative;
    z-index: 2;
    font-style: italic;
    font-weight: 600;
    color: #2a1a08;
  }
  .ribbon-shape {
    position: absolute;
    inset: -0.05em -0.18em -0.12em -0.18em;
    width: calc(100% + 0.36em);
    height: calc(100% + 0.17em);
    z-index: 1;
    fill: var(--peach);
    filter: drop-shadow(0 4px 0 rgba(31, 36, 51, 0.08));
  }

  .page-lede {
    font-size: 1.04rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 680px;
    margin-bottom: 30px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .page-lede.in { opacity: 1; transform: translateY(0); }
  .page-lede .hl {
    background: linear-gradient(180deg, transparent 60%, var(--peach) 60%);
    padding: 0 2px;
    color: var(--ink);
    font-weight: 500;
  }

  .head-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .head-meta.in { opacity: 1; transform: translateY(0); }
  .meta-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
  }
  .meta-num {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-style: italic;
    font-size: 1rem;
    color: #c06080;
  }
  .meta-label { color: var(--ink-soft); }
  .meta-sep { color: var(--ink-mute); }
  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    transition: background 0.25s, transform 0.25s, color 0.25s;
  }
  .meta-link svg { transition: transform 0.3s; }
  .meta-link:hover {
    background: var(--peach);
    color: var(--ink);
    transform: translateY(-1px);
  }
  .meta-link:hover svg { transform: translateX(3px); }

  /* ---------- Works grid ---------- */
  .works { padding-bottom: 80px; }

  .card-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }

  .card {
    --tilt: 0deg;
    opacity: 0;
    transform: translateY(16px) rotate(var(--tilt));
    transition: opacity 0.7s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
    transition-delay: var(--reveal-delay, 0ms);
    border-radius: 18px;
    box-shadow: var(--shadow-card);
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .card.in {
    opacity: 1;
    transform: translateY(0) rotate(var(--tilt));
  }
  .card:hover {
    transform: translateY(-6px) rotate(0deg);
    box-shadow: 0 22px 40px -18px rgba(31, 36, 51, 0.22), 0 4px 0 rgba(31, 36, 51, 0.05);
  }

  .card.tint-peach  { background: linear-gradient(180deg, #fff 0%, var(--peach) 240%); }
  .card.tint-mint   { background: linear-gradient(180deg, #fff 0%, var(--mint) 240%); }
  .card.tint-sky    { background: linear-gradient(180deg, #fff 0%, var(--sky) 240%); }
  .card.tint-lilac  { background: linear-gradient(180deg, #fff 0%, var(--lilac) 240%); }
  .card.tint-butter { background: linear-gradient(180deg, #fff 0%, var(--butter) 240%); }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px 20px 18px;
    min-height: 220px;
    color: var(--ink);
  }

  .card-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px;
  }
  .card-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(31, 36, 51, 0.08);
    color: var(--ink-soft);
  }
  .card-arrow {
    display: inline-flex;
    width: 30px; height: 30px;
    align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(31, 36, 51, 0.06);
    color: var(--ink-soft);
    transition: background 0.3s, color 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card-arrow {
    background: var(--ink);
    color: #fff8e8;
    transform: rotate(-12deg) scale(1.05);
  }

  .card-title {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.22rem;
    letter-spacing: -0.012em;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .card-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-soft);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-foot {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed var(--line-strong);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .card-pin {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: #c06080;
    box-shadow: 0 0 0 3px rgba(192, 96, 128, 0.22);
  }
  .card.tint-mint .card-pin   { background: var(--leaf); box-shadow: 0 0 0 3px rgba(78, 163, 116, 0.22); }
  .card.tint-sky .card-pin    { background: #4a8fc9;     box-shadow: 0 0 0 3px rgba(74, 143, 201, 0.22); }
  .card.tint-lilac .card-pin  { background: var(--plum); box-shadow: 0 0 0 3px rgba(138, 100, 200, 0.22); }
  .card.tint-butter .card-pin { background: var(--sun);  box-shadow: 0 0 0 3px rgba(246, 183, 60, 0.22); }

  /* ---------- Footer ---------- */
  .foot {
    display: flex; align-items: center; justify-content: space-between;
    padding: 28px 0 40px;
    margin-top: 12px;
    border-top: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-mute);
    opacity: 0;
    transition: opacity 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .foot.in { opacity: 1; }
  .foot-left { display: inline-flex; align-items: center; gap: 8px; }
  .foot-mark { color: #c06080; font-family: 'Fraunces', serif; font-size: 1rem; }
  .foot-right { display: inline-flex; gap: 12px; }
  .foot-right a { transition: color 0.25s; }
  .foot-right a:hover { color: var(--ink); }
  .foot-right .sep { opacity: 0.5; }

  /* ---------- Responsive ---------- */
  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr auto; gap: 12px; padding: 10px 14px; }
    .topnav { display: none; }
    .shell { padding: 0 22px; }
