---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const works = (await getCollection('works'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- 光标跟随 -->
  <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

  <!-- 全屏居中 Hero -->
  <main class="page">
    <div class="hero">
      <div class="hero-tag">
        <span class="tag-dot"></span>
        Creative Developer
      </div>
      <h1 class="hero-title">
        <span class="line line-1">Exploring</span>
        <span class="line line-2">the <em>Visual</em> Web ✦</span>
      </h1>
      <p class="hero-desc">图形学 · Three.js · Shader · 交互式可视化</p>

      <button class="blog-toggle" id="blogToggle" aria-expanded="false">
        <span class="toggle-text">Blog</span>
        <span class="toggle-count">{posts.length}</span>
        <span class="toggle-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>

      <button class="blog-toggle works-toggle" id="worksToggle" aria-expanded="false">
        <span class="toggle-text">Works</span>
        <span class="toggle-count">{works.length}</span>
        <span class="toggle-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>
    </div>

    <!-- 文章列表 - 默认收起 -->
    <div class="blog-panel" id="blogPanel" aria-hidden="true">
      <div class="blog-list">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-item">
            <span class="item-title">{post.data.title}</span>
            <span class="item-date"><FormattedDate date={post.data.pubDate} /></span>
          </a>
        ))}
      </div>
    </div>

    <!-- Works 列表 - 默认收起 -->
    <div class="blog-panel" id="worksPanel" aria-hidden="true">
      <div class="blog-list">
        {works.map((post) => (
          <a href={`/works/${post.id}/`} class="blog-item">
            <span class="item-title">{post.data.title}</span>
            <span class="item-date"><FormattedDate date={post.data.pubDate} /></span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <script>
    // 光标跟随
    const glow = document.getElementById('cursorGlow');
    let mx = 0, my = 0, gx = 0, gy = 0;
    document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
    function tick() {
      gx += (mx - gx) * 0.06;
      gy += (my - gy) * 0.06;
      if (glow) glow.style.transform = `translate(${gx - 250}px, ${gy - 250}px)`;
      requestAnimationFrame(tick);
    }
    tick();

    // 标题入场
    document.querySelectorAll('.line').forEach((el, i) => {
      setTimeout(() => el.classList.add('show'), 300 + i * 180);
    });

    // Blog 展开/收起
    const toggle = document.getElementById('blogToggle');
    const panel = document.getElementById('blogPanel');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      panel?.setAttribute('aria-hidden', String(expanded));
      toggle.classList.toggle('open');
      panel?.classList.toggle('open');
      // 关闭另一个
      const worksToggle = document.getElementById('worksToggle');
      const worksPanel = document.getElementById('worksPanel');
      if (!expanded) {
        worksToggle?.classList.remove('open');
        worksPanel?.classList.remove('open');
        worksToggle?.setAttribute('aria-expanded', 'false');
        worksPanel?.setAttribute('aria-hidden', 'true');
      }
    });

    // Works 展开/收起
    const worksToggle = document.getElementById('worksToggle');
    const worksPanel = document.getElementById('worksPanel');
    worksToggle?.addEventListener('click', () => {
      const expanded = worksToggle.getAttribute('aria-expanded') === 'true';
      worksToggle.setAttribute('aria-expanded', String(!expanded));
      worksPanel?.setAttribute('aria-hidden', String(expanded));
      worksToggle.classList.toggle('open');
      worksPanel?.classList.toggle('open');
      // 关闭另一个
      if (!expanded) {
        toggle?.classList.remove('open');
        panel?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
        panel?.setAttribute('aria-hidden', 'true');
      }
    });
  </script>
</body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    background: #fafbfd;
    color: #1a1a2e;
    min-height: 100vh;
    overflow-x: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 光标光晕 */
  .cursor-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99,102,241,0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    top: 0; left: 0;
    will-change: transform;
  }

  /* 页面容器 */
  .page {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 600px;
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #eef2ff;
    font-size: 0.78rem;
    font-weight: 500;
    color: #6366f1;
    margin-bottom: 36px;
    box-shadow: 0 2px 12px rgba(99,102,241,0.06);
    animation: fade-down 0.6s ease both;
  }

  .tag-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #10b981;
    animation: blink 2s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-title {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.04em;
    color: #0f0f23;
    margin-bottom: 16px;
  }

  .hero-title em {
    font-style: normal;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .line {
    display: block;
    opacity: 0;
    transform: translateY(16px);
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .line.show {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-desc {
    font-size: 1rem;
    color: #64748b;
    margin-bottom: 48px;
    font-weight: 400;
    letter-spacing: 0.01em;
    animation: fade-down 0.8s 0.5s ease both;
  }

  /* Blog Toggle Button */
  .blog-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 100px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #1a1a2e;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    animation: fade-down 0.8s 0.7s ease both;
  }

  .blog-toggle:hover {
    border-color: #c7d2fe;
    box-shadow: 0 6px 24px rgba(99,102,241,0.1);
    transform: translateY(-2px);
  }

  .blog-toggle.open {
    border-color: #6366f1;
    background: #6366f1;
    color: #fff;
    box-shadow: 0 6px 24px rgba(99,102,241,0.25);
  }

  .works-toggle.open {
    border-color: #10b981;
    background: #10b981;
    color: #fff;
    box-shadow: 0 6px 24px rgba(16,185,129,0.25);
  }

  .toggle-count {
    padding: 2px 8px;
    border-radius: 100px;
    background: rgba(99,102,241,0.08);
    font-size: 0.75rem;
    font-weight: 600;
    color: #6366f1;
    transition: all 0.3s;
  }

  .blog-toggle.open .toggle-count {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  .toggle-icon {
    display: flex;
    align-items: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-toggle.open .toggle-icon {
    transform: rotate(180deg);
  }

  /* Blog Panel */
  .blog-panel {
    width: 100%;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.4s ease,
                margin-top 0.4s ease;
    opacity: 0;
    margin-top: 0;
  }

  .blog-panel.open {
    max-height: 800px;
    opacity: 1;
    margin-top: 32px;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  }

  .blog-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .blog-item:hover {
    background: #f8fafc;
  }

  .blog-item + .blog-item {
    border-top: 1px solid #f8fafc;
  }

  .item-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: #1a1a2e;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-date {
    font-size: 0.75rem;
    color: #94a3b8;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .hero-title {
      font-size: 2.2rem;
    }

    .blog-toggle {
      padding: 12px 22px;
      font-size: 0.85rem;
    }

    .blog-item {
      padding: 14px 16px;
    }

    .cursor-glow {
      display: none;
    }
  }
</style>
