---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

const FEATURED_LIMIT = 3;

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allWorks = (await getCollection('works'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredWorks = allWorks.slice(0, FEATURED_LIMIT);
const featuredPosts = allPosts.slice(0, FEATURED_LIMIT);

const year = new Date().getFullYear();
const cardTints = ['tint-peach', 'tint-mint', 'tint-sky'];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=JetBrains+Mono:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <!-- Background layers -->
  <div class="bg-sun" aria-hidden="true"></div>
  <div class="bg-clouds" aria-hidden="true">
    <span class="cloud cloud-1"></span>
    <span class="cloud cloud-2"></span>
    <span class="cloud cloud-3"></span>
  </div>
  <div class="bg-paper" aria-hidden="true"></div>

  <!-- Top navigation -->
  <header class="topbar" data-reveal>
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <span class="sun-core"></span>
      </span>
      <span class="brand-text">Quiet Lab</span>
    </a>
    <nav class="topnav">
      <a href="/works/"><span>Works</span></a>
      <a href="/blog/"><span>Journal</span></a>
      <a href="/papers/"><span>Papers</span></a>
      <a href="/about/"><span>About</span></a>
    </nav>
    <div class="status">
      <span class="status-dot"></span>
      <span class="status-text">Open · {year}</span>
    </div>
  </header>

  <main class="shell">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-tag" data-reveal>
        <span class="hero-tag-dot"></span>
        <span>Studio Notes &nbsp;·&nbsp; A small place of light</span>
      </div>

      <h1 class="headline">
        <span class="word" data-reveal>Make the web</span>
        <span class="word word-mix" data-reveal>
          feel like a
          <span class="ribbon">
            <span class="ribbon-text">sunny</span>
            <svg class="ribbon-shape" viewBox="0 0 220 70" aria-hidden="true" preserveAspectRatio="none">
              <path d="M6 38 C 50 6, 130 6, 214 32 C 200 50, 80 70, 6 50 Z" />
            </svg>
          </span>
        </span>
        <span class="word word-end" data-reveal>
          afternoon <span class="emoji" aria-hidden="true">☀︎</span>
        </span>
      </h1>

      <div class="hero-bottom" data-reveal>
        <p class="hero-lede">
          A quiet studio for <em>real-time 3D</em>, <em>shaders</em> and the
          patient corners of computer graphics. The kind of ideas that look
          opaque on paper become things you can drag, rotate and feel.
        </p>
        <div class="hero-actions">
          <a href="#works" class="cta cta-primary">
            <span>See the works</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/about/" class="cta cta-ghost">
            <span>About the studio</span>
          </a>
        </div>
      </div>

      <!-- Floating ornaments -->
      <span class="float float-1" aria-hidden="true">✿</span>
      <span class="float float-2" aria-hidden="true">✦</span>
      <span class="float float-3" aria-hidden="true">◌</span>
    </section>

    <!-- Tag strip -->
    <div class="chips" data-reveal>
      <span class="chip">GLSL</span>
      <span class="chip">Three.js</span>
      <span class="chip">R3F</span>
      <span class="chip">Bézier</span>
      <span class="chip">Ray Marching</span>
      <span class="chip">PBR</span>
      <span class="chip">SDF</span>
      <span class="chip">Mesh</span>
      <span class="chip">TBN</span>
      <span class="chip">Shadow</span>
      <span class="chip">WebGL</span>
    </div>

    <!-- Selected Works -->
    <section class="index" id="works">
      <header class="index-head" data-reveal>
        <div class="index-head-left">
          <span class="index-num">02</span>
          <h2 class="index-title">Selected Works</h2>
          <span class="index-sub">Notes that move</span>
        </div>
        <a href="/works/" class="index-more">
          <span>All {String(allWorks.length).padStart(2, '0')}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </header>

      <ul class="card-grid card-grid-3">
        {featuredWorks.map((item, i) => (
          <li class={`card ${cardTints[i % cardTints.length]}`} data-reveal>
            <a href={`/works/${item.id}/`} class="card-link">
              <div class="card-top">
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="card-arrow" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </div>
              <h3 class="card-title">{item.data.title}</h3>
              <div class="card-foot">
                <FormattedDate date={item.data.pubDate} />
                <span class="card-pin" aria-hidden="true"></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Recent Journal -->
    <section class="index" id="journal">
      <header class="index-head" data-reveal>
        <div class="index-head-left">
          <span class="index-num">03</span>
          <h2 class="index-title">From the Journal</h2>
          <span class="index-sub">Words on light and math</span>
        </div>
        <a href="/blog/" class="index-more">
          <span>All {String(allPosts.length).padStart(2, '0')}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </header>

      <ul class="post-list">
        {featuredPosts.map((post) => (
          <li class="post-row" data-reveal>
            <a href={`/blog/${post.id}/`} class="post-link">
              <span class="post-bullet" aria-hidden="true"></span>
              <span class="post-title">{post.data.title}</span>
              <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
              <span class="post-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Footer -->
    <footer class="foot" data-reveal>
      <span class="foot-left">
        <span class="foot-mark" aria-hidden="true">✿</span>
        © {year} Quiet Lab · Drawing every frame a little more gently.
      </span>
      <span class="foot-right">
        <a href="/rss.xml">RSS</a>
        <span class="sep">·</span>
        <a href="/about/">Contact</a>
      </span>
    </footer>
  </main>

  <script>
    // Reveal-on-scroll animations
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    items.forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${60 + i * 50}ms`);
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('in'));
    }

    // Subtle sticker-style tilt per card
    const cards = document.querySelectorAll<HTMLElement>('.card');
    cards.forEach((card, i) => {
      const seed = (i * 137) % 7 - 3;
      card.style.setProperty('--tilt', `${seed * 0.5}deg`);
    });
  </script>
</body>
</html>

<style>
  :root {
    --bg: #fff7ec;
    --bg-2: #fff1de;
    --ink: #1f2433;
    --ink-soft: #4a5063;
    --ink-mute: #8a8fa0;
    --line: rgba(31, 36, 51, 0.10);
    --line-strong: rgba(31, 36, 51, 0.22);

    --peach: #ffd4b8;
    --mint:  #c8ecd6;
    --sky:   #c8def0;
    --lilac: #e2d4f3;
    --butter:#fce8a3;
    --coral: #ff8a6a;
    --leaf:  #4ea374;
    --plum:  #8a64c8;
    --sun:   #f6b73c;

    --shadow-soft: 0 6px 20px rgba(31, 36, 51, 0.06), 0 1px 0 rgba(31, 36, 51, 0.04);
    --shadow-card: 0 14px 30px -16px rgba(31, 36, 51, 0.18), 0 2px 0 rgba(31, 36, 51, 0.04);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body { background: var(--bg); }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a { color: inherit; text-decoration: none; }

  /* ---------- Background: sun + clouds + paper ---------- */
  .bg-sun {
    position: fixed;
    top: -260px; right: -160px;
    width: 680px; height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      rgba(245, 235, 215, 0.9) 0%,
      rgba(235, 225, 205, 0.5) 28%,
      rgba(235, 225, 205, 0.0) 70%);
    filter: blur(10px);
    z-index: 0;
    pointer-events: none;
    animation: sun-pulse 12s ease-in-out infinite alternate;
  }
  @keyframes sun-pulse {
    to { transform: scale(1.06) translate(-12px, 14px); opacity: 0.92; }
  }

  .bg-clouds {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    overflow: hidden;
    filter: blur(60px) saturate(115%);
    opacity: 0.7;
  }
  .cloud { position: absolute; border-radius: 50%; mix-blend-mode: multiply; }
  .cloud-1 {
    width: 460px; height: 460px;
    background: radial-gradient(circle, var(--mint) 0%, transparent 70%);
    bottom: -8%; left: -6%;
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .cloud-2 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, var(--lilac) 0%, transparent 70%);
    top: 30%; right: -8%;
    animation: drift-b 30s ease-in-out infinite alternate;
  }
  .cloud-3 {
    width: 360px; height: 360px;
    background: radial-gradient(circle, var(--sky) 0%, transparent 70%);
    top: 55%; left: 32%;
    animation: drift-c 24s ease-in-out infinite alternate;
  }
  @keyframes drift-a { to { transform: translate(60px, -40px) scale(1.08); } }
  @keyframes drift-b { to { transform: translate(-70px, 50px) scale(0.96); } }
  @keyframes drift-c { to { transform: translate(40px, -60px) scale(1.05); } }

  .bg-paper {
    position: fixed; inset: 0;
    z-index: 0; pointer-events: none;
    opacity: 0.35;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.42  0 0 0 0 0.36  0 0 0 0 0.28  0 0 0 0.18 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: multiply;
  }

  /* ---------- Top navigation ---------- */
  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 12px 18px;
    background: rgba(255, 247, 236, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .topbar.in { opacity: 1; transform: translateY(0); }

  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-left: 6px;
  }
  .brand-mark {
    position: relative;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, var(--sun) 70%);
    box-shadow: 0 0 0 3px rgba(246, 183, 60, 0.18);
    display: inline-flex; align-items: center; justify-content: center;
    animation: brand-spin 16s linear infinite;
  }
  .sun-core {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.9) inset;
  }
  @keyframes brand-spin { to { transform: rotate(360deg); } }

  .topnav { display: flex; gap: 6px; justify-self: center; }
  .topnav a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }
  .topnav a:hover {
    color: var(--ink);
    background: rgba(31, 36, 51, 0.06);
    transform: translateY(-1px);
  }

  .status {
    display: inline-flex; align-items: center; gap: 8px;
    justify-self: end;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fffaf3;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgba(78, 163, 116, 0.18);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  /* ---------- Shell ---------- */
  .shell {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: 96px 0 56px;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin-bottom: 28px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .hero-tag.in { opacity: 1; transform: translateY(0); }
  .hero-tag-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #5b8fd9;
    box-shadow: 0 0 0 4px rgba(91, 143, 217, 0.16);
  }

  .headline {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(3rem, 8.6vw, 7.2rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .headline .word {
    display: block;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .headline .word.in { opacity: 1; transform: translateY(0); }

  .word-mix {
    display: flex !important;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.22em;
    font-style: italic;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .word-end {
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .word-end .emoji {
    color: var(--sun);
    font-style: normal;
    margin-left: 0.18em;
    display: inline-block;
    animation: emoji-spin 8s linear infinite;
  }
  @keyframes emoji-spin { to { transform: rotate(360deg); } }

  /* Ribbon highlight */
  .ribbon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.18em 0.04em;
    transform: rotate(-2.5deg);
  }
  .ribbon-text {
    position: relative;
    z-index: 2;
    font-style: italic;
    font-weight: 600;
    color: #2a1a08;
  }
  .ribbon-shape {
    position: absolute;
    inset: -0.05em -0.18em -0.12em -0.18em;
    width: calc(100% + 0.36em);
    height: calc(100% + 0.17em);
    z-index: 1;
    fill: var(--butter);
    filter: drop-shadow(0 4px 0 rgba(31, 36, 51, 0.08));
  }

  .hero-bottom {
    margin-top: 52px;
    display: grid;
    grid-template-columns: 1.2fr auto;
    gap: 36px;
    align-items: end;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--reveal-delay, 200ms);
  }
  .hero-bottom.in { opacity: 1; transform: translateY(0); }

  .hero-lede {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 580px;
    font-weight: 400;
  }
  .hero-lede em {
    font-style: normal;
    background: linear-gradient(180deg, transparent 60%, var(--mint) 60%);
    padding: 0 2px;
    color: var(--ink);
    font-weight: 500;
  }

  .hero-actions {
    display: inline-flex;
    gap: 10px;
    align-items: center;
  }

  .cta {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 13px 20px;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s, background 0.3s, color 0.3s, border-color 0.3s;
  }
  .cta-primary {
    background: var(--ink);
    color: #fff8e8;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--ink);
  }
  .cta-primary:hover {
    transform: translateY(-2px) rotate(-0.4deg);
    background: #5b8fd9;
    border-color: #5b8fd9;
    color: #fff;
    box-shadow: 0 16px 32px -16px rgba(91, 143, 217, 0.6);
  }
  .cta-primary svg { transition: transform 0.3s; }
  .cta-primary:hover svg { transform: translateX(4px); }

  .cta-ghost {
    background: rgba(255, 255, 255, 0.6);
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }
  .cta-ghost:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  /* Floating ornaments */
  .float {
    position: absolute;
    font-family: 'Fraunces', serif;
    pointer-events: none;
  }
  .float-1 {
    top: 70px; right: 8%;
    color: var(--plum);
    font-size: 2.2rem;
    animation: floaty 7s ease-in-out infinite;
  }
  .float-2 {
    top: 200px; right: 22%;
    color: var(--plum);
    font-size: 1.6rem;
    animation: floaty 9s ease-in-out infinite reverse;
  }
  .float-3 {
    bottom: 70px; right: 4%;
    color: #5b8fd9;
    font-size: 1.8rem;
    animation: floaty 8s ease-in-out infinite;
    animation-delay: -2s;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-12px) rotate(8deg); }
  }

  /* ---------- Tag strip ---------- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 18px 0;
    border-top: 1px dashed var(--line-strong);
    border-bottom: 1px dashed var(--line-strong);
    margin: 36px 0 88px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .chips.in { opacity: 1; transform: translateY(0); }
  .chip {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    color: var(--ink-soft);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s, color 0.25s;
  }
  .chip:nth-child(5n+1):hover { background: var(--peach); color: var(--ink); transform: translateY(-2px) rotate(-2deg); }
  .chip:nth-child(5n+2):hover { background: var(--mint);  color: var(--ink); transform: translateY(-2px) rotate(1.5deg); }
