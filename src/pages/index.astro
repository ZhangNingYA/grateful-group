---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/editorial.css';

const [works, learning, papers, threeD] = await Promise.all([
  getCollection('works'),
  getCollection('learning'),
  getCollection('papers'),
  getCollection('threeD'),
]);

const sections = [
  {
    href: '/works/',
    label: 'Projects',
    count: works.length,
    description: 'Interactive notes on graphics, geometry, and real-time rendering.',
  },
  {
    href: '/blog/',
    label: 'Reading',
    count: 0,
    description: 'English texts studied closely, sentence by sentence.',
  },
  {
    href: '/learning/',
    label: 'Learning',
    count: learning.length,
    description: 'Reading practice, concept maps, and an evolving learning archive.',
  },
  {
    href: '/papers/',
    label: 'Papers',
    count: papers.length,
    description: 'Context notes on papers, methods, and lines of research.',
  },
  {
    href: '/threeD/',
    label: 'ThreeD',
    count: threeD.length,
    description: 'Experiments in Three.js and real-time three-dimensional interfaces.',
  },
];

const recent = [
  ...works.map((entry) => ({ ...entry, href: `/works/${entry.id}/`, section: 'Projects' })),
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="editorial-page home-page">
    <BlogHeader />

    <main class="editorial-shell">
      <header class="editorial-hero home-hero">
        <div class="editorial-hero-copy">
          <p class="editorial-eyebrow">A personal practice</p>
          <h1 class="editorial-title">Care for the work.</h1>
          <p class="home-statement">Projects, notes, and experiments from a practice in progress.</p>
        </div>
      </header>

      <section class="editorial-index home-directory" aria-labelledby="directory-heading">
        <div class="editorial-section-heading">
          <h2 id="directory-heading">Explore the archive</h2>
          <span>{sections.reduce((sum, section) => sum + section.count, 0)} published entries</span>
        </div>

        <div class="editorial-list">
          {sections.map((section, index) => (
            <article class="editorial-row directory-row">
              <a href={section.href}>
                <span class="editorial-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="editorial-row-copy">
                  <div class="editorial-meta">
                    <span>{String(section.count).padStart(2, '0')} entries</span>
                  </div>
                  <h3>{section.label}</h3>
                  <p>{section.description}</p>
                </div>
                <span class="editorial-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="editorial-index recent-index" aria-labelledby="recent-heading">
        <div class="editorial-section-heading">
          <h2 id="recent-heading">Recently published</h2>
          <span>Reading & Projects</span>
        </div>

        <div class="editorial-list">
          {recent.map((entry, index) => (
            <article class="editorial-row">
              <a href={entry.href}>
                <span class="editorial-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="editorial-row-copy">
                  <div class="editorial-meta">
                    <FormattedDate date={entry.data.pubDate} />
                    <span class="editorial-meta-extra">{entry.section}</span>
                  </div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span class="editorial-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="editorial-footer">
      <span>© {new Date().getFullYear()} Tend</span>
      <span class="editorial-footer-links">
        <a href="/about/">About</a>
      </span>
    </footer>
  </body>
</html>

<style>
  .home-hero {
    min-height: 300px;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    padding: 58px 0 44px;
  }

  .home-hero .editorial-title {
    max-width: 760px;
    margin: 14px 0 16px;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 2.875rem;
    font-weight: 500;
    line-height: 1.05;
  }

  .home-statement {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-family: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 1rem;
    line-height: 1.65;
  }

  .directory-row > a {
    min-height: 150px;
  }

  .recent-index {
    padding-top: 0;
  }

  @media (max-width: 720px) {
    .home-hero {
      min-height: 0;
      padding: 46px 0 38px;
    }

    .home-hero .editorial-title { font-size: 2rem; }
    .home-statement { font-size: 0.94rem; }
  }
</style>
