---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/editorial.css';

const [blog, works, learning, papers, threeD] = await Promise.all([
  getCollection('blog'),
  getCollection('works'),
  getCollection('learning'),
  getCollection('papers'),
  getCollection('threeD'),
]);

const sections = [
  {
    href: '/works/',
    label: 'Works',
    count: works.length,
    description: '图形学、几何与实时渲染的交互笔记。',
  },
  {
    href: '/blog/',
    label: 'Journal',
    count: blog.length,
    description: '科学、技术与语言阅读中的长篇观察。',
  },
  {
    href: '/learning/',
    label: 'Learning',
    count: learning.length,
    description: '阅读练习、概念地图与持续更新的学习档案。',
  },
  {
    href: '/papers/',
    label: 'Papers',
    count: papers.length,
    description: '论文、方法与研究脉络的上下文笔记。',
  },
  {
    href: '/threeD/',
    label: 'ThreeD',
    count: threeD.length,
    description: 'Three.js 与实时三维网页的实践路径。',
  },
];

const recent = [
  ...blog.map((entry) => ({ ...entry, href: `/blog/${entry.id}/`, section: 'Journal' })),
  ...works.map((entry) => ({ ...entry, href: `/works/${entry.id}/`, section: 'Works' })),
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="editorial-page home-page">
    <BlogHeader />

    <main class="editorial-shell">
      <header class="editorial-hero home-hero">
        <div class="editorial-hero-copy">
          <p class="editorial-eyebrow">Independent studio / Notes in progress</p>
          <h1 class="editorial-title">Quiet Lab</h1>
          <p class="home-statement">Ideas are easier to understand when they can be read, moved and tested.</p>
          <p class="editorial-lede">
            一个关于图形学、科学阅读与交互实验的安静档案。这里把抽象概念拆成可以反复阅读、亲手验证的页面。
          </p>
        </div>
        <div class="editorial-edition" aria-label="站点信息">
          <span>Est. 2025</span>
          <strong>QL</strong>
          <span>Read / move / test</span>
        </div>
      </header>

      <section class="editorial-index home-directory" aria-labelledby="directory-heading">
        <div class="editorial-section-heading">
          <h2 id="directory-heading">Explore the archive</h2>
          <span>{sections.reduce((sum, section) => sum + section.count, 0)} published entries</span>
        </div>

        <div class="editorial-list">
          {sections.map((section, index) => (
            <article class="editorial-row directory-row">
              <a href={section.href}>
                <span class="editorial-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="editorial-row-copy">
                  <div class="editorial-meta">
                    <span>{String(section.count).padStart(2, '0')} entries</span>
                  </div>
                  <h3>{section.label}</h3>
                  <p>{section.description}</p>
                </div>
                <span class="editorial-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="editorial-index recent-index" aria-labelledby="recent-heading">
        <div class="editorial-section-heading">
          <h2 id="recent-heading">Recently published</h2>
          <span>Journal & Works</span>
        </div>

        <div class="editorial-list">
          {recent.map((entry, index) => (
            <article class="editorial-row">
              <a href={entry.href}>
                <span class="editorial-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="editorial-row-copy">
                  <div class="editorial-meta">
                    <FormattedDate date={entry.data.pubDate} />
                    <span class="editorial-meta-extra">{entry.section}</span>
                  </div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                </div>
                <span class="editorial-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="editorial-footer">
      <span>© {new Date().getFullYear()} Quiet Lab</span>
      <span class="editorial-footer-links">
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
  </body>
</html>

<style>
  .home-hero {
    min-height: 430px;
  }

  .home-hero .editorial-title {
    margin-bottom: 14px;
  }

  .home-statement {
    max-width: 760px;
    margin: 0 0 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2.3vw, 1.8rem);
    line-height: 1.35;
  }

  .directory-row > a {
    min-height: 150px;
  }

  .recent-index {
    padding-top: 0;
  }

  @media (max-width: 720px) {
    .home-hero {
      min-height: 0;
    }

    .home-statement {
      font-size: 1.25rem;
    }
  }
</style>
