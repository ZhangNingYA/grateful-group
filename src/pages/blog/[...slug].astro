---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const postIndex = posts.findIndex((entry) => entry.id === post.id);
const previousPost = posts[postIndex + 1];
const nextPost = posts[postIndex - 1];

const aiFakeNewsHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
	{ depth: 2, slug: '004', text: '004' },
	{ depth: 2, slug: '005', text: '005' },
	{ depth: 2, slug: '006', text: '006' },
	{ depth: 2, slug: '007', text: '007' },
	{ depth: 2, slug: '008', text: '008' },
] satisfies typeof headings;

const cottonwoodFireHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
] satisfies typeof headings;

const nasaTessHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
	{ depth: 2, slug: '004', text: '004' },
	{ depth: 2, slug: '005', text: '005' },
] satisfies typeof headings;

const soilMicroplasticsHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
	{ depth: 2, slug: '004', text: '004' },
	{ depth: 2, slug: '005', text: '005' },
	{ depth: 2, slug: '006', text: '006' },
	{ depth: 2, slug: '007', text: '007' },
	{ depth: 2, slug: '008', text: '008' },
] satisfies typeof headings;

const superTyphoonBaviHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
] satisfies typeof headings;

const threePartReadingHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
] satisfies typeof headings;

const eightPartReadingHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
	{ depth: 2, slug: '003', text: '003' },
	{ depth: 2, slug: '004', text: '004' },
	{ depth: 2, slug: '005', text: '005' },
	{ depth: 2, slug: '006', text: '006' },
	{ depth: 2, slug: '007', text: '007' },
	{ depth: 2, slug: '008', text: '008' },
] satisfies typeof headings;

const twoPartReadingHeadings = [
	{ depth: 2, slug: '001', text: '001' },
	{ depth: 2, slug: '002', text: '002' },
] satisfies typeof headings;

const manualHeadings: Record<string, typeof headings> = {
	'2021-12-what-shapes-cultural-values': threePartReadingHeadings,
	'2021-12-automation-economic-security': threePartReadingHeadings,
	'2021-12-why-facts-dont-change-our-minds': eightPartReadingHeadings,
	'2021-12-clothing-choices-well-being': twoPartReadingHeadings,
	'2026-06-ai-fake-news': aiFakeNewsHeadings,
	'2026-07-cottonwood-fire-chars-utah': cottonwoodFireHeadings,
	'2026-07-nasa-tess-planetary-system': nasaTessHeadings,
	'2026-07-soil-microplastics': soilMicroplasticsHeadings,
	'2026-07-super-typhoon-bavi': superTyphoonBaviHeadings,
};

const tocHeadings = manualHeadings[post.id] ?? headings;
---

<BlogPost
	{...post.data}
	headings={tocHeadings}
	previousPost={previousPost && { id: previousPost.id, title: previousPost.data.title }}
	nextPost={nextPost && { id: nextPost.id, title: nextPost.data.title }}
>
	<Content />
</BlogPost>
