---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import { SITE_TITLE } from '../../consts';

const textCount = 0;

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={`Reading | ${SITE_TITLE}`}
      description="English texts, studied sentence by sentence."
    />
  </head>

  <body>
    <BlogHeader active="reading" />

    <main>
      <header class="reading-head">
        <div class="reading-copy">
          <p class="eyebrow">Reading / {String(textCount).padStart(2, '0')} texts</p>
          <h1>Read with <span class="attention-word">attention.<span class="attention-rule" aria-hidden="true"></span></span></h1>
          <p class="lede">English texts, studied sentence by sentence.</p>
        </div>
        <aside class="reading-index" aria-label={`${textCount} texts in the reading archive`}>
          <div class="reading-index-top">
            <span>Reading archive</span>
            <span>Open</span>
          </div>
          <strong>{String(textCount).padStart(2, '0')}</strong>
          <div class="reading-index-bottom">
            <span>English texts</span>
            <span>Close study</span>
          </div>
        </aside>
      </header>

      <section class="empty-archive" aria-labelledby="archive-heading">
        <span class="empty-count" aria-hidden="true">00</span>
        <div class="empty-copy">
          <p class="empty-kicker">Reading archive</p>
          <h2 id="archive-heading">No texts yet.</h2>
          <p>The archive is ready for its next close reading.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Tend</span>
      <a href="/about/">About</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f8f9f7;
    --ink: #17201c;
    --muted: #626b66;
    --line: #dfe3e0;
    --coral: #d9654b;
  }

  * { box-sizing: border-box; }

  html { background: var(--paper); }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-atkinson), 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main,
  .site-footer {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .reading-head {
    min-height: 380px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    align-items: stretch;
    gap: 72px;
    padding: 72px 0 54px;
    border-bottom: 1px solid var(--ink);
  }

  .reading-copy {
    max-width: 780px;
    align-self: end;
  }

  .eyebrow,
  .reading-index-top,
  .reading-index-bottom,
  .empty-kicker {
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 18px 0 24px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .attention-word {
    position: relative;
    display: inline-block;
  }

  .attention-rule {
    position: absolute;
    right: 0.04em;
    bottom: -0.09em;
    left: 0.02em;
    height: 3px;
    background: var(--coral);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    animation: attention-mark 5.6s ease-in-out infinite;
  }

  .lede {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .reading-index {
    min-height: 210px;
    padding-left: 28px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-left: 1px solid var(--line);
  }

  .reading-index-top,
  .reading-index-bottom {
    display: flex;
    justify-content: space-between;
  }

  .reading-index-top {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
  }

  .reading-index strong {
    align-self: center;
    color: #4f78a3;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 4.75rem;
    font-weight: 450;
    line-height: 1;
  }

  .reading-index-bottom {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .empty-archive {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 24px;
    min-height: 220px;
    padding: 48px 0 72px;
    border-bottom: 1px solid var(--line);
  }

  .empty-count {
    color: var(--coral);
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.45rem;
  }

  .empty-kicker { margin-bottom: 10px; }

  .empty-copy h2 {
    margin: 0 0 10px;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .empty-copy > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    padding: 24px 0 36px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer a { color: inherit; }

  @keyframes attention-mark {
    0%, 8% { opacity: 0; transform: scaleX(0); }
    18%, 72% { opacity: 1; transform: scaleX(1); }
    86%, 100% { opacity: 0; transform: scaleX(1); }
  }

  @media (max-width: 720px) {
    main,
    .site-footer { width: min(100% - 32px, 1160px); }

    .reading-head {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 54px 0 38px;
    }

    h1 {
      margin: 14px 0 20px;
      font-size: 2.8rem;
      line-height: 1.02;
    }

    .reading-index {
      min-height: 0;
      padding-left: 18px;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 24px;
    }

    .reading-index strong {
      grid-row: 1 / 3;
      font-size: 3.6rem;
    }

    .reading-index-top,
    .reading-index-bottom {
      grid-column: 2;
      padding: 9px 0;
    }

    .empty-archive {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 12px;
      min-height: 190px;
      padding: 38px 0 56px;
    }

    .empty-count { font-size: 1.1rem; }
    .empty-copy h2 { font-size: 1.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }

    .attention-rule {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
