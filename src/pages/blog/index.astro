---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>

	<body>
		<!-- 光标跟随 -->
		<div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

		<nav class="nav">
			<a href="/" class="nav-back">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<polyline points="15 18 9 12 15 6"></polyline>
				</svg>
				Home
			</a>
		</nav>

		<main class="page">
			<header class="header">
				<div class="header-tag">
					<span class="tag-dot"></span>
					Archive
				</div>
				<h1 class="header-title">Blog</h1>
				<p class="header-desc">{posts.length} posts · 图形学 · 可视化 · 笔记</p>
			</header>

			<section class="posts">
				{posts.map((post, index) => (
					<a href={`/blog/${post.id}/`} class="post-card" style={`animation-delay: ${0.1 + index * 0.05}s`}>
						<div class="post-card-inner">
							<div class="post-info">
								<span class="post-index">{String(index + 1).padStart(2, '0')}</span>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
							</div>
							<div class="post-meta">
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="post-arrow">
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="5" y1="12" x2="19" y2="12"></line>
										<polyline points="12 5 19 12 12 19"></polyline>
									</svg>
								</span>
							</div>
						</div>
					</a>
				))}
			</section>
		</main>

		<script>
			const glow = document.getElementById('cursorGlow');
			let mx = 0, my = 0, gx = 0, gy = 0;
			document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
			function tick() {
				gx += (mx - gx) * 0.06;
				gy += (my - gy) * 0.06;
				if (glow) glow.style.transform = `translate(${gx - 250}px, ${gy - 250}px)`;
				requestAnimationFrame(tick);
			}
			tick();
		</script>
	</body>
</html>

<style>
	* { margin: 0; padding: 0; box-sizing: border-box; }

	body {
		font-family: 'Space Grotesk', -apple-system, sans-serif;
		background: #fafbfd;
		color: #1a1a2e;
		min-height: 100vh;
		overflow-x: hidden;
	}

	/* 光标光晕 */
	.cursor-glow {
		position: fixed;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(99,102,241,0.05) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
		top: 0; left: 0;
		will-change: transform;
	}

	/* Nav */
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 20px 24px;
		backdrop-filter: blur(12px);
		background: rgba(250, 251, 253, 0.8);
	}

	.nav-back {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 8px 16px 8px 12px;
		border-radius: 100px;
		background: #fff;
		border: 1px solid #eef2ff;
		font-size: 0.82rem;
		font-weight: 500;
		color: #6366f1;
		text-decoration: none;
		transition: all 0.3s ease;
		box-shadow: 0 2px 12px rgba(99,102,241,0.06);
	}

	.nav-back:hover {
		border-color: #c7d2fe;
		box-shadow: 0 4px 16px rgba(99,102,241,0.12);
		transform: translateY(-1px);
	}

	/* Page */
	.page {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 680px;
		margin: 0 auto;
		padding: 40px 24px 80px;
	}

	/* Header */
	.header {
		text-align: center;
		margin-bottom: 48px;
	}

	.header-tag {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px 6px 10px;
		border-radius: 100px;
		background: #fff;
		border: 1px solid #eef2ff;
		font-size: 0.78rem;
		font-weight: 500;
		color: #6366f1;
		margin-bottom: 24px;
		box-shadow: 0 2px 12px rgba(99,102,241,0.06);
		animation: fade-down 0.6s ease both;
	}

	.tag-dot {
		width: 6px; height: 6px;
		border-radius: 50%;
		background: #10b981;
		animation: blink 2s ease-in-out infinite;
	}

	.header-title {
		font-size: clamp(2.8rem, 8vw, 4rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		color: #0f0f23;
		margin-bottom: 12px;
		animation: fade-down 0.7s 0.1s ease both;
	}

	.header-desc {
		font-size: 1rem;
		color: #64748b;
		font-weight: 400;
		animation: fade-down 0.7s 0.2s ease both;
	}

	/* Posts */
	.posts {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.post-card {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: 16px;
		background: #fff;
		border: 1px solid #f1f5f9;
		box-shadow: 0 2px 12px rgba(0,0,0,0.03);
		transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		opacity: 0;
		transform: translateY(12px);
		animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.post-card:hover {
		border-color: #e0e7ff;
		box-shadow: 0 8px 32px rgba(99,102,241,0.08);
		transform: translateY(-3px);
	}

	.post-card-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 20px 24px;
	}

	.post-info {
		min-width: 0;
		flex: 1;
	}

	.post-index {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		color: #c7d2fe;
		letter-spacing: 0.05em;
		margin-bottom: 6px;
	}

	.post-title {
		font-size: 1rem;
		font-weight: 600;
		color: #1a1a2e;
		line-height: 1.4;
		margin: 0 0 4px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.post-desc {
		font-size: 0.82rem;
		color: #94a3b8;
		line-height: 1.5;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
	}

	.post-date {
		font-size: 0.75rem;
		color: #94a3b8;
		white-space: nowrap;
	}

	.post-arrow {
		display: flex;
		align-items: center;
		color: #c7d2fe;
		transition: all 0.3s ease;
	}

	.post-card:hover .post-arrow {
		color: #6366f1;
		transform: translateX(3px);
	}

	/* Animations */
	@keyframes fade-down {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.3; }
	}

	@keyframes rise {
		to { opacity: 1; transform: translateY(0); }
	}

	/* Responsive */
	@media (max-width: 480px) {
		.page {
			padding: 24px 16px 60px;
		}

		.post-card-inner {
			padding: 16px 18px;
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
		}

		.post-meta {
			width: 100%;
			justify-content: space-between;
		}

		.post-title {
			white-space: normal;
		}

		.cursor-glow {
			display: none;
		}
	}
</style>
