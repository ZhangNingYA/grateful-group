---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const accents = ['coral', 'blue', 'green', 'yellow'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={`Reading | ${SITE_TITLE}`}
      description="English texts, studied sentence by sentence."
    />
  </head>

  <body>
    <BlogHeader active="reading" />

    <main>
      <header class="reading-head">
        <div class="reading-copy">
          <p class="eyebrow">Reading / {String(posts.length).padStart(2, '0')} texts</p>
          <h1>Read with <span class="attention-word">attention.<span class="attention-rule" aria-hidden="true"></span></span></h1>
          <p class="lede">English texts, studied sentence by sentence.</p>
        </div>
        <aside class="reading-index" aria-label={`${posts.length} texts in the reading archive`}>
          <div class="reading-index-top">
            <span>Reading archive</span>
            <span>Vol. 01</span>
          </div>
          <strong>{String(posts.length).padStart(2, '0')}</strong>
          <div class="reading-index-bottom">
            <span>English texts</span>
            <span>Close study</span>
          </div>
        </aside>
      </header>

      <section class="article-index" aria-labelledby="latest-heading">
        <div class="section-heading">
          <h2 id="latest-heading">Reading archive</h2>
          <span>Latest first</span>
        </div>

        <div class="post-list">
          {posts.map((post, index) => (
            <article
              class={`post-row accent-${accents[index % accents.length]}`}
              style={`--row-index: ${index}`}
            >
              <a href={`/blog/${post.id}/`}>
                <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div class="post-copy">
                  <div class="post-meta">
                    <FormattedDate date={post.data.pubDate} />
                    {index === 0 && <span class="latest-label">Latest</span>}
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
                <span class="post-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Tend</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f8f9f7;
    --ink: #17201c;
    --muted: #626b66;
    --line: #dfe3e0;
    --coral: #d9654b;
  }

  * { box-sizing: border-box; }

  html { background: var(--paper); }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-atkinson), 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main,
  .site-footer {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .reading-head {
    min-height: 380px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    align-items: stretch;
    gap: 72px;
    padding: 72px 0 54px;
    border-bottom: 1px solid var(--ink);
  }

  .reading-copy {
    max-width: 780px;
    align-self: end;
  }

  .eyebrow,
  .section-heading span,
  .post-meta,
  .reading-index-top,
  .reading-index-bottom {
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 18px 0 24px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .attention-word {
    position: relative;
    display: inline-block;
  }

  .attention-rule {
    position: absolute;
    right: 0.04em;
    bottom: -0.09em;
    left: 0.02em;
    height: 3px;
    background: var(--coral);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    animation: attention-mark 5.6s ease-in-out infinite;
  }

  .lede {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .reading-index {
    min-height: 210px;
    padding-left: 28px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-left: 1px solid var(--line);
  }

  .reading-index-top,
  .reading-index-bottom {
    display: flex;
    justify-content: space-between;
  }

  .reading-index-top {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
  }

  .reading-index strong {
    align-self: center;
    color: #4f78a3;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 4.75rem;
    font-weight: 450;
    line-height: 1;
  }

  .reading-index-bottom {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .article-index { padding: 52px 0 72px; }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 16px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .post-list { border-top: 1px solid var(--ink); }

  .post-row {
    --accent: var(--coral);
    opacity: 0;
    animation: row-arrive 480ms ease-out forwards;
    animation-delay: calc(var(--row-index) * 55ms);
  }
  .post-row.accent-blue { --accent: #4f78a3; }
  .post-row.accent-green { --accent: #4e8068; }
  .post-row.accent-yellow { --accent: #c2942f; }

  .post-row a {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 48px;
    gap: 24px;
    align-items: start;
    min-height: 190px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .post-row a::before {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -16px;
    width: 4px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 180ms ease;
  }

  .post-row a:hover { background: #fff; }
  .post-row a:hover::before { transform: scaleY(1); }

  .post-number {
    color: var(--accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.45rem;
  }

  .post-copy { max-width: 780px; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .latest-label {
    padding-left: 10px;
    border-left: 1px solid var(--line);
    color: var(--accent);
  }

  .post-copy h3 {
    margin: 0 0 10px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: 0;
  }

  .post-copy p {
    display: -webkit-box;
    max-width: 720px;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-arrow {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    justify-self: end;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .post-arrow svg {
    width: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .post-row a:hover .post-arrow {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
    transform: translateX(3px);
  }

  .post-row a:focus-visible {
    outline: 3px solid rgba(217, 101, 75, 0.28);
    outline-offset: 4px;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    padding: 24px 0 36px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer a { color: inherit; }

  @keyframes attention-mark {
    0%, 8% { opacity: 0; transform: scaleX(0); }
    18%, 72% { opacity: 1; transform: scaleX(1); }
    86%, 100% { opacity: 0; transform: scaleX(1); }
  }

  @keyframes row-arrive {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 720px) {
    main,
    .site-footer { width: min(100% - 32px, 1160px); }

    .reading-head {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 54px 0 38px;
    }

    h1 {
      margin: 14px 0 20px;
      font-size: 2.8rem;
      line-height: 1.02;
    }

    .reading-index {
      min-height: 0;
      padding-left: 18px;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 24px;
    }

    .reading-index strong {
      grid-row: 1 / 3;
      font-size: 3.6rem;
    }

    .reading-index-top,
    .reading-index-bottom {
      grid-column: 2;
      padding: 9px 0;
    }

    .article-index { padding: 38px 0 56px; }

    .section-heading span { display: none; }

    .post-row a {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 12px;
      min-height: 0;
      padding: 24px 0;
    }

    .post-arrow { display: none; }
    .post-number { font-size: 1.1rem; }
    .post-copy h3 { font-size: 1.34rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }

    .post-row { opacity: 1; }

    .attention-rule {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
