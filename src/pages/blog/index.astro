---
import BaseHead from '../../components/BaseHead.astro';
import BlogHeader from '../../components/blog/BlogHeader.astro';
import { SITE_TITLE } from '../../consts';

const textCount = 0;

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={`Reading | ${SITE_TITLE}`}
      description="English texts, studied sentence by sentence."
    />
  </head>

  <body>
    <BlogHeader active="reading" />

    <main>
      <header class="reading-head">
        <div class="reading-copy">
          <p class="eyebrow">Reading</p>
          <h1>Read with <span class="attention-word">attention.<span class="attention-rule" aria-hidden="true"></span></span></h1>
          <p class="lede">English texts, studied sentence by sentence.</p>
        </div>
      </header>

      <section class="archive-line" aria-label="Reading archive status">
        <span>Archive</span>
        <span>{String(textCount).padStart(2, '0')} texts</span>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Tend</span>
      <a href="/about/">About</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f8f9f7;
    --ink: #17201c;
    --muted: #626b66;
    --line: #dfe3e0;
    --coral: #d9654b;
  }

  * { box-sizing: border-box; }

  html { background: var(--paper); }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-atkinson), 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main,
  .site-footer {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .reading-head {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: flex-end;
    padding: 68px 0 50px;
    border-bottom: 1px solid var(--ink);
  }

  .reading-head::before {
    position: absolute;
    top: 68px;
    bottom: 50px;
    left: 0;
    width: 1px;
    background: var(--line);
    content: '';
  }

  .reading-copy {
    max-width: 780px;
    padding-left: 32px;
  }

  .eyebrow,
  .archive-line {
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 18px 0 24px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4.5rem;
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .attention-word {
    position: relative;
    display: inline-block;
  }

  .attention-rule {
    position: absolute;
    right: 0.04em;
    bottom: -0.09em;
    left: 0.02em;
    height: 3px;
    background: var(--coral);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    animation: attention-mark 5.6s ease-in-out infinite;
  }

  .lede {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .archive-line {
    display: flex;
    min-height: 104px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 24px 0 56px;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    padding: 24px 0 36px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer a { color: inherit; }

  @keyframes attention-mark {
    0%, 8% { opacity: 0; transform: scaleX(0); }
    18%, 72% { opacity: 1; transform: scaleX(1); }
    86%, 100% { opacity: 0; transform: scaleX(1); }
  }

  @media (max-width: 720px) {
    main,
    .site-footer { width: min(100% - 32px, 1160px); }

    .reading-head {
      min-height: 300px;
      padding: 48px 0 38px;
    }

    .reading-head::before {
      top: 48px;
      bottom: 38px;
    }

    .reading-copy {
      padding-left: 20px;
    }

    h1 {
      margin: 14px 0 20px;
      font-size: 2.8rem;
      line-height: 1.02;
    }

    .archive-line { padding: 20px 0 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition: none !important;
      animation: none !important;
    }

    .attention-rule {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
