---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// 只保留 h2 和 h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <>
    {/* 桌面端侧栏 TOC */}
    <nav class="toc-sidebar" aria-label="目录导航">
      <div class="toc-title">目录</div>
      <ul class="toc-list">
        {tocHeadings.map((heading) => (
          <li class={`toc-item toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} data-toc-link data-slug={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* 移动端浮动按钮 + 面板 */}
    <button class="toc-fab" aria-label="打开目录" data-toc-fab>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="15" y2="12"></line>
        <line x1="3" y1="18" x2="12" y2="18"></line>
      </svg>
    </button>

    <div class="toc-overlay" data-toc-overlay>
      <div class="toc-panel" data-toc-panel>
        <div class="toc-panel-header">
          <span class="toc-panel-title">目录</span>
          <button class="toc-panel-close" data-toc-close aria-label="关闭目录">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <ul class="toc-panel-list">
          {tocHeadings.map((heading) => (
            <li class={`toc-item toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} data-toc-link data-slug={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </>
)}

<style>
  /* ===== 桌面端侧栏 TOC ===== */
  .toc-sidebar {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 0 0 20px;
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }

  .toc-sidebar::-webkit-scrollbar {
    width: 3px;
  }
  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-sidebar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 3px;
  }

  .toc-title {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    margin-bottom: 12px;
    padding-left: 12px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid #f1f5f9;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item a {
    display: block;
    padding: 5px 12px;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #94a3b8;
    text-decoration: none;
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: all 0.15s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-depth-3 a {
    padding-left: 24px;
    font-size: 0.74rem;
  }

  .toc-item a:hover {
    color: #6366f1;
    border-left-color: #c7d2fe;
  }

  :global(.toc-item a.active) {
    color: #6366f1;
    border-left-color: #6366f1;
    font-weight: 500;
    background: rgba(99, 102, 241, 0.04);
  }

  /* ===== 移动端浮动按钮 ===== */
  .toc-fab {
    display: none;
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 200;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #6366f1;
    color: #fff;
    border: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.35);
    transition: all 0.2s ease;
  }

  .toc-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.45);
  }

  .toc-fab:active {
    transform: scale(0.95);
  }

  /* ===== 移动端 Overlay + Panel ===== */
  .toc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  :global(.toc-overlay.open) {
    opacity: 1;
  }

  .toc-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    max-height: 65vh;
    background: #fff;
    border-radius: 20px 20px 0 0;
    padding: 20px 24px 32px;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 -4px 40px rgba(0, 0, 0, 0.1);
  }

  :global(.toc-overlay.open .toc-panel) {
    transform: translateY(0);
  }

  .toc-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
  }

  .toc-panel-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #1e293b;
  }

  .toc-panel-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: #f1f5f9;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .toc-panel-close:hover {
    background: #e2e8f0;
    color: #1e293b;
  }

  .toc-panel-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-panel-list .toc-item a {
    padding: 8px 12px;
    font-size: 0.88rem;
    border-left: none;
    border-radius: 8px;
    white-space: normal;
  }

  .toc-panel-list .toc-depth-3 a {
    padding-left: 28px;
    font-size: 0.82rem;
  }

  .toc-panel-list .toc-item a:hover {
    background: #f8fafc;
  }

  :global(.toc-panel-list .toc-item a.active) {
    background: rgba(99, 102, 241, 0.06);
    color: #6366f1;
    font-weight: 500;
    border-left: none;
  }

  /* ===== 响应式 ===== */
  @media (max-width: 1100px) {
    .toc-sidebar {
      display: none;
    }

    .toc-fab {
      display: flex;
    }

    .toc-overlay {
      display: block;
      pointer-events: none;
    }

    :global(.toc-overlay.open) {
      pointer-events: auto;
    }
  }
</style>

<script>
  // IntersectionObserver: 高亮当前可见标题
  function initTOC() {
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    if (tocLinks.length === 0) return;

    const headingElements: Element[] = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (headingElements.length === 0) return;

    let currentActiveSlug = '';

    function setActive(slug: string) {
      if (slug === currentActiveSlug) return;
      currentActiveSlug = slug;
      tocLinks.forEach((link) => {
        if (link.getAttribute('data-slug') === slug) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        // 找到最上面的可见标题
        const visibleEntries = entries.filter((e) => e.isIntersecting);
        if (visibleEntries.length > 0) {
          // 取 boundingClientRect.top 最小的（最接近顶部的）
          visibleEntries.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          const topEntry = visibleEntries[0];
          setActive(topEntry.target.id);
        } else {
          // 如果没有可见的，找最近的已经滚过去的标题
          const scrollTop = window.scrollY;
          let closestAbove: Element | null = null;
          let closestDist = Infinity;
          headingElements.forEach((el) => {
            const rect = el.getBoundingClientRect();
            const elTop = rect.top + scrollTop;
            const dist = scrollTop - elTop;
            if (dist >= 0 && dist < closestDist) {
              closestDist = dist;
              closestAbove = el;
            }
          });
          if (closestAbove) {
            setActive((closestAbove as HTMLElement).id);
          }
        }
      },
      {
        rootMargin: '-60px 0px -75% 0px',
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));

    // 点击 TOC 链接平滑滚动
    tocLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.getAttribute('data-slug');
        if (!slug) return;
        const target = document.getElementById(slug);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // 关闭移动端面板
          const overlay = document.querySelector('[data-toc-overlay]');
          if (overlay) overlay.classList.remove('open');
        }
      });
    });

    // 移动端 FAB 按钮
    const fab = document.querySelector('[data-toc-fab]');
    const overlay = document.querySelector('[data-toc-overlay]');
    const closeBtn = document.querySelector('[data-toc-close]');

    if (fab && overlay) {
      fab.addEventListener('click', () => {
        overlay.classList.add('open');
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.classList.remove('open');
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          overlay.classList.remove('open');
        });
      }
    }
  }

  // 在页面加载完成后初始化
  document.addEventListener('DOMContentLoaded', initTOC);
  // Astro 的视图转换支持
  document.addEventListener('astro:page-load', initTOC);
</script>
