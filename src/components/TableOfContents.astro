---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{tocHeadings.length > 0 && (
  <>
    <nav class="toc-rail" aria-label="文章目录">
      <p class="toc-title">On this page</p>
      <ol class="toc-list">
        {tocHeadings.map((heading, index) => (
          <li class:list={['toc-item', `toc-depth-${heading.depth}`, { 'is-numeric': /^\d+$/.test(heading.text) }]}>
            <a href={`#${heading.slug}`} data-toc-link data-slug={heading.slug}>
              {!/^\d+$/.test(heading.text) && <span class="toc-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
              <span class="toc-text">{/^\d+$/.test(heading.text) ? `Part ${heading.text}` : heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <button
      class="toc-trigger"
      type="button"
      aria-label="打开文章目录"
      aria-expanded="false"
      aria-controls="toc-mobile-panel"
      title="文章目录"
      data-toc-trigger
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 6h13M8 12h13M8 18h13"></path>
        <circle cx="3.5" cy="6" r=".5"></circle>
        <circle cx="3.5" cy="12" r=".5"></circle>
        <circle cx="3.5" cy="18" r=".5"></circle>
      </svg>
    </button>

    <div class="toc-overlay" data-toc-overlay hidden>
      <div class="toc-panel" id="toc-mobile-panel" role="dialog" aria-modal="true" aria-labelledby="toc-panel-title">
        <header class="toc-panel-header">
          <div>
            <span class="toc-kicker">Navigation</span>
            <h2 id="toc-panel-title">文章目录</h2>
          </div>
          <button class="toc-close" type="button" aria-label="关闭文章目录" title="关闭" data-toc-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
          </button>
        </header>
        <ol class="toc-panel-list">
          {tocHeadings.map((heading, index) => (
            <li class:list={['toc-item', `toc-depth-${heading.depth}`, { 'is-numeric': /^\d+$/.test(heading.text) }]}>
              <a href={`#${heading.slug}`} data-toc-link data-slug={heading.slug}>
                {!/^\d+$/.test(heading.text) && <span class="toc-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
                <span class="toc-text">{/^\d+$/.test(heading.text) ? `Part ${heading.text}` : heading.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </>
)}

<style>
  .toc-rail {
    position: fixed;
    top: 104px;
    left: calc(50% + 598px);
    z-index: 40;
    width: 210px;
    max-height: calc(100vh - 136px);
    overflow-y: auto;
    padding-left: 16px;
    border-left: 1px solid #dfe3e0;
    scrollbar-width: thin;
    scrollbar-color: #c9ceca transparent;
  }

  .toc-title,
  .toc-kicker {
    margin: 0 0 12px;
    color: #7a827d;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .toc-list,
  .toc-panel-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item a {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 6px;
    padding: 7px 8px;
    color: #7a827d;
    font-size: 0.76rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .toc-index {
    color: #a7ada9;
    font-variant-numeric: tabular-nums;
  }

  .toc-item.is-numeric a { grid-template-columns: minmax(0, 1fr); }

  .toc-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-depth-3 a { padding-left: 20px; font-size: 0.72rem; }
  .toc-item a:hover { color: #17201c; background: #eef1ee; }

  :global(.toc-item a.active) {
    color: #b34f39;
    background: #f8e6e1;
    font-weight: 700;
  }

  :global(.toc-item a.active .toc-index) { color: #e06b4f; }

  .toc-trigger {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    display: none;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid #17201c;
    border-radius: 50%;
    background: #17201c;
    color: #fff;
    box-shadow: 0 8px 24px rgba(23, 32, 28, 0.18);
    cursor: pointer;
  }

  .toc-trigger svg,
  .toc-close svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .toc-overlay[hidden] { display: none; }

  .toc-overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    align-items: end;
    background: rgba(23, 32, 28, 0.5);
    padding: 16px;
  }

  .toc-panel {
    width: min(620px, 100%);
    max-height: min(70vh, 620px);
    margin: 0 auto;
    overflow-y: auto;
    border-radius: 8px;
    background: #f8f9f7;
    box-shadow: 0 18px 60px rgba(23, 32, 28, 0.25);
  }

  .toc-panel-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 20px 14px;
    border-bottom: 1px solid #dfe3e0;
    background: #f8f9f7;
  }

  .toc-kicker { display: block; margin-bottom: 3px; }
  .toc-panel-header h2 { margin: 0; color: #17201c; font-size: 1.1rem; }

  .toc-close {
    display: grid;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid #d7dcd8;
    border-radius: 50%;
    background: #fff;
    color: #4f5953;
    cursor: pointer;
  }

  .toc-panel-list { padding: 10px; }
  .toc-panel-list .toc-item a { padding: 11px 10px; font-size: 0.9rem; }
  .toc-panel-list .toc-depth-3 a { padding-left: 30px; font-size: 0.84rem; }
  .toc-panel-list .toc-text { white-space: normal; }

  :is(.toc-item a, .toc-trigger, .toc-close):focus-visible {
    outline: 3px solid rgba(224, 107, 79, 0.35);
    outline-offset: 3px;
  }

  @media (max-width: 1500px) {
    .toc-rail { display: none; }
    .toc-trigger { display: grid; }
  }

  @media (max-width: 720px) {
    .toc-overlay { padding: 8px; }
    .toc-panel { max-height: 76vh; }
    .toc-trigger { right: 16px; bottom: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-item a { transition: none; }
  }
</style>

<script>
  function initTOC() {
    const root = document.querySelector<HTMLElement>('[data-toc-trigger]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const headings = Array.from(new Set(
      tocLinks
        .map((link) => document.getElementById(link.dataset.slug ?? ''))
        .filter((heading): heading is HTMLElement => Boolean(heading)),
    ));
    const overlay = document.querySelector<HTMLElement>('[data-toc-overlay]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-toc-close]');

    const setActive = (slug: string) => {
      tocLinks.forEach((link) => link.classList.toggle('active', link.dataset.slug === slug));
    };

    if (headings.length > 0) {
      const observer = new IntersectionObserver(() => {
        const offset = 120;
        let current = headings[0];
        headings.forEach((heading) => {
          if (heading.getBoundingClientRect().top <= offset) current = heading;
        });
        setActive(current.id);
      }, { rootMargin: '-80px 0px -70% 0px' });
      headings.forEach((heading) => observer.observe(heading));
      setActive(headings[0].id);
    }

    const closePanel = () => {
      if (!overlay || overlay.hidden) return;
      overlay.hidden = true;
      root.setAttribute('aria-expanded', 'false');
      document.body.style.removeProperty('overflow');
      root.focus();
    };

    const openPanel = () => {
      if (!overlay) return;
      overlay.hidden = false;
      root.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeButton?.focus();
    };

    root.addEventListener('click', openPanel);
    closeButton?.addEventListener('click', closePanel);
    overlay?.addEventListener('click', (event) => {
      if (event.target === overlay) closePanel();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePanel();
    });

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const target = document.getElementById(link.dataset.slug ?? '');
        if (!target) return;
        event.preventDefault();
        closePanel();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${target.id}`);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTOC);
  document.addEventListener('astro:page-load', initTOC);
</script>
