---
interface Props {
  accent?: string;
  glow?: string;
}

const { accent = '#d9654b', glow = 'rgba(217, 101, 75, 0.22)' } = Astro.props;
---

<span
  class="tend-wordmark"
  aria-hidden="true"
  style={`--tend-accent: ${accent}; --tend-glow: ${glow};`}
>
  <span class="tend-symbol">
    <svg viewBox="0 0 24 24" role="presentation">
      <path d="M3.5 17.25c4.4 0 5.35-2.9 7.05-6.05C12.45 7.7 15 6 19.2 6" />
      <circle cx="21" cy="6" r="1.55" />
    </svg>
  </span>
  <span class="tend-text">Tend</span>
  <span class="care-line"></span>
</span>

<style>
  .tend-wordmark {
    position: relative;
    display: inline-flex;
    width: max-content;
    height: 26px;
    align-items: center;
    gap: 7px;
    color: currentColor;
    font: inherit;
    line-height: 1;
    white-space: nowrap;
    isolation: isolate;
  }

  .tend-text {
    position: relative;
    z-index: 1;
    display: inline-flex;
    height: 24px;
    align-items: center;
    font: inherit;
    line-height: 24px;
  }

  .tend-symbol {
    display: inline-grid;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    place-items: center;
  }

  .tend-symbol svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tend-symbol path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2.15;
  }

  .tend-symbol circle {
    fill: var(--tend-accent);
    filter: drop-shadow(0 0 3px var(--tend-glow));
    transform-box: fill-box;
    transform-origin: center;
    animation: care-mark-cycle 9s ease-in-out infinite;
  }

  .care-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    height: 1.5px;
    border-radius: 99px;
    background: var(--tend-accent);
    box-shadow: 0 0 8px var(--tend-glow);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    animation: care-line-cycle 9s ease-in-out infinite;
  }

  @keyframes care-line-cycle {
    0%, 20%, 100% { opacity: 0; transform: scaleX(0); }
    23% { opacity: 0.72; transform: scaleX(0.04); }
    42%, 52% { opacity: 0.72; transform: scaleX(1); }
    60% { opacity: 0; transform: scaleX(1); }
  }

  @keyframes care-mark-cycle {
    0%, 35%, 100% { opacity: 0.7; transform: scale(0.86); }
    43% { opacity: 1; transform: scale(1.12); }
    51% { opacity: 0.82; transform: scale(0.94); }
    59% { opacity: 1; transform: scale(1.06); }
    69%, 90% { opacity: 0.74; transform: scale(0.9); }
  }

  @keyframes care-line-hover {
    0% { opacity: 0; transform: scaleX(0); }
    12% { opacity: 0.8; }
    72% { opacity: 0.8; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(1); }
  }

  @keyframes care-mark-hover {
    0%, 45%, 100% { opacity: 0.74; transform: scale(0.9); }
    72% { opacity: 1; transform: scale(1.16); }
  }

  @media (hover: hover) {
    :global(.brand:hover) .care-line {
      animation: care-line-hover 1.5s ease-in-out both;
    }

    :global(.brand:hover) .tend-symbol circle {
      animation: care-mark-hover 1.5s ease-in-out both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .care-line,
    .tend-symbol circle {
      animation: none;
    }

    .care-line {
      opacity: 0.55;
      transform: scaleX(0.24);
    }

    .tend-symbol circle {
      opacity: 0.9;
      transform: scale(0.94);
    }
  }
</style>
