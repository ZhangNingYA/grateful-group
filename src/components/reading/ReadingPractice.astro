---
import SentenceNote from './SentenceNote.astro';
import ReadingQuestions from './ReadingQuestions.astro';
import ReadingTimer from './ReadingTimer.astro';
import type { CloseReading, InlineGlossary } from '../../types/closeReading';
import type { ReadingQuestion } from '../../types/readingQuestion';

interface Passage {
  title: string;
  sentences: readonly string[];
  questions?: readonly ReadingQuestion[];
}

interface MatchingParagraph {
  label: string;
  sentences: readonly string[];
}

interface Props {
  cloze: Passage;
  matching: {
    title: string;
    paragraphs: readonly MatchingParagraph[];
  };
  passages: readonly Passage[];
  closeReadings?: Readonly<Record<string, CloseReading>>;
  inlineGlossary?: InlineGlossary;
  experience?: 'blog' | 'game';
}

const { cloze, matching, passages, closeReadings, inlineGlossary, experience = 'blog' } = Astro.props;
const countWords = (sentences: readonly string[]) => sentences.join(' ').match(
  /[A-Za-z]+(?:['’][A-Za-z]+)?/g,
)?.length ?? 0;
const noteNumber = (prefix: string, index: number) =>
  `${prefix}${String(index + 1).padStart(2, '0')}`;
const sharedGlossaryPhrases = inlineGlossary
  ? [
      ...(inlineGlossary.phrases ?? []),
      ...Object.values(closeReadings ?? {})
        .flatMap((item) => item.vocabulary)
        .filter((item) => (
          item.term.match(/(?<![A-Za-z0-9])[A-Za-z]+(?:['’][A-Za-z]+)?(?![A-Za-z0-9])/g)?.length ?? 0
        ) > 1),
    ]
  : [];
---

<h2 id="word-bank-cloze">Word Bank Cloze</h2>

<h3>{cloze.title}</h3>

{experience === 'blog' && (
  <ReadingTimer timerId="cloze" label={cloze.title} wordCount={countWords(cloze.sentences)} />
)}

{cloze.sentences.map((sentence, index) => (
  <SentenceNote
    number={noteNumber('C', index)}
    sentence={sentence}
    closeReading={closeReadings?.[noteNumber('C', index)]}
    {inlineGlossary}
    {sharedGlossaryPhrases}
    {experience}
  />
))}

<h2 id="paragraph-matching">Paragraph Matching</h2>

<h3>{matching.title}</h3>

{experience === 'blog' && (
  <ReadingTimer
    timerId="matching"
    label={matching.title}
    wordCount={countWords(matching.paragraphs.flatMap((paragraph) => paragraph.sentences))}
  />
)}

{matching.paragraphs.map((paragraph) => (
  <>
    <h3>Paragraph {paragraph.label}</h3>
    {paragraph.sentences.map((sentence, index) => (
      <SentenceNote
        number={noteNumber(`M-${paragraph.label}`, index)}
        {sentence}
        closeReading={closeReadings?.[noteNumber(`M-${paragraph.label}`, index)]}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    ))}
  </>
))}

<h2 id="reading-passages">Reading Passages</h2>

{passages.map((passage, passageIndex) => (
  <>
    <h3>{passage.title}</h3>
    {experience === 'blog' && (
      <ReadingTimer
        timerId={`passage-${passageIndex + 1}`}
        label={passage.title}
        wordCount={countWords(passage.sentences)}
      />
    )}
    {passage.sentences.map((sentence, sentenceIndex) => (
      <SentenceNote
        number={noteNumber(`R${passageIndex + 1}-`, sentenceIndex)}
        {sentence}
        closeReading={closeReadings?.[noteNumber(`R${passageIndex + 1}-`, sentenceIndex)]}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    ))}
    {passage.questions && passage.questions.length > 0 && (
      <ReadingQuestions
        questions={passage.questions}
        {inlineGlossary}
        {sharedGlossaryPhrases}
        {experience}
      />
    )}
  </>
))}
