---
import { Check, Pause, Play, RotateCcw, Trash2 } from 'lucide-astro';

interface Props {
  timerId: string;
  label: string;
  wordCount?: number;
}

const { timerId, label, wordCount: providedWordCount } = Astro.props;
const initialWordCount = typeof providedWordCount === 'number' && Number.isFinite(providedWordCount)
  ? Math.max(0, providedWordCount)
  : null;
const recommendationSeconds = (wordCount: number, wordsPerMinute: number) => Math.max(
  30,
  Math.ceil((wordCount / wordsPerMinute) * 4) * 15,
);
const formatGuideDuration = (seconds: number) => {
  const minutes = Math.floor(seconds / 60);
  const remainder = seconds % 60;
  return `${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`;
};
const nativeGuideInitial = initialWordCount === null
  ? '—'
  : formatGuideDuration(recommendationSeconds(initialWordCount, 200));
const learnerGuideInitial = initialWordCount === null
  ? '—'
  : formatGuideDuration(recommendationSeconds(initialWordCount, 100));
const initialDifficultyScore = 3;
const sectionName = timerId === 'cloze'
  ? 'Word Bank Cloze'
  : timerId === 'matching'
    ? 'Paragraph Matching'
    : timerId === 'passage-1'
      ? 'Reading Passage 1'
      : timerId === 'passage-2'
        ? 'Reading Passage 2'
        : label;
---

<section
  class="reading-timer"
  data-reading-timer
  data-timer-id={timerId}
  data-timer-label={label}
  data-timer-word-count-provided={providedWordCount}
  data-timer-state="idle"
  aria-label={`${label} 阅读计时器`}
>
  <div class="reading-timer-head">
    <div>
      <span class="reading-timer-kicker">Reading timer</span>
      <strong>{label}</strong>
    </div>
    <span class="reading-timer-word-count"><b data-timer-word-count>{initialWordCount ?? '—'}</b> words</span>
  </div>

  <div class="reading-timer-guides" aria-label="推荐阅读时间">
    <div>
      <span>难度评分</span>
      <strong data-timer-difficulty>{initialDifficultyScore.toFixed(1)} / 5</strong>
      <small>词汇与句法估算</small>
    </div>
    <div>
      <span>美国成年人推荐用时</span>
      <strong data-timer-native-guide>{nativeGuideInitial}</strong>
      <small>通读理解参考</small>
    </div>
    <div>
      <span>普通学习者推荐用时</span>
      <strong data-timer-learner-guide>{learnerGuideInitial}</strong>
      <small>通读理解参考</small>
    </div>
  </div>
  <p class="reading-timer-method">推荐用时会结合篇幅、平均句长和长词比例估算，用于首次通读，不是官方考试限时。</p>

  <div class="reading-timer-main">
    <div class="reading-timer-clock">
      <span>本次用时</span>
      <time datetime="PT0S" data-timer-display aria-live="off">00:00</time>
      <span class="reading-timer-status" data-timer-status aria-live="polite">
        <i aria-hidden="true"></i>准备开始
      </span>
    </div>

    <div class="reading-timer-actions">
      <button class="timer-primary" type="button" data-timer-action="toggle" aria-pressed="false">
        <Play class="timer-play-icon" size={16} stroke-width={2} aria-hidden="true" />
        <Pause class="timer-pause-icon" size={16} stroke-width={2} aria-hidden="true" />
        <span data-timer-toggle-label>开始</span>
      </button>
      <button type="button" data-timer-action="finish" disabled>
        <Check size={16} stroke-width={2} aria-hidden="true" />
        完成
      </button>
      <button type="button" data-timer-action="restart">
        <RotateCcw size={15} stroke-width={2} aria-hidden="true" />
        重新开始
      </button>
      <button class="timer-clear" type="button" data-timer-action="clear">
        <Trash2 size={15} stroke-width={2} aria-hidden="true" />
        清空
      </button>
    </div>
  </div>

  <div class="reading-timer-progress" aria-label="推荐阅读进度">
    <div class="reading-timer-progress-row">
      <span class="reading-timer-progress-label native">美</span>
      <span class="reading-timer-progress-track"><i data-timer-native-progress></i></span>
    </div>
    <div class="reading-timer-progress-row">
      <span class="reading-timer-progress-label learner">学</span>
      <span class="reading-timer-progress-track"><i data-timer-learner-progress></i></span>
    </div>
  </div>

  <div class="reading-timer-hint" data-timer-message>绿色代表美国成年人推荐速度，红色代表普通学习者推荐速度。</div>

  <div class="reading-timer-floating" data-timer-floating aria-hidden="true">
    <span class="reading-timer-floating-pulse" aria-hidden="true"></span>
    <span class="reading-timer-floating-label" data-floating-label>{sectionName}</span>
    <div class="reading-timer-floating-progress" aria-label="推荐阅读进度">
      <span class="reading-timer-floating-progress-line">
        <b class="native">美</b>
        <span class="reading-timer-floating-track native"><i data-floating-native-progress></i></span>
      </span>
      <span class="reading-timer-floating-progress-line">
        <b class="learner">学</b>
        <span class="reading-timer-floating-track learner"><i data-floating-learner-progress></i></span>
      </span>
    </div>
    <button type="button" data-floating-action="toggle" aria-label="暂停或继续计时" title="暂停或继续">
      <Play class="floating-play-icon" size={14} stroke-width={2.2} aria-hidden="true" />
      <Pause class="floating-pause-icon" size={14} stroke-width={2.2} aria-hidden="true" />
    </button>
    <button type="button" data-floating-action="restart" aria-label="重新开始" title="重新开始">
      <RotateCcw size={14} stroke-width={2.2} aria-hidden="true" />
    </button>
    <button type="button" data-floating-action="finish" aria-label="完成" title="完成">
      <Check size={14} stroke-width={2.2} aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  type TimerController = {
    root: HTMLElement;
    pause: (message?: string) => void;
  };

  const timerControllers: TimerController[] = [];
  const timerRoots = Array.from(
    document.querySelectorAll<HTMLElement>('[data-reading-timer]:not([data-timer-ready])'),
  );

  const formatDuration = (milliseconds: number) => {
    const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    return hours > 0
      ? `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  };

  const recommendationSeconds = (wordCount: number, wordsPerMinute: number) => Math.max(
    30,
    Math.ceil((wordCount / wordsPerMinute) * 4) * 15,
  );

  const timerSentences = (root: HTMLElement) => {
    const sentences: string[] = [];
    let sibling = root.nextElementSibling;
    while (sibling && !sibling.matches('[data-reading-timer], h2')) {
      const notes = [
        ...(sibling.matches('[data-sentence-note]') ? [sibling] : []),
        ...Array.from(sibling.querySelectorAll('[data-sentence-note]')),
      ] as HTMLElement[];
      notes.forEach((note) => {
        if (note.dataset.noteNumber?.startsWith('Q')) return;
        const sentence = note.querySelector<HTMLElement>('.sentence-original .sentence-text')?.textContent
          ?? note.querySelector<HTMLElement>('.sentence-original')?.textContent;
        if (sentence) sentences.push(sentence);
      });
      sibling = sibling.nextElementSibling;
    }
    return sentences;
  };

  const countWords = (sentences: string[]) => sentences.join(' ').match(
    /[A-Za-z]+(?:['’][A-Za-z]+)?/g,
  )?.length ?? 0;

  const estimateDifficulty = (sentences: string[], wordCount: number) => {
    if (wordCount <= 0 || sentences.length === 0) return 3;
    const words = sentences.join(' ').match(/[A-Za-z]+(?:['’][A-Za-z]+)?/g) ?? [];
    const averageSentenceLength = wordCount / sentences.length;
    const longWordRatio = words.filter((word) => word.length >= 8).length / Math.max(1, words.length);
    const joined = sentences.join(' ');
    const clauseMarkers = joined.match(/\b(?:although|because|while|which|that|when|where|who|whose|if|unless|since|as|even|than)\b/gi)?.length ?? 0;
    const sentenceLoad = Math.min(1, Math.max(0, (averageSentenceLength - 12) / 22));
    const vocabularyLoad = Math.min(1, Math.max(0, (longWordRatio - 0.08) / 0.22));
    const clauseLoad = Math.min(1, clauseMarkers / Math.max(1, sentences.length * 1.2));
    const score = 2.4 + sentenceLoad * 0.9 + vocabularyLoad * 1.1 + clauseLoad * 0.6;
    return Math.round(Math.min(5, Math.max(1, score)) * 10) / 10;
  };

  const timerWordCount = (root: HTMLElement) => {
    return countWords(timerSentences(root));
  };

  const hideFloatingBars = () => {
    document.querySelectorAll<HTMLElement>('[data-timer-floating]').forEach((bar) => {
      bar.setAttribute('aria-hidden', 'true');
    });
  };

  timerRoots.forEach((root) => {
    root.dataset.timerReady = 'true';
    const timerId = root.dataset.timerId ?? 'reading';
    const sentences = timerSentences(root);
    const providedWordCount = Number(root.dataset.timerWordCountProvided);
    const wordCount = Number.isFinite(providedWordCount)
      ? Math.max(0, providedWordCount)
      : timerWordCount(root);
    const difficultyScore = estimateDifficulty(sentences, wordCount);
    const difficultyFactor = 1 + (difficultyScore - 3) * 0.1;
    // These are practical CET-6 "first pass" benchmarks rather than
    // speed-reading targets: a fluent native reader around 200 WPM and a
    // typical Chinese English learner around 100 WPM.  Keeping the result
    // rounded to 15-second increments makes the guide easy to use while
    // preserving a 30-second floor for very short cloze passages.
    const nativeGuideMs = recommendationSeconds(wordCount, 200 / difficultyFactor) * 1000;
    const learnerGuideMs = recommendationSeconds(wordCount, 100 / difficultyFactor) * 1000;

    const wordCountNode = root.querySelector<HTMLElement>('[data-timer-word-count]');
    const difficultyNode = root.querySelector<HTMLElement>('[data-timer-difficulty]');
    const nativeGuideNode = root.querySelector<HTMLElement>('[data-timer-native-guide]');
    const learnerGuideNode = root.querySelector<HTMLElement>('[data-timer-learner-guide]');
    const nativeProgressNode = root.querySelector<HTMLElement>('[data-timer-native-progress]');
    const learnerProgressNode = root.querySelector<HTMLElement>('[data-timer-learner-progress]');
    const displayNode = root.querySelector<HTMLTimeElement>('[data-timer-display]');
    const statusNode = root.querySelector<HTMLElement>('[data-timer-status]');
    const toggleButton = root.querySelector<HTMLButtonElement>('[data-timer-action="toggle"]');
    const toggleLabel = root.querySelector<HTMLElement>('[data-timer-toggle-label]');
    const finishButton = root.querySelector<HTMLButtonElement>('[data-timer-action="finish"]');
    const restartButton = root.querySelector<HTMLButtonElement>('[data-timer-action="restart"]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-timer-action="clear"]');
    const messageNode = root.querySelector<HTMLElement>('[data-timer-message]');
    const floatingBar = root.querySelector<HTMLElement>('[data-timer-floating]');
    const floatingNativeProgress = root.querySelector<HTMLElement>('[data-floating-native-progress]');
    const floatingLearnerProgress = root.querySelector<HTMLElement>('[data-floating-learner-progress]');
    const floatingToggle = root.querySelector<HTMLButtonElement>('[data-floating-action="toggle"]');
    const floatingFinish = root.querySelector<HTMLButtonElement>('[data-floating-action="finish"]');
    const floatingRestart = root.querySelector<HTMLButtonElement>('[data-floating-action="restart"]');

    if (
      !displayNode || !statusNode || !toggleButton || !toggleLabel || !finishButton
      || !restartButton || !clearButton || !nativeProgressNode || !learnerProgressNode
      || !messageNode || !floatingBar || !floatingNativeProgress || !floatingLearnerProgress
      || !floatingToggle || !floatingFinish || !floatingRestart
    ) return;

    if (wordCountNode) wordCountNode.textContent = String(wordCount);
    if (difficultyNode) difficultyNode.textContent = `${difficultyScore.toFixed(1)} / 5`;
    if (nativeGuideNode) nativeGuideNode.textContent = formatDuration(nativeGuideMs);
    if (learnerGuideNode) learnerGuideNode.textContent = formatDuration(learnerGuideMs);

    let elapsedMs = 0;
    let running = false;
    let startedAt = 0;
    let intervalId = 0;
    let completed = false;
    let statusMessage = '准备开始';

    const currentElapsed = () => elapsedMs + (running ? Date.now() - startedAt : 0);

    const render = () => {
      const current = currentElapsed();
      const nativeProgress = nativeGuideMs > 0 ? Math.min(1, current / nativeGuideMs) : 0;
      const learnerProgress = learnerGuideMs > 0 ? Math.min(1, current / learnerGuideMs) : 0;
      displayNode.textContent = formatDuration(current);
      displayNode.dateTime = `PT${Math.floor(current / 1000)}S`;
      statusNode.lastChild!.textContent = statusMessage;
      root.dataset.timerState = running ? 'running' : current > 0 ? 'paused' : 'idle';
      toggleButton.setAttribute('aria-pressed', String(running));
      toggleLabel.textContent = running ? '暂停' : current > 0 ? '继续' : '开始';
      finishButton.disabled = current < 1000 || completed;
      nativeProgressNode.style.width = `${nativeProgress * 100}%`;
      learnerProgressNode.style.width = `${learnerProgress * 100}%`;
      root.toggleAttribute('data-over-native-guide', current > nativeGuideMs);
      root.toggleAttribute('data-over-learner-guide', current > learnerGuideMs);

      floatingNativeProgress.style.width = `${nativeProgress * 100}%`;
      floatingLearnerProgress.style.width = `${learnerProgress * 100}%`;
      floatingToggle.setAttribute('aria-label', running ? '暂停计时' : '继续计时');
      floatingToggle.title = running ? '暂停' : '继续';
      floatingFinish.disabled = finishButton.disabled;
      floatingBar.toggleAttribute('data-floating-over-native-guide', current > nativeGuideMs);
      floatingBar.toggleAttribute('data-floating-over-learner-guide', current > learnerGuideMs);

      if (completed) {
        messageNode.textContent = '本次已完成，可点击“重新开始”再练一次。';
      } else if (current >= learnerGuideMs) {
        messageNode.textContent = '已超过普通学习者推荐用时，先完成理解，再逐步提速。';
      } else if (current >= nativeGuideMs) {
        messageNode.textContent = '已达到美国成年人推荐用时，继续读完即可。';
      } else {
        messageNode.textContent = '绿色代表美国成年人速度，红色代表普通学习者速度。';
      }
    };

    const stopInterval = () => {
      if (intervalId) window.clearInterval(intervalId);
      intervalId = 0;
    };

    const startInterval = () => {
      stopInterval();
      intervalId = window.setInterval(render, 250);
    };

    const pause = (message = '已暂停') => {
      if (running) {
        elapsedMs = currentElapsed();
        running = false;
        startedAt = 0;
      }
      statusMessage = message;
      stopInterval();
      render();
    };

    const controller = { root, pause };
    timerControllers.push(controller);

    const start = () => {
      hideFloatingBars();
      timerControllers.forEach((item) => {
        if (item !== controller) item.pause('已自动暂停');
      });
      running = true;
      startedAt = Date.now();
      completed = false;
      statusMessage = '计时中';
      startInterval();
      render();
      floatingBar.setAttribute('aria-hidden', 'false');
    };

    toggleButton.addEventListener('click', () => {
      if (running) pause();
      else start();
    });

    floatingToggle.addEventListener('click', () => {
      if (running) pause();
      else start();
    });

    floatingFinish.addEventListener('click', () => finishButton.click());
    floatingRestart.addEventListener('click', () => restartButton.click());

    finishButton.addEventListener('click', () => {
      const finishedElapsed = currentElapsed();
      if (finishedElapsed < 1000) return;
      if (running) {
        elapsedMs = finishedElapsed;
        running = false;
        startedAt = 0;
      }
      completed = true;
      statusMessage = '已完成';
      stopInterval();
      render();
      floatingBar.setAttribute('aria-hidden', 'true');
    });

    restartButton.addEventListener('click', () => {
      elapsedMs = 0;
      running = false;
      startedAt = 0;
      completed = false;
      statusMessage = '准备重新开始';
      start();
    });

    clearButton.addEventListener('click', () => {
      elapsedMs = 0;
      running = false;
      startedAt = 0;
      completed = false;
      statusMessage = '已清空';
      stopInterval();
      render();
      floatingBar.setAttribute('aria-hidden', 'true');
    });

    render();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) timerControllers.forEach((timer) => timer.pause('离开页面，已自动暂停'));
  });
</script>

<style>
  .reading-timer {
    --timer-accent: #2f6f58;
    --timer-soft: #edf5f0;
    margin: 18px 0 30px;
    overflow: hidden;
    border: 1px solid #d8dfda;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 12px 36px rgba(31, 47, 39, 0.055);
  }

  .reading-timer-head {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 15px;
    border-bottom: 1px solid #e7ebe8;
  }

  .reading-timer-head > div {
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .reading-timer-kicker {
    color: #768079;
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .reading-timer-head strong {
    overflow: hidden;
    color: #243129;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading-timer-word-count {
    flex: 0 0 auto;
    padding: 6px 9px;
    border-radius: 999px;
    color: #657069;
    background: #f1f4f2;
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .reading-timer-word-count b { color: #2c3931; }

  .reading-timer-guides {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid #e4e9e5;
    background: #e4e9e5;
  }

  .reading-timer-guides > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3px 12px;
    padding: 12px 20px;
    background: #f8faf8;
  }

  .reading-timer-guides span {
    align-self: end;
    color: #68736c;
    font-size: 0.7rem;
  }

  .reading-timer-guides strong {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    color: #27342c;
    font-size: 1.08rem;
    font-variant-numeric: tabular-nums;
    font-weight: 680;
  }

  .reading-timer-guides small {
    color: #98a099;
    font-size: 0.6rem;
  }

  .reading-timer-method {
    margin: 0;
    padding: 8px 20px 0;
    color: #89938c;
    font-size: 0.62rem;
    line-height: 1.5;
  }

  .reading-timer-main {
    display: grid;
    grid-template-columns: minmax(170px, 0.72fr) minmax(300px, 1.28fr);
    gap: 24px;
    align-items: center;
    padding: 20px;
  }

  .reading-timer-clock {
    display: grid;
    gap: 4px;
  }

  .reading-timer-clock > span:first-child {
    color: #7c857f;
    font-size: 0.65rem;
    font-weight: 680;
  }

  .reading-timer-clock time {
    color: #17231c;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .reading-timer-status {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 5px;
    color: #78827c;
    font-size: 0.65rem;
  }

  .reading-timer-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #aeb6b1;
  }

  [data-timer-state='running'] .reading-timer-status { color: var(--timer-accent); }
  [data-timer-state='running'] .reading-timer-status i {
    background: #3c9b72;
    box-shadow: 0 0 0 4px rgba(60, 155, 114, 0.12);
  }

  .reading-timer-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .reading-timer-actions button {
    min-height: 38px;
    display: inline-flex;
    gap: 7px;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid #dce2de;
    border-radius: 9px;
    color: #445149;
    background: #fafbfa;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 680;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .reading-timer-actions button:hover:not(:disabled) {
    border-color: #b9c5bd;
    background: #f1f5f2;
    transform: translateY(-1px);
  }

  .reading-timer-actions button:focus-visible {
    outline: 3px solid rgba(47, 111, 88, 0.16);
    outline-offset: 2px;
  }

  .reading-timer-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .reading-timer-actions .timer-primary {
    border-color: var(--timer-accent);
    color: #fff;
    background: var(--timer-accent);
  }

  .reading-timer-actions .timer-primary:hover:not(:disabled) {
    border-color: #255d49;
    color: #fff;
    background: #255d49;
  }

  .reading-timer-actions .timer-clear { color: #8b5148; }
  .timer-pause-icon { display: none; }
  [data-timer-state='running'] .timer-play-icon { display: none; }
  [data-timer-state='running'] .timer-pause-icon { display: block; }

  .reading-timer-progress {
    display: grid;
    gap: 6px;
    padding: 0 20px 14px;
  }

  .reading-timer-progress-row {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
  }

  .reading-timer-progress-label {
    font-size: 0.62rem;
    font-weight: 760;
    text-align: center;
  }

  .reading-timer-progress-label.native { color: #2f805c; }
  .reading-timer-progress-label.learner { color: #bd665e; }

  .reading-timer-progress-track {
    display: block;
    height: 5px;
    overflow: hidden;
    border-radius: 99px;
    background: #e9eeeb;
  }

  .reading-timer-progress-track i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    transition: width 250ms linear;
