---
import { Check, Pause, Play, RotateCcw, Trash2 } from 'lucide-astro';

interface Props {
  timerId: string;
  label: string;
}

const { timerId, label } = Astro.props;
---

<section
  class="reading-timer"
  data-reading-timer
  data-timer-id={timerId}
  data-timer-label={label}
  data-timer-state="idle"
  aria-label={`${label} 阅读计时器`}
>
  <div class="reading-timer-head">
    <div>
      <span class="reading-timer-kicker">Reading timer</span>
      <strong>{label}</strong>
    </div>
    <span class="reading-timer-word-count"><b data-timer-word-count>—</b> words</span>
  </div>

  <div class="reading-timer-guides" aria-label="推荐阅读时间">
    <div>
      <span>美国成年人参考</span>
      <strong data-timer-native-guide>—</strong>
      <small>约 250 WPM</small>
    </div>
    <div>
      <span>普通学习者建议</span>
      <strong data-timer-learner-guide>—</strong>
      <small>约 120 WPM</small>
    </div>
  </div>

  <div class="reading-timer-main">
    <div class="reading-timer-clock">
      <span>本次用时</span>
      <time datetime="PT0S" data-timer-display aria-live="off">00:00</time>
      <span class="reading-timer-status" data-timer-status aria-live="polite">
        <i aria-hidden="true"></i>准备开始
      </span>
    </div>

    <div class="reading-timer-actions">
      <button class="timer-primary" type="button" data-timer-action="toggle" aria-pressed="false">
        <Play class="timer-play-icon" size={16} stroke-width={2} aria-hidden="true" />
        <Pause class="timer-pause-icon" size={16} stroke-width={2} aria-hidden="true" />
        <span data-timer-toggle-label>开始</span>
      </button>
      <button type="button" data-timer-action="finish" disabled>
        <Check size={16} stroke-width={2} aria-hidden="true" />
        完成并记录
      </button>
      <button type="button" data-timer-action="restart">
        <RotateCcw size={15} stroke-width={2} aria-hidden="true" />
        重新开始
      </button>
      <button class="timer-clear" type="button" data-timer-action="clear">
        <Trash2 size={15} stroke-width={2} aria-hidden="true" />
        清空
      </button>
    </div>
  </div>

  <div class="reading-timer-progress" aria-hidden="true">
    <span data-timer-progress></span>
  </div>

  <div class="reading-timer-stats" data-timer-stats>
    <span><small>最近</small><strong data-timer-last>—</strong></span>
    <span><small>最快</small><strong data-timer-best>—</strong></span>
    <span><small>已记录</small><strong><b data-timer-count>0</b> 次</strong></span>
    <p data-timer-message>完成后会保存在这台设备上，方便比较每次阅读速度。</p>
  </div>

  <div class="reading-timer-floating" data-timer-floating aria-hidden="true">
    <span class="reading-timer-floating-pulse" aria-hidden="true"></span>
    <span class="reading-timer-floating-label" data-floating-label>{label}</span>
    <time data-floating-display datetime="PT0S">00:00</time>
    <span class="reading-timer-floating-state" data-floating-state>准备开始</span>
    <button type="button" data-floating-action="toggle" aria-label="暂停或继续计时">
      <Play class="floating-play-icon" size={14} stroke-width={2.2} aria-hidden="true" />
      <Pause class="floating-pause-icon" size={14} stroke-width={2.2} aria-hidden="true" />
    </button>
    <button type="button" data-floating-action="finish" aria-label="完成并记录" title="完成并记录">
      <Check size={14} stroke-width={2.2} aria-hidden="true" />
    </button>
    <button type="button" data-floating-action="expand" aria-label="展开对应计时卡" title="展开对应计时卡">↗</button>
  </div>
</section>

<script>
  type StoredTimer = {
    elapsedMs?: number;
    running?: boolean;
    startedAt?: number;
    records?: number[];
    recordedElapsedMs?: number;
  };

  type TimerController = {
    root: HTMLElement;
    pause: (message?: string) => void;
  };

  const timerControllers: TimerController[] = [];
  const timerRoots = Array.from(
    document.querySelectorAll<HTMLElement>('[data-reading-timer]:not([data-timer-ready])'),
  );

  const formatDuration = (milliseconds: number) => {
    const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    return hours > 0
      ? `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
      : `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  };

  const recommendationSeconds = (wordCount: number, wordsPerMinute: number) => Math.max(
    30,
    Math.ceil((wordCount / wordsPerMinute) * 4) * 15,
  );

  const timerWordCount = (root: HTMLElement) => {
    const sentences: string[] = [];
    let sibling = root.nextElementSibling;
    while (sibling && !sibling.matches('[data-reading-timer], h2')) {
      const notes = [
        ...(sibling.matches('[data-sentence-note]') ? [sibling] : []),
        ...Array.from(sibling.querySelectorAll('[data-sentence-note]')),
      ] as HTMLElement[];
      notes.forEach((note) => {
        if (note.dataset.noteNumber?.startsWith('Q')) return;
        const sentence = note.querySelector<HTMLElement>('.sentence-original .sentence-text')?.textContent
          ?? note.querySelector<HTMLElement>('.sentence-original')?.textContent;
        if (sentence) sentences.push(sentence);
      });
      sibling = sibling.nextElementSibling;
    }
    return sentences.join(' ').match(/[A-Za-z]+(?:['’][A-Za-z]+)?/g)?.length ?? 0;
  };

  const hideFloatingBars = () => {
    document.querySelectorAll<HTMLElement>('[data-timer-floating]').forEach((bar) => {
      bar.setAttribute('aria-hidden', 'true');
    });
  };

  let floatingShownOnLoad = false;

  timerRoots.forEach((root) => {
    root.dataset.timerReady = 'true';
    const timerId = root.dataset.timerId ?? 'reading';
    const storageKey = `reading-timer:v1:${window.location.pathname}:${timerId}`;
    const wordCount = timerWordCount(root);
    const nativeGuideMs = recommendationSeconds(wordCount, 250) * 1000;
    const learnerGuideMs = recommendationSeconds(wordCount, 120) * 1000;

    const wordCountNode = root.querySelector<HTMLElement>('[data-timer-word-count]');
    const nativeGuideNode = root.querySelector<HTMLElement>('[data-timer-native-guide]');
    const learnerGuideNode = root.querySelector<HTMLElement>('[data-timer-learner-guide]');
    const displayNode = root.querySelector<HTMLTimeElement>('[data-timer-display]');
    const statusNode = root.querySelector<HTMLElement>('[data-timer-status]');
    const toggleButton = root.querySelector<HTMLButtonElement>('[data-timer-action="toggle"]');
    const toggleLabel = root.querySelector<HTMLElement>('[data-timer-toggle-label]');
    const finishButton = root.querySelector<HTMLButtonElement>('[data-timer-action="finish"]');
    const restartButton = root.querySelector<HTMLButtonElement>('[data-timer-action="restart"]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-timer-action="clear"]');
    const progressNode = root.querySelector<HTMLElement>('[data-timer-progress]');
    const lastNode = root.querySelector<HTMLElement>('[data-timer-last]');
    const bestNode = root.querySelector<HTMLElement>('[data-timer-best]');
    const countNode = root.querySelector<HTMLElement>('[data-timer-count]');
    const messageNode = root.querySelector<HTMLElement>('[data-timer-message]');
    const floatingBar = root.querySelector<HTMLElement>('[data-timer-floating]');
    const floatingDisplay = root.querySelector<HTMLElement>('[data-floating-display]');
    const floatingState = root.querySelector<HTMLElement>('[data-floating-state]');
    const floatingToggle = root.querySelector<HTMLButtonElement>('[data-floating-action="toggle"]');
    const floatingFinish = root.querySelector<HTMLButtonElement>('[data-floating-action="finish"]');
    const floatingExpand = root.querySelector<HTMLButtonElement>('[data-floating-action="expand"]');

    if (
      !displayNode || !statusNode || !toggleButton || !toggleLabel || !finishButton
      || !restartButton || !clearButton || !progressNode || !lastNode || !bestNode
      || !countNode || !messageNode || !floatingBar || !floatingDisplay || !floatingState
      || !floatingToggle || !floatingFinish || !floatingExpand
    ) return;

    if (wordCountNode) wordCountNode.textContent = String(wordCount);
    if (nativeGuideNode) nativeGuideNode.textContent = formatDuration(nativeGuideMs);
    if (learnerGuideNode) learnerGuideNode.textContent = formatDuration(learnerGuideMs);

    let stored: StoredTimer = {};
    try {
      stored = JSON.parse(localStorage.getItem(storageKey) ?? '{}') as StoredTimer;
    } catch {
      stored = {};
    }

    let elapsedMs = Math.max(0, stored.elapsedMs ?? 0);
    let running = Boolean(stored.running && stored.startedAt);
    let startedAt = running ? stored.startedAt ?? Date.now() : 0;
    let records = Array.isArray(stored.records)
      ? stored.records.filter((value) => Number.isFinite(value) && value > 0).slice(0, 20)
      : [];
    let recordedElapsedMs = stored.recordedElapsedMs ?? -1;
    let intervalId = 0;
    let statusMessage = running ? '计时中' : elapsedMs > 0 ? '已暂停' : '准备开始';

    const currentElapsed = () => elapsedMs + (running ? Date.now() - startedAt : 0);

    const persist = () => {
      try {
        localStorage.setItem(storageKey, JSON.stringify({
          elapsedMs,
          running,
          startedAt: running ? startedAt : undefined,
          records,
          recordedElapsedMs,
        } satisfies StoredTimer));
      } catch {
        // The timer remains usable when local storage is unavailable.
      }
    };

    const render = () => {
      const current = currentElapsed();
      const progress = learnerGuideMs > 0 ? Math.min(1, current / learnerGuideMs) : 0;
      displayNode.textContent = formatDuration(current);
      displayNode.dateTime = `PT${Math.floor(current / 1000)}S`;
      statusNode.lastChild!.textContent = statusMessage;
      root.dataset.timerState = running ? 'running' : current > 0 ? 'paused' : 'idle';
      toggleButton.setAttribute('aria-pressed', String(running));
      toggleLabel.textContent = running ? '暂停' : current > 0 ? '继续' : '开始';
      finishButton.disabled = current < 1000 || (!running && Math.abs(recordedElapsedMs - current) < 1000);
      progressNode.style.width = `${progress * 100}%`;
      root.toggleAttribute('data-over-guide', current > learnerGuideMs);

      floatingDisplay.textContent = formatDuration(current);
      floatingDisplay.setAttribute('datetime', `PT${Math.floor(current / 1000)}S`);
      floatingState.textContent = statusMessage;
      floatingToggle.setAttribute('aria-label', running ? '暂停计时' : '继续计时');
      floatingFinish.disabled = finishButton.disabled;
      floatingBar.toggleAttribute('data-floating-over-guide', current > learnerGuideMs);

      lastNode.textContent = records[0] ? formatDuration(records[0]) : '—';
      bestNode.textContent = records.length ? formatDuration(Math.min(...records)) : '—';
      countNode.textContent = String(records.length);
      if (records.length === 0) {
        messageNode.textContent = '完成后会保存在这台设备上，方便比较每次阅读速度。';
      } else if (records[0] <= nativeGuideMs) {
        messageNode.textContent = '本次已达到美国成年人参考速度。';
      } else if (records[0] <= learnerGuideMs) {
        messageNode.textContent = '本次在普通学习者建议时间内完成。';
      } else {
        messageNode.textContent = `本次比学习者建议时间多用 ${formatDuration(records[0] - learnerGuideMs)}，下次可以继续对比。`;
      }
    };

    const stopInterval = () => {
      if (intervalId) window.clearInterval(intervalId);
      intervalId = 0;
    };

    const startInterval = () => {
      stopInterval();
      intervalId = window.setInterval(render, 250);
    };

    const pause = (message = '已暂停') => {
      if (running) {
        elapsedMs = currentElapsed();
        running = false;
        startedAt = 0;
      }
      statusMessage = message;
      stopInterval();
      persist();
      render();
    };

    const controller = { root, pause };
    timerControllers.push(controller);

    const start = () => {
      hideFloatingBars();
      timerControllers.forEach((item) => {
        if (item !== controller) item.pause('已自动暂停');
      });
      running = true;
      startedAt = Date.now();
      statusMessage = '计时中';
      recordedElapsedMs = -1;
      startInterval();
      persist();
      render();
      floatingBar.setAttribute('aria-hidden', 'false');
    };

    toggleButton.addEventListener('click', () => {
      if (running) pause();
      else start();
    });

    floatingToggle.addEventListener('click', () => {
      if (running) pause();
      else start();
    });

    floatingFinish.addEventListener('click', () => finishButton.click());
    floatingExpand.addEventListener('click', () => {
      root.scrollIntoView({ behavior: 'smooth', block: 'center' });
      root.animate(
        [{ boxShadow: '0 0 0 0 rgba(47,111,88,0)' }, { boxShadow: '0 0 0 5px rgba(47,111,88,.16)' }, { boxShadow: '0 0 0 0 rgba(47,111,88,0)' }],
        { duration: 700, easing: 'ease-out' },
      );
    });

    finishButton.addEventListener('click', () => {
      const completed = currentElapsed();
      if (completed < 1000) return;
      if (running) {
        elapsedMs = completed;
        running = false;
        startedAt = 0;
      }
      records = [completed, ...records].slice(0, 20);
      recordedElapsedMs = completed;
      statusMessage = '已完成并记录';
      stopInterval();
      persist();
      render();
    });

    restartButton.addEventListener('click', () => {
      if (currentElapsed() >= 10_000 && !window.confirm('重新开始本次计时？已有历史记录会保留。')) return;
      elapsedMs = 0;
      recordedElapsedMs = -1;
      running = false;
      startedAt = 0;
      statusMessage = '准备重新开始';
      start();
    });

    clearButton.addEventListener('click', () => {
      if ((currentElapsed() > 0 || records.length > 0) && !window.confirm('清空本次时间和全部历史记录？')) return;
      elapsedMs = 0;
      running = false;
      startedAt = 0;
      records = [];
      recordedElapsedMs = -1;
      statusMessage = '已清空';
      stopInterval();
      try {
        localStorage.removeItem(storageKey);
      } catch {
        // Nothing else is required when local storage is unavailable.
      }
      render();
      floatingBar.setAttribute('aria-hidden', 'true');
    });

    if (running || (!floatingShownOnLoad && elapsedMs > 0)) {
      hideFloatingBars();
      floatingBar.setAttribute('aria-hidden', 'false');
      floatingShownOnLoad = true;
      if (running) startInterval();
    }
    render();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) timerControllers.forEach((timer) => timer.pause('离开页面，已自动暂停'));
  });
</script>

<style>
  .reading-timer {
    --timer-accent: #2f6f58;
    --timer-soft: #edf5f0;
    margin: 18px 0 30px;
    overflow: hidden;
    border: 1px solid #d8dfda;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 12px 36px rgba(31, 47, 39, 0.055);
  }

  .reading-timer-head {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 15px;
    border-bottom: 1px solid #e7ebe8;
  }

  .reading-timer-head > div {
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .reading-timer-kicker {
    color: #768079;
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .reading-timer-head strong {
    overflow: hidden;
    color: #243129;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading-timer-word-count {
    flex: 0 0 auto;
    padding: 6px 9px;
    border-radius: 999px;
    color: #657069;
    background: #f1f4f2;
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .reading-timer-word-count b { color: #2c3931; }

  .reading-timer-guides {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid #e4e9e5;
    background: #e4e9e5;
  }

  .reading-timer-guides > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3px 12px;
    padding: 12px 20px;
    background: #f8faf8;
  }

  .reading-timer-guides span {
    align-self: end;
    color: #68736c;
    font-size: 0.7rem;
  }

  .reading-timer-guides strong {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    color: #27342c;
    font-size: 1.08rem;
    font-variant-numeric: tabular-nums;
    font-weight: 680;
  }

  .reading-timer-guides small {
    color: #98a099;
    font-size: 0.6rem;
  }

  .reading-timer-main {
    display: grid;
    grid-template-columns: minmax(170px, 0.72fr) minmax(300px, 1.28fr);
    gap: 24px;
    align-items: center;
    padding: 20px;
  }

  .reading-timer-clock {
    display: grid;
    gap: 4px;
  }

  .reading-timer-clock > span:first-child {
    color: #7c857f;
    font-size: 0.65rem;
    font-weight: 680;
  }

  .reading-timer-clock time {
    color: #17231c;
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .reading-timer-status {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 5px;
    color: #78827c;
    font-size: 0.65rem;
  }

  .reading-timer-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #aeb6b1;
  }

  [data-timer-state='running'] .reading-timer-status { color: var(--timer-accent); }
  [data-timer-state='running'] .reading-timer-status i {
    background: #3c9b72;
    box-shadow: 0 0 0 4px rgba(60, 155, 114, 0.12);
  }

  .reading-timer-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .reading-timer-actions button {
    min-height: 38px;
    display: inline-flex;
    gap: 7px;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid #dce2de;
    border-radius: 9px;
    color: #445149;
    background: #fafbfa;
    font: inherit;
    font-size: 0.7rem;
    font-weight: 680;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .reading-timer-actions button:hover:not(:disabled) {
    border-color: #b9c5bd;
    background: #f1f5f2;
    transform: translateY(-1px);
  }

  .reading-timer-actions button:focus-visible {
    outline: 3px solid rgba(47, 111, 88, 0.16);
    outline-offset: 2px;
  }

  .reading-timer-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .reading-timer-actions .timer-primary {
    border-color: var(--timer-accent);
    color: #fff;
    background: var(--timer-accent);
  }

  .reading-timer-actions .timer-primary:hover:not(:disabled) {
    border-color: #255d49;
    color: #fff;
    background: #255d49;
  }

  .reading-timer-actions .timer-clear { color: #8b5148; }
  .timer-pause-icon { display: none; }
  [data-timer-state='running'] .timer-play-icon { display: none; }
  [data-timer-state='running'] .timer-pause-icon { display: block; }

  .reading-timer-progress {
    height: 3px;
    overflow: hidden;
    background: #e9eeeb;
  }

  .reading-timer-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: #5ba17f;
    transition: width 250ms linear, background-color 160ms ease;
  }

  [data-over-guide] .reading-timer-progress span { background: #d28b55; }

  .reading-timer-stats {
    display: grid;
    grid-template-columns: repeat(3, auto) minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    padding: 12px 20px;
    border-top: 1px solid #e6ebe7;
    background: #f7f9f7;
  }

  .reading-timer-stats > span { display: grid; gap: 2px; }
  .reading-timer-stats small {
    color: #8b948e;
    font-size: 0.58rem;
  }
  .reading-timer-stats strong {
    color: #3b4840;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .reading-timer-stats p {
    margin: 0;
    color: #737d76;
    font-size: 0.65rem;
    line-height: 1.5;
    text-align: right;
  }

  .reading-timer-floating {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 120;
    display: flex;
    gap: 8px;
    align-items: center;
    max-width: min(520px, calc(100vw - 40px));
    padding: 8px 9px 8px 13px;
    border: 1px solid rgba(207, 220, 212, 0.96);
    border-radius: 13px;
    color: #24332a;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 12px 34px rgba(28, 48, 37, 0.16), 0 2px 8px rgba(28, 48, 37, 0.08);
    backdrop-filter: blur(16px) saturate(1.12);
    -webkit-backdrop-filter: blur(16px) saturate(1.12);
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .reading-timer-floating[aria-hidden='true'] {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(12px);
  }

  .reading-timer-floating-pulse {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #aab5ae;
  }

  [data-timer-state='running'] .reading-timer-floating-pulse {
    background: #3c9b72;
    box-shadow: 0 0 0 4px rgba(60, 155, 114, 0.13);
  }

  .reading-timer-floating-label {
    min-width: 0;
    overflow: hidden;
    color: #68736c;
    font-size: 0.65rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading-timer-floating time {
    color: #17231c;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    font-weight: 720;
    letter-spacing: -0.025em;
    white-space: nowrap;
