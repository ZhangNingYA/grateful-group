---
import type { ReadingQuestion } from '../../types/readingQuestion';
import SentenceNote from './SentenceNote.astro';
import type { InlineGlossary } from '../../types/closeReading';

interface Props {
  questions: readonly ReadingQuestion[];
  inlineGlossary?: InlineGlossary;
  sharedGlossaryPhrases?: readonly { term: string; explanation: string }[];
  experience?: 'blog' | 'game';
}

const { questions, inlineGlossary, sharedGlossaryPhrases = [], experience = 'blog' } = Astro.props;
const firstQuestion = questions.at(0)?.number;
const lastQuestion = questions.at(-1)?.number;
const rangeLabel = firstQuestion === lastQuestion
  ? String(firstQuestion)
  : `${firstQuestion}–${lastQuestion}`;
---

<section class="reading-questions" aria-label={`Questions ${rangeLabel}`}>
  <header class="reading-questions-header">
    <div>
      <p>Comprehension Check</p>
      <h4>Questions {rangeLabel}</h4>
    </div>
    <span>{questions.length} Questions</span>
  </header>

  <ol class="reading-question-list">
    {questions.map((question) => {
      const feedbackId = `question-${question.number}-feedback`;

      return (
        <li
          class="reading-question"
          data-reading-question
          data-answer={question.answer}
          data-question-number={question.number}
        >
          <div class="reading-question-content">
            <SentenceNote
              number={`Q${question.number}`}
              sentence={question.prompt}
              closeReading={question.closeReading}
              {inlineGlossary}
              {sharedGlossaryPhrases}
              {experience}
            />

            <div class="reading-question-options" role="radiogroup" aria-label={`Question ${question.number} options`}>
              {question.options.map((option, optionIndex) => (
                <div class="reading-question-option-item">
                  <button
                    class="reading-question-option"
                    type="button"
                    role="radio"
                    aria-checked="false"
                    aria-controls={feedbackId}
                    tabindex={optionIndex === 0 ? 0 : -1}
                    data-question-option={option.key}
                    data-option-explanation={option.explanation}
                    data-correct={option.key === question.answer ? 'true' : 'false'}
                  >
                    <span>{option.key}</span>
                    <span lang="en">{option.text}</span>
                    <i aria-hidden="true"></i>
                  </button>
                </div>
              ))}
              <div
                class="question-option-feedback"
                id={feedbackId}
                aria-live="polite"
                aria-hidden="true"
                data-option-feedback
              >
                <div class="question-option-feedback-inner">
                  <div class="question-feedback-summary">
                    <strong data-question-result></strong>
                    <span>Correct answer · {question.answer}</span>
                  </div>
                  <p class="question-option-explanation" lang="zh-CN" data-question-explanation></p>
                  <div class="question-solution-grid">
                    <section>
                      <span>Evidence</span>
                      <blockquote lang="en">{question.evidence}</blockquote>
                    </section>
                    <section>
                      <span>Reasoning</span>
                      <p lang="zh-CN">{question.analysis}</p>
                    </section>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<script>
  const selectReadingOption = (option: HTMLButtonElement) => {
    const question = option.closest<HTMLElement>('[data-reading-question]');
    if (!question) return;
    const selected = option.dataset.questionOption;
    const isCorrect = selected === question.dataset.answer;
    const options = Array.from(question.querySelectorAll<HTMLButtonElement>('[data-question-option]'));
    const feedback = question.querySelector<HTMLElement>('[data-option-feedback]');
    const result = feedback?.querySelector<HTMLElement>('[data-question-result]');
    const explanation = feedback?.querySelector<HTMLElement>('[data-question-explanation]');

    question.setAttribute('data-answered', 'true');
    question.setAttribute('data-selected-correct', String(isCorrect));
    options.forEach((candidate) => {
      const active = candidate === option;
      candidate.classList.toggle('is-selected', active);
      candidate.setAttribute('aria-checked', String(active));
      candidate.tabIndex = active ? 0 : -1;
    });
    if (!feedback || !result || !explanation) return;
    feedback.dataset.optionCorrect = String(isCorrect);
    result.textContent = isCorrect ? 'Correct' : 'Incorrect';
    explanation.textContent = option.dataset.optionExplanation ?? '';
    option.closest('.reading-question-option-item')?.append(feedback);
    feedback.setAttribute('aria-hidden', 'false');
  };

  document.addEventListener('click', (event) => {
    const option = (event.target as Element).closest<HTMLButtonElement>('[data-question-option]');
    if (option) selectReadingOption(option);
  });

  document.addEventListener('keydown', (event) => {
    const option = (event.target as Element).closest<HTMLButtonElement>('[data-question-option]');
    if (!option || !['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(event.key)) return;
    const question = option.closest<HTMLElement>('[data-reading-question]');
    const options = Array.from(question?.querySelectorAll<HTMLButtonElement>('[data-question-option]') ?? []);
    const currentIndex = options.indexOf(option);
    if (currentIndex < 0 || options.length === 0) return;
    event.preventDefault();
    const direction = event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1;
    const nextOption = options[(currentIndex + direction + options.length) % options.length];
    nextOption.focus();
    nextOption.click();
  });
</script>

<style>
  .reading-questions {
    margin: 38px 0 66px;
    border-top: 2px solid #17201c;
  }

  .reading-questions-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    padding: 20px 0 17px;
    border-bottom: 1px solid #dfe3e0;
  }

  .reading-questions-header p,
  .reading-questions-header h4 {
    margin: 0;
  }

  .reading-questions-header p {
    margin-bottom: 5px;
    color: #728079;
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reading-questions-header h4 {
    color: #17201c;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.45rem;
    font-weight: 560;
    line-height: 1.2;
  }

  .reading-questions-header > span {
    padding-bottom: 3px;
    color: #7b847f;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .reading-question-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-question {
    display: block;
    padding: 25px 0 28px;
    border-bottom: 1px solid #dfe3e0;
  }

  .reading-question-content {
    min-width: 0;
  }

  .reading-question-option:focus-visible {
    outline: 3px solid rgba(49, 95, 155, 0.2);
    outline-offset: 2px;
  }

  .reading-question-options {
    display: grid;
    gap: 9px;
    margin-top: 18px;
  }

  .reading-question-option-item {
    min-width: 0;
  }

  .reading-question-option {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 18px;
    gap: 10px;
    align-items: start;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #dfe3e0;
    border-radius: 9px;
    color: #3f4943;
    background: #fff;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.48;
    text-align: left;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .reading-question-option:hover {
    border-color: #aeb7b1;
    background: #fafbf9;
  }

  .reading-question-option > span:first-child {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid #d6dcd8;
    border-radius: 50%;
    color: #69736d;
    font-family: 'Inter Variable', Inter, sans-serif;
    font-size: 0.64rem;
    font-weight: 750;
    line-height: 1;
  }

  .reading-question-option > i {
    display: none;
    width: 8px;
    height: 8px;
    margin-top: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  [data-answered] .reading-question-option[data-correct='true'] {
    border-color: #7fba9f;
    color: #17633f;
    background: #edf8f2;
  }

  [data-answered] .reading-question-option[data-correct='true'] > span:first-child {
    border-color: #4d9873;
    color: #fff;
    background: #287956;
  }

  [data-answered] .reading-question-option[data-correct='true'] > i,
  [data-answered][data-selected-correct='false'] .reading-question-option.is-selected > i {
    display: block;
  }

  [data-answered][data-selected-correct='false'] .reading-question-option.is-selected {
    border-color: #d69b9b;
    color: #8b2929;
    background: #fdf1f1;
  }

  [data-answered][data-selected-correct='false'] .reading-question-option.is-selected > span:first-child {
    border-color: #b95858;
    color: #fff;
    background: #aa4242;
  }

  .question-option-feedback {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    overflow: hidden;
    border: 1px solid #d8ded9;
    border-radius: 11px;
    background: #fafbf9;
    box-shadow: 0 10px 26px rgba(32, 45, 37, 0.06);
    opacity: 0;
    transition: grid-template-rows 220ms ease, opacity 150ms ease, margin-top 180ms ease;
  }

  .question-option-feedback[aria-hidden='false'] {
    grid-template-rows: 1fr;
    margin-top: 7px;
    opacity: 1;
  }

  .question-option-feedback-inner {
    min-height: 0;
    overflow: hidden;
  }

  .question-feedback-summary {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    min-height: 0;
    padding: 12px 14px;
    border-bottom: 1px solid #e0e5e1;
  }

  .question-feedback-summary strong {
    color: #17633f;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .question-option-feedback[data-option-correct='false'] .question-feedback-summary strong {
    color: #9c3838;
  }

  .question-feedback-summary span {
    color: #737d77;
    font-size: 0.65rem;
    font-weight: 720;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .question-option-explanation {
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 14px 14px 15px;
    color: #354039;
    font-size: 0.86rem;
    line-height: 1.68;
  }

  .question-solution-grid {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid #e0e5e1;
  }

  .question-solution-grid section {
    min-width: 0;
    padding: 14px;
  }

  .question-solution-grid section + section {
    border-left: 1px solid #e0e5e1;
  }

  .question-solution-grid section > span {
    display: block;
    margin-bottom: 7px;
    color: #7a847e;
    font-size: 0.61rem;
    font-weight: 780;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .question-solution-grid blockquote,
  .question-solution-grid p {
    margin: 0;
    color: #4c5751;
    font-size: 0.79rem;
    line-height: 1.62;
  }

  .question-solution-grid blockquote {
    padding-left: 10px;
    border-left: 2px solid #aeb9b2;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-style: normal;
  }

  @media (max-width: 640px) {
    .reading-questions { margin-top: 30px; }

    .reading-question {
      padding: 22px 0 25px;
    }

    .reading-question-option {
      grid-template-columns: 27px minmax(0, 1fr) 12px;
      gap: 8px;
      padding: 9px 10px;
      font-size: 0.91rem;
    }

    .question-solution-grid { grid-template-columns: 1fr; }

    .question-solution-grid section + section {
      border-top: 1px solid #e0e5e1;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .question-option-feedback,
    .reading-question-option { transition: none; }
  }
</style>
