---
interface Props {
  number: string;
  analysis: string;
}

const { number, analysis } = Astro.props;
---

<div class="sentence-note">
  <span class="sentence-number" aria-hidden="true">{number}</span>
  <div class="sentence-content">
    <div class="sentence-original"><slot /></div>
    <p class="sentence-analysis"><span>Analysis</span>{analysis}</p>
  </div>
</div>

<style>
  .sentence-note {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 24px 0 26px;
    border-top: 1px solid #e0e4e1;
  }

  .sentence-number {
    padding-top: 4px;
    color: #a24c39;
    font-family: 'Inter Variable', Inter, sans-serif;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .sentence-content { min-width: 0; }

  .sentence-original {
    color: #17201c;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.18rem;
    font-weight: 450;
    line-height: 1.7;
  }

  .sentence-original :global(p) { margin: 0; }

  .sentence-analysis {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 12px;
    margin: 13px 0 0;
    color: #626b66;
    font-size: 0.87rem;
    line-height: 1.72;
  }

  .sentence-analysis span {
    padding-top: 1px;
    color: #4f78a3;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sentence-original :global(mark) {
    padding: 0 0.12em;
    color: inherit;
    background: linear-gradient(transparent 52%, rgba(217, 101, 75, 0.24) 52%);
  }

  @media (max-width: 640px) {
    .sentence-note {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 10px;
      padding: 20px 0 22px;
    }

    .sentence-original { font-size: 1.05rem; }

    .sentence-analysis {
      grid-template-columns: 1fr;
      gap: 4px;
      font-size: 0.84rem;
    }
  }
</style>
