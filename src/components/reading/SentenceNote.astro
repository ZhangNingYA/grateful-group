---
import { BookOpenText } from 'lucide-astro';
import type {
  CloseReading,
  CloseReadingVocabulary,
  InlineGlossary,
  SentenceRole,
} from '../../types/closeReading';

interface Props {
  number: string;
  sentence?: string;
  closeReading?: CloseReading;
  inlineGlossary?: InlineGlossary;
  sharedGlossaryPhrases?: readonly CloseReadingVocabulary[];
  experience?: 'blog' | 'game';
}

const {
  number,
  sentence,
  closeReading,
  inlineGlossary,
  sharedGlossaryPhrases = [],
  experience = 'blog',
} = Astro.props;
const isBlogExperience = experience === 'blog';
const semanticAnalysis = isBlogExperience ? closeReading?.analysis : undefined;
const detailId = `close-reading-${number.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`;
const glossaryId = 'reading-inline-glossary-popover';

const roleLabels: Record<SentenceRole, string> = {
  subject: '主语',
  predicate: '谓语',
  object: '宾语',
  complement: '表语 / 补语',
  adverbial: '状语',
};

const roleHelp: Record<SentenceRole, string> = {
  subject: '谁 / 什么',
  predicate: '做什么 / 怎么样',
  object: '动作作用到谁 / 什么',
  complement: '补充说明结果或状态',
  adverbial: '时间 / 原因 / 条件 / 方式',
};

interface SentencePart {
  text: string;
  role?: SentenceRole;
  start: number;
}

interface SentenceRun {
  text: string;
  glossary?: {
    term: string;
    explanation: string;
    partOfSpeech: string;
  };
}

const normalizeForMatch = (value: string) => value
  .replace(/[‘’]/g, "'")
  .replace(/[“”]/g, '"');

const buildSentenceParts = (): SentencePart[] => {
  if (!sentence || !closeReading) return sentence ? [{ text: sentence, start: 0 }] : [];

  const normalizedSentence = normalizeForMatch(sentence);
  const matches: Array<{ start: number; end: number; role: SentenceRole }> = [];
  let searchFrom = 0;

  (semanticAnalysis?.highlights ?? closeReading.highlights).forEach((highlight) => {
    const normalizedText = normalizeForMatch(highlight.text);
    let start = normalizedSentence.indexOf(normalizedText, searchFrom);
    if (start === -1) start = normalizedSentence.indexOf(normalizedText);
    if (start === -1) return;

    matches.push({ start, end: start + normalizedText.length, role: highlight.role });
    searchFrom = start + normalizedText.length;
  });

  const parts: SentencePart[] = [];
  let cursor = 0;
  matches.sort((a, b) => a.start - b.start || a.end - b.end).forEach((match) => {
    if (match.start < cursor) return;
    if (match.start > cursor) parts.push({ text: sentence.slice(cursor, match.start), start: cursor });
    parts.push({ text: sentence.slice(match.start, match.end), role: match.role, start: match.start });
    cursor = match.end;
  });
  if (cursor < sentence.length) parts.push({ text: sentence.slice(cursor), start: cursor });
  return parts;
};

const rawSentenceParts = buildSentenceParts();

interface GlossaryMatch {
  start: number;
  end: number;
  term: string;
  explanation: string;
  partOfSpeech: string;
  priority: number;
}

const wordTokens = (value: string) => Array.from(
  value.matchAll(/(?<![A-Za-z0-9])(?:[A-Za-z]+(?:['’][A-Za-z]+)?|\$?\d+(?:[.,]\d+)*(?:%|s|st|nd|rd|th)?)(?![A-Za-z0-9])/g),
  (match) => ({
    text: normalizeForMatch(match[0]).toLowerCase(),
    raw: match[0],
    start: match.index,
    end: match.index + match[0].length,
  }),
);

const irregularLemmas: Record<string, string> = {
  am: 'be', is: 'be', are: 'be', was: 'be', were: 'be', been: 'be', being: 'be',
  did: 'do', done: 'do', does: 'do',
  "don't": 'not', "doesn't": 'not', "didn't": 'not', "isn't": 'not', "aren't": 'not',
  "wasn't": 'not', "weren't": 'not', "can't": 'not', "couldn't": 'not', "won't": 'not',
  fell: 'fall', fallen: 'fall', rose: 'rise', risen: 'rise', sank: 'sink', sunk: 'sink',
  swept: 'sweep', came: 'come', grown: 'grow', paid: 'pay', drew: 'draw', swung: 'swing',
  brought: 'bring', led: 'lead',
  gave: 'give', given: 'give', found: 'find', made: 'make',
  took: 'take', taken: 'take', thought: 'think',
};

const wordForms = (word: string) => {
  const forms = new Set<string>([word]);
  if (irregularLemmas[word]) forms.add(irregularLemmas[word]);
  if (/^(?:aren't|isn't|wasn't|weren't|we're|they're|you're|he's|she's|it's|there's)$/.test(word)) {
    forms.add('be');
  }
  const addStem = (stem: string) => {
    forms.add(stem);
    if (/(.)\1$/.test(stem)) forms.add(stem.slice(0, -1));
  };
  if (word.endsWith('ies') && word.length > 4) forms.add(`${word.slice(0, -3)}y`);
  if (word.endsWith('ied') && word.length > 4) forms.add(`${word.slice(0, -3)}y`);
  if (word.endsWith('ing') && word.length > 4) {
    const stem = word.slice(0, -3);
    addStem(stem);
    forms.add(`${stem}e`);
  }
  if (word.endsWith('ed') && word.length > 4) {
    addStem(word.slice(0, -2));
    forms.add(`${word.slice(0, -1)}`);
  }
  if (word.endsWith('est') && word.length > 5) {
    addStem(word.slice(0, -3));
    forms.add(word.slice(0, -2));
  }
  if (word.endsWith('er') && word.length > 4) {
    addStem(word.slice(0, -2));
    forms.add(word.slice(0, -1));
  }
  if (word.endsWith('es') && word.length > 4) forms.add(word.slice(0, -2));
  if (word.endsWith('s') && word.length > 3) forms.add(word.slice(0, -1));
  return forms;
};

const wordsEquivalent = (source: string, term: string) => {
  const determiners = new Set(['a', 'an', 'the', 'some']);
  if (determiners.has(source) && determiners.has(term)) return true;
  const sourceForms = wordForms(source);
  const termForms = wordForms(term);
  return [...sourceForms].some((form) => termForms.has(form));
};

const inlineGlossaryEntry = (value: string) =>
  inlineGlossary?.words[normalizeForMatch(value).toLowerCase()];

const partOfSpeechLabel = (value: string) => ({
  n: '名词',
  v: '动词',
  vt: '及物动词',
  vi: '不及物动词',
  adj: '形容词',
  adv: '副词',
  prep: '介词',
  conj: '连词',
  pron: '代词',
  det: '限定词',
  num: '数词',
  abbr: '缩写',
  contr: '缩写',
  int: '感叹词',
}[value] ?? value);

const glossaryMatches = (): Array<{
  start: number;
  end: number;
  term: string;
  explanation: string;
  partOfSpeech: string;
}> => {
  if (!sentence || !closeReading || !inlineGlossary) return [];

  const normalizedSentence = normalizeForMatch(sentence).toLowerCase();
  const sentenceWords = wordTokens(sentence);
  const candidates: GlossaryMatch[][] = [];
  const vocabulary = [
    ...closeReading.vocabulary.map((item) => ({ ...item, allowFlexibleMatch: true })),
    ...sharedGlossaryPhrases.map((item) => ({ ...item, allowFlexibleMatch: false })),
  ]
    .filter((item, index, all) => all.findIndex((candidate) => (
      normalizeForMatch(candidate.term).toLowerCase() === normalizeForMatch(item.term).toLowerCase()
    )) === index);

  vocabulary
    .filter((item) => item.term && /[A-Za-z]/.test(item.term))
    .forEach((item) => {
      const normalizedTerm = normalizeForMatch(item.term).toLowerCase();
      const termTokenCount = wordTokens(item.term).length;
      const hasTemplateSlots = (
        /\.{3}|…|\bsome(?:one|thing)\b|\bone(?:['’]s|self)\b/i.test(item.term)
        || /\b[AB]\b/.test(item.term)
        || /\bone\s+can\b/i.test(item.term)
        || /\bdo(?:ing)?$/i.test(item.term)
      );
      const phrasePriorityBase = termTokenCount < 2
        ? 0
        : hasTemplateSlots ? 100_000 : 200_000;
      const contextPriority = item.allowFlexibleMatch ? 10_000 : 0;
      let from = 0;
      let foundExact = false;
      while (from < normalizedSentence.length) {
        const start = normalizedSentence.indexOf(normalizedTerm, from);
        if (start === -1) break;
        const end = start + normalizedTerm.length;
        const before = normalizedSentence[start - 1] ?? '';
        const after = normalizedSentence[end] ?? '';
        const boundary = !/[a-z0-9]/.test(before) && !/[a-z0-9]/.test(after);
        if (boundary) {
          candidates.push([{
            start,
            end,
            term: item.term,
            explanation: item.explanation,
            partOfSpeech: !item.allowFlexibleMatch || termTokenCount > 1
              ? '短语'
              : partOfSpeechLabel(inlineGlossaryEntry(item.term)?.partOfSpeech ?? '词汇'),
            priority: phrasePriorityBase + contextPriority + termTokenCount * 1000 + 500 + end - start,
          }]);
          foundExact = true;
        }
        from = end;
      }

      if (foundExact) return;
      if (!item.allowFlexibleMatch) return;
      const hasFlexibleGap = hasTemplateSlots;
      const termWords = wordTokens(item.term);
      if (termWords.length === 0) return;

      const isPlaceholder = (token: { text: string; raw: string }, termIndex: number) => (
        /^some(?:one|thing)$/i.test(token.text)
        || token.text === "one's"
        || token.text === 'oneself'
        || token.text === 'one'
        || /^[AB]$/.test(token.raw)
        || (/^do(?:ing)?$/i.test(token.text) && termIndex === termWords.length - 1)
      );

      const isActionPlaceholder = (token: { text: string }, termIndex: number) => (
        /^do(?:ing)?$/i.test(token.text) && termIndex === termWords.length - 1
      );

      const consumePlaceholder = (
        termIndex: number,
        sentenceIndex: number,
      ): number => {
        if (isActionPlaceholder(termWords[termIndex], termIndex)) return sentenceIndex;
        if (termWords[termIndex].text === 'oneself') {
          const reflexives = new Set([
            'myself', 'yourself', 'himself', 'herself', 'itself',
            'ourselves', 'yourselves', 'themselves',
          ]);
          if (!reflexives.has(sentenceWords[sentenceIndex]?.text ?? '')) return sentenceIndex;
          const connector = sentenceWords[sentenceIndex + 1]?.text;
          const coordinatedReflexive = sentenceWords[sentenceIndex + 2]?.text;
          return (connector === 'or' || connector === 'and')
            && reflexives.has(coordinatedReflexive ?? '')
            ? sentenceIndex + 2
            : sentenceIndex;
        }

        const nextLiteralOffset = termWords.slice(termIndex + 1)
          .findIndex((token, index) => !isPlaceholder(token, termIndex + index + 1));
        const nextLiteral = nextLiteralOffset >= 0
          ? termWords[termIndex + nextLiteralOffset + 1]
          : undefined;
        if (nextLiteral) {
          const nextLiteralIndex = sentenceWords.findIndex((sourceWord, index) => (
            index >= sentenceIndex && wordsEquivalent(sourceWord.text, nextLiteral.text)
          ));
          return nextLiteralIndex > sentenceIndex ? nextLiteralIndex - 1 : sentenceIndex;
        }

        const currentPart = rawSentenceParts.find((part) => (
          sentenceWords[sentenceIndex]
          && sentenceWords[sentenceIndex].start >= part.start
          && sentenceWords[sentenceIndex].start < part.start + part.text.length
        ));
        if (!currentPart) return sentenceIndex;

        let index = sentenceIndex;
        while (index + 1 < sentenceWords.length) {
          const nextWord = sentenceWords[index + 1];
          if (!nextWord || nextWord.start >= currentPart.start + currentPart.text.length) break;
          index += 1;
        }
        return index;
      };

      const flexibleMatches: Array<{
        match: GlossaryMatch;
        omittedLeadingBe: boolean;
      }> = [];
      for (let startIndex = 0; startIndex < sentenceWords.length; startIndex += 1) {
        let firstTermIndex = 0;
        if (!wordsEquivalent(sentenceWords[startIndex].text, termWords[0].text)) {
          const canOmitLeadingBe = termWords[0].text === 'be'
            && termWords[1]
            && wordsEquivalent(sentenceWords[startIndex].text, termWords[1].text);
          if (!canOmitLeadingBe) continue;
          firstTermIndex = 1;
        }

        const selected = [sentenceWords[startIndex]];
        let sentenceIndex = startIndex + 1;
        let matched = true;
        for (let termIndex = firstTermIndex + 1; termIndex < termWords.length; termIndex += 1) {
          if (isPlaceholder(termWords[termIndex], termIndex)) {
            const foundIndex = consumePlaceholder(termIndex, sentenceIndex);
            const sourceWord = sentenceWords[foundIndex];
            if (!sourceWord) {
              matched = false;
              break;
            }
            selected.push(sourceWord);
            sentenceIndex = foundIndex + 1;
            continue;
          }

          const maxGap = hasFlexibleGap ? 18 : 4;
          const foundIndex = sentenceWords.findIndex((sourceWord, index) => (
            index >= sentenceIndex
            && index <= sentenceIndex + maxGap
            && wordsEquivalent(sourceWord.text, termWords[termIndex].text)
          ));
          if (foundIndex === -1) {
            matched = false;
            break;
          }
          selected.push(sentenceWords[foundIndex]);
          sentenceIndex = foundIndex + 1;
        }
        if (!matched) continue;

        const firstToken = selected[0];
        const lastToken = selected[selected.length - 1];
        if (!firstToken || !lastToken) return;

        flexibleMatches.push({
          omittedLeadingBe: firstTermIndex === 1,
          match: {
            // Keep a flexible phrase as one clickable range, including any
            // words between its matched parts (for example, "cost people
            // their jobs" for "cost someone something").
            start: firstToken.start,
            end: lastToken.end,
            term: item.term,
            explanation: item.explanation,
            partOfSpeech: !item.allowFlexibleMatch || termTokenCount > 1
              ? '短语'
              : partOfSpeechLabel(inlineGlossaryEntry(firstToken.text)?.partOfSpeech ?? '词汇'),
            priority: phrasePriorityBase + contextPriority
              + termTokenCount * 1000 + (hasFlexibleGap ? 700 : 100),
          },
        });
      }

      const bestFlexibleMatch = flexibleMatches
        .sort((a, b) => (
          Number(a.omittedLeadingBe) - Number(b.omittedLeadingBe)
          || (a.match.end - a.match.start) - (b.match.end - b.match.start)
          || a.match.start - b.match.start
        ))[0]?.match;
      if (bestFlexibleMatch) {
        candidates.push([bestFlexibleMatch]);
        return;
      }
      if (termTokenCount < 2) return;

      // Some curated phrases are transformed by the sentence: a passive can
      // reverse the object and verb ("the effect ... be obtained"), and a
      // relative clause can move a preposition before its object. In those
      // cases, keep the phrase meaning on its content-word anchor instead of
      // falling back to an unrelated single-word definition.
      const fallbackStopWords = new Set([
        'a', 'an', 'the', 'be', 'do', 'doing', 'one', "one's", 'oneself',
        'to', 'of', 'in', 'on', 'for', 'with', 'from', 'as', 'at', 'by',
        'and', 'or', 'not', 'just', 'can', 'someone', 'something',
      ]);
      const usedSentenceIndexes = new Set<number>();
      const fallbackTokens = termWords
        .filter((token, index) => (
          !isPlaceholder(token, index) && !fallbackStopWords.has(token.text)
        ))
        .map((termToken) => {
          const sentenceTokenIndex = sentenceWords.findIndex((sourceToken, index) => (
            !usedSentenceIndexes.has(index)
            && wordsEquivalent(sourceToken.text, termToken.text)
          ));
          if (sentenceTokenIndex < 0) return undefined;
          usedSentenceIndexes.add(sentenceTokenIndex);
          return { ...sentenceWords[sentenceTokenIndex], sentenceTokenIndex };
        })
        .filter((token) => token !== undefined);
      if (fallbackTokens.length === 0) return;

      const sortedFallbackTokens = [...fallbackTokens]
        .sort((a, b) => a.sentenceTokenIndex - b.sentenceTokenIndex);
      const firstFallbackToken = sortedFallbackTokens[0];
      const lastFallbackToken = sortedFallbackTokens.at(-1);
      if (!firstFallbackToken || !lastFallbackToken) return;
      // Keep a transformed phrase as one glossary target. If its arguments
      // are separated or reordered in the sentence, anchor the target on the
      // first meaningful lexical item rather than creating several buttons
      // for one phrase.
      const firstLiteralToken = termWords.find((token, index) => (
        !isPlaceholder(token, index) && !fallbackStopWords.has(token.text)
      ));
      const anchorToken = firstLiteralToken
        ? fallbackTokens.find((token) => wordsEquivalent(token.text, firstLiteralToken.text))
        : undefined;
      const fallbackRange = anchorToken && (
        lastFallbackToken.sentenceTokenIndex - firstFallbackToken.sentenceTokenIndex <= 8
      )
        ? { start: firstFallbackToken.start, end: lastFallbackToken.end }
        : { start: (anchorToken ?? firstFallbackToken).start, end: (anchorToken ?? firstFallbackToken).end };

      candidates.push([{
        ...fallbackRange,
        term: item.term,
        explanation: item.explanation,
        partOfSpeech: '短语',
        priority: phrasePriorityBase + contextPriority + termTokenCount * 1000 + 50,
      }]);
    });

  const claimedGroups: GlossaryMatch[][] = [];
  candidates
    .sort((a, b) => b[0].priority - a[0].priority || a[0].start - b[0].start)
    .forEach((candidate) => {
      const claimedMatches = claimedGroups.flat();
      const remaining = candidate.flatMap((match) => {
        let ranges = [{ start: match.start, end: match.end }];
        claimedMatches.forEach((previous) => {
          ranges = ranges.flatMap((range) => {
            if (range.start >= previous.end || range.end <= previous.start) return [range];
            const pieces: Array<{ start: number; end: number }> = [];
            if (range.start < previous.start) pieces.push({ start: range.start, end: previous.start });
            if (range.end > previous.end) pieces.push({ start: previous.end, end: range.end });
            return pieces;
          });
        });

        const usableRanges = ranges.flatMap((range) => {
          const tokens = sentenceWords.filter((token) => (
            token.start < range.end && token.end > range.start
          ));
          const firstToken = tokens[0];
          const lastToken = tokens.at(-1);
          if (!firstToken || !lastToken) return [];
          const termTokens = wordTokens(match.term);
          const literalTermTokens = termTokens.filter((token, index) => (
            !/^some(?:one|thing)$/i.test(token.text)
            && token.text !== "one's"
            && token.text !== 'oneself'
            && !/^[AB]$/.test(token.raw)
            && !(/^do(?:ing)?$/i.test(token.text) && index === termTokens.length - 1)
          ));
          const containsLiteralPart = tokens.some((sourceToken) => (
            literalTermTokens.some((termToken) => wordsEquivalent(sourceToken.text, termToken.text))
          ));
          if (!containsLiteralPart) return [];
          return [{ ...match, start: firstToken.start, end: lastToken.end }];
        });
        if (usableRanges.length <= 1) return usableRanges;
        // A higher-priority phrase may sit inside this range. Keep the
        // largest remaining piece as a single target instead of splitting one
        // glossary entry into multiple disconnected buttons.
        return [usableRanges.sort((a, b) => (
          (b.end - b.start) - (a.end - a.start) || a.start - b.start
        ))[0]];
      });
      if (remaining.length > 0) claimedGroups.push(remaining);
    });

  const claimedMatches = claimedGroups
    .flat()
    .sort((a, b) => a.start - b.start);

  const singleWordMatches = sentenceWords
    // Number tokens are needed to fill phrase patterns such as “multiply A
    // by B”, but they are not standalone vocabulary entries.
    .filter((token) => /[A-Za-z]/.test(token.raw))
    .filter((token) => !claimedMatches.some((match) => (
      token.start < match.end && token.end > match.start
    )))
    .map((token) => {
      const entry = inlineGlossaryEntry(token.text);
      return {
        start: token.start,
        end: token.end,
        term: token.raw,
        explanation: entry?.meaning ?? '本句中的词义',
        partOfSpeech: partOfSpeechLabel(entry?.partOfSpeech ?? '词汇'),
        priority: 0,
      };
    });

  return [...claimedMatches, ...singleWordMatches]
    .sort((a, b) => a.start - b.start || b.end - a.end)
    .map(({ start, end, term, explanation, partOfSpeech }) => ({
      start,
      end,
      term,
      explanation,
      partOfSpeech,
    }));
};

const sentenceGlossaryMatches = glossaryMatches();

interface RenderSegment {
  text: string;
  role?: SentenceRole;
  glossary?: SentenceRun['glossary'];
}

interface RenderGroup {
  glossary?: SentenceRun['glossary'];
  matchIndex: number;
  segments: RenderSegment[];
}

const sentenceRenderGroups = (): RenderGroup[] => {
  if (!sentence) return [];

  const boundaries = new Set<number>([0, sentence.length]);
  rawSentenceParts.forEach((part) => {
    boundaries.add(part.start);
    boundaries.add(part.start + part.text.length);
  });
  sentenceGlossaryMatches.forEach((match) => {
    boundaries.add(match.start);
    boundaries.add(match.end);
  });

  const sortedBoundaries = [...boundaries].sort((a, b) => a - b);
  const segments: Array<RenderSegment & { matchIndex: number }> = [];
  for (let index = 0; index < sortedBoundaries.length - 1; index += 1) {
    const start = sortedBoundaries[index];
    const end = sortedBoundaries[index + 1];
    if (end <= start) continue;

    const part = rawSentenceParts.find((candidate) => (
      start >= candidate.start && start < candidate.start + candidate.text.length
    ));
    const matchIndex = sentenceGlossaryMatches.findIndex((candidate) => (
      start >= candidate.start && end <= candidate.end
    ));
    const match = matchIndex >= 0 ? sentenceGlossaryMatches[matchIndex] : undefined;
    segments.push({
      text: sentence.slice(start, end),
      role: part?.role,
      glossary: match ? {
        term: match.term,
        explanation: match.explanation,
        partOfSpeech: match.partOfSpeech,
      } : undefined,
      matchIndex,
    });
  }

  const groups: RenderGroup[] = [];
  segments.forEach((segment) => {
    const previous = groups.at(-1);
    const canMerge = previous && (
      segment.matchIndex === previous.matchIndex
        && (segment.matchIndex >= 0 || previous.segments.at(-1)?.role === segment.role)
    );

    if (canMerge) previous.segments.push(segment);
    else groups.push({ glossary: segment.glossary, matchIndex: segment.matchIndex, segments: [segment] });
  });
  return groups;
};

const sentenceRender = sentenceRenderGroups();
const trunkHighlights = closeReading
  ? semanticAnalysis?.trunk
    ?? closeReading.trunk
    ?? closeReading.highlights.filter((item) => item.role !== 'adverbial')
  : [];
const mergePredicateHighlights = (items: CloseReading['highlights']) => {
  const merged: CloseReading['highlights'] = [];
  items.forEach((item) => {
    const previous = merged.at(-1);
    if (previous?.role === 'predicate' && item.role === 'predicate') {
      const separator = /^(?:n[’']t\b|'[a-z]+\b|’[a-z]+\b)/i.test(item.text) ? '' : ' ';
      previous.text = `${previous.text}${separator}${item.text}`;
    } else {
      merged.push({ ...item });
    }
  });
  return merged;
};
const mergedTrunk = isBlogExperience ? mergePredicateHighlights(
  trunkHighlights.length > 0 ? trunkHighlights : closeReading?.highlights ?? [],
) : trunkHighlights;
const sentenceWordCount = sentence?.match(/[A-Za-z]+(?:['’][A-Za-z]+)?/g)?.length ?? 0;
const segmentGuide = closeReading?.segments
  && closeReading.segments.length >= (isBlogExperience ? 2 : 3)
  && sentenceWordCount >= 18
  ? closeReading.segments
  : [];
const hasSegmentGuide = segmentGuide.length > 0;
const translationStep = hasSegmentGuide ? '03' : '02';
const vocabularyStep = hasSegmentGuide ? '04' : '03';
const structureStep = hasSegmentGuide ? '05' : '04';

interface LocatedStructureComponent {
  role: SentenceRole;
  text: string;
  start: number;
  end: number;
  label?: string;
}

interface ReportedQuoteAnalysis {
  highlights: LocatedStructureComponent[];
  trunk: CloseReading['highlights'];
  pattern: string;
  explanation: string;
}

const locateHighlights = (items: CloseReading['highlights']) => {
  if (!sentence) return [];
  const normalizedSentence = normalizeForMatch(sentence).toLowerCase();
  const located: LocatedStructureComponent[] = [];
  let searchFrom = 0;

  for (const item of items) {
    const normalizedText = normalizeForMatch(item.text).toLowerCase();
    let start = normalizedSentence.indexOf(normalizedText, searchFrom);
    if (start === -1) start = normalizedSentence.indexOf(normalizedText);
    if (start === -1) continue;
    const end = start + item.text.length;
    located.push({
      role: item.role,
      text: sentence.slice(start, end),
      start,
      end,
      label: item.label,
    });
    searchFrom = end;
  }
  return located;
};

const buildReportedQuoteAnalysis = (): ReportedQuoteAnalysis | undefined => {
  if (!isBlogExperience || !sentence || !closeReading) return undefined;
  const quoteSpans = Array.from(sentence.matchAll(/“[^”]*”/g), (match) => ({
    start: match.index,
    end: match.index + match[0].length,
    text: match[0],
  }));
  if (quoteSpans.length === 0) return undefined;

  const firstQuote = quoteSpans[0];
  const reportingMatch = Array.from(
    sentence.matchAll(/\b(?:said|says|continued|declared|argued|added|replied|asked|noted)\b/gi),
  ).find((match) => (
    match.index > firstQuote.start
    && !quoteSpans.some((quote) => match.index >= quote.start && match.index < quote.end)
  ));
  if (!reportingMatch) return undefined;

  const reportingStart = reportingMatch.index;
  const reportingEnd = reportingStart + reportingMatch[0].length;
  const locatedHighlights = locateHighlights(
    semanticAnalysis?.highlights ?? closeReading.highlights,
  );
  const outsideQuotes = (item: LocatedStructureComponent) => !quoteSpans.some((quote) => (
    item.start < quote.end && item.end > quote.start
  ));
  const reportingSubject = locatedHighlights
    .filter((item) => item.role === 'subject' && outsideQuotes(item))
    .map((item) => ({
      item,
      distance: item.end <= reportingStart
        ? reportingStart - item.end
        : item.start >= reportingEnd ? item.start - reportingEnd : Number.POSITIVE_INFINITY,
    }))
    .sort((a, b) => a.distance - b.distance)[0]?.item;
  if (!reportingSubject) return undefined;

  const prefixBeforeQuote = sentence.slice(0, firstQuote.start).trimEnd();
  const quoteStartsNewStatement = firstQuote.start === 0 || prefixBeforeQuote.endsWith(',');
  const objectStart = quoteStartsNewStatement ? firstQuote.start : 0;
  const quotesBeforeReporter = quoteSpans.filter((quote) => quote.end <= reportingStart);
  const firstQuoteAfterReporter = quoteSpans.find((quote) => quote.start >= reportingEnd);
  const followingQuoteContinuesStatement = firstQuoteAfterReporter
    && reportingStart > firstQuote.end
    && firstQuoteAfterReporter.start - reportingEnd < 80;
  const directQuoteSpans = followingQuoteContinuesStatement
    ? [...quotesBeforeReporter, firstQuoteAfterReporter]
    : quotesBeforeReporter;
  const lastQuote = directQuoteSpans.at(-1) ?? firstQuote;
  const reporterInterruptsQuote = directQuoteSpans.length > 1
    && reportingStart > directQuoteSpans[0].end
    && reportingStart < lastQuote.start;
  const objectText = reporterInterruptsQuote
    ? directQuoteSpans.map((quote) => quote.text).join(' … ')
    : sentence.slice(objectStart, lastQuote.end);

  const prefixHighlights = objectStart > 0
    ? locatedHighlights.filter((item) => item.end <= objectStart)
    : [];
  const mergedPrefix: LocatedStructureComponent[] = [];
  prefixHighlights.forEach((item) => {
    const previous = mergedPrefix.at(-1);
    if (previous?.role === item.role) {
      previous.text = sentence.slice(previous.start, item.end).replace(/[\s,]+$/, '');
      previous.end = item.end;
    } else {
      mergedPrefix.push({ ...item, text: item.text.replace(/[\s,]+$/, '') });
    }
  });
  mergedPrefix.forEach((item) => {
    item.label = `叙述主句·${roleLabels[item.role]}`;
  });

  const reportSubject: LocatedStructureComponent = {
    ...reportingSubject,
    label: '报道句·主语',
  };
  const reportPredicate: LocatedStructureComponent = {
    role: 'predicate',
    text: sentence.slice(reportingStart, reportingEnd),
    start: reportingStart,
    end: reportingEnd,
    label: '报道句·谓语',
  };
  const reportObject: LocatedStructureComponent = {
    role: 'object',
    text: objectText,
    start: objectStart,
    end: lastQuote.end,
    label: '报道句·宾语（直接引语整体）',
  };
  const reportRows = [reportSubject, reportPredicate, reportObject];
  const suffixHighlights = locatedHighlights
    .filter((item) => (
      outsideQuotes(item)
      && item.start >= reportingEnd
      && item !== reportingSubject
      && !(item.start < reportObject.end && item.end > reportObject.start)
    ))
    .map((item) => ({ ...item, label: `报道句·${roleLabels[item.role]}` }));
  const reporter = reportSubject.text;
  const predicate = reportPredicate.text;

  return {
    highlights: [...mergedPrefix, ...reportRows, ...suffixHighlights],
    trunk: [
      ...mergedPrefix.filter((item) => item.role === 'subject' || item.role === 'predicate')
        .map(({ role, text }) => ({ role, text })),
      { role: 'subject', text: reporter },
      { role: 'predicate', text: predicate },
    ],
    pattern: mergedPrefix.length > 0
      ? '叙述主句 + 引语报道句（SVO）'
      : '主语 + 谓语 + 直接引语宾语（SVO）',
    explanation: `${mergedPrefix.length > 0 ? '前半句先叙述人物经历；随后' : ''}由 ${reporter} + ${predicate} 构成报道句，直接引语整体作 ${predicate} 的宾语，引语内部不再拆分。${suffixHighlights.length > 0 ? '报道句后的分词等成分整体补充说明。' : ''}`,
  };
};

const reportedQuoteAnalysis = buildReportedQuoteAnalysis();

const buildStructureHighlights = () => {
  if (!sentence || !closeReading) return closeReading?.highlights ?? [];
  if (!isBlogExperience) return closeReading.highlights;
  if (reportedQuoteAnalysis) return reportedQuoteAnalysis.highlights;
  if (semanticAnalysis?.highlights.length) {
    return mergePredicateHighlights(semanticAnalysis.highlights);
  }
  if (!closeReading.trunk?.length) return closeReading.highlights;
  const normalizedSentence = normalizeForMatch(sentence);
  const located: LocatedStructureComponent[] = [];
  let searchFrom = 0;

  for (const item of closeReading.trunk) {
    const normalizedPart = normalizeForMatch(item.text);
    let start = normalizedSentence.toLowerCase().indexOf(normalizedPart.toLowerCase(), searchFrom);
    if (start === -1) start = normalizedSentence.toLowerCase().indexOf(normalizedPart.toLowerCase());
    if (start === -1) return closeReading.highlights;
    const end = start + normalizedPart.length;
    searchFrom = end;
    located.push({ role: item.role, text: sentence.slice(start, end), start, end });
  }

  const merged: LocatedStructureComponent[] = [];
  located.forEach((component) => {
    const previous = merged.at(-1);
    if (previous?.role === 'predicate' && component.role === 'predicate') {
      const separator = /^(?:n[’']t\b|'[a-z]+\b|’[a-z]+\b)/i.test(component.text) ? '' : ' ';
      previous.text = `${previous.text}${separator}${component.text}`;
      previous.end = component.end;
    } else {
      merged.push({ ...component });
    }
  });

  const mainPredicate = merged.find((item) => item.role === 'predicate');
  if (mainPredicate) {
    const linkingPredicate = /^(?:am|is|are|was|were|be|been|being|seem(?:s|ed)?|become(?:s|came)?|remain(?:s|ed)?)\b/i
      .test(mainPredicate.text.trim());
    for (const component of merged) {
      if (!['object', 'complement'].includes(component.role) || component.start <= mainPredicate.end) continue;
      const gap = sentence.slice(mainPredicate.end, component.start);
      const clauseMarker = /\b(?:that|whether|if|what|how|why|where|when|who(?:m|se)?|which)\b/i;
      const marker = clauseMarker.exec(gap);
      const componentStartsClause = new RegExp(`^${clauseMarker.source}`, 'i').test(component.text.trim());
      if (!marker && !componentStartsClause) continue;

      const clauseStart = componentStartsClause ? component.start : mainPredicate.end + marker!.index;
      component.text = sentence.slice(clauseStart).replace(/[.!?]\s*$/, '');
      component.start = clauseStart;
      component.end = sentence.length;
      if (linkingPredicate) component.role = 'complement';
      component.label = component.role === 'complement' ? '表语从句（整体）' : '宾语从句（整体）';
      break;
    }
  }

  return merged;
};

const structureHighlights = buildStructureHighlights();
const visibleTrunk = reportedQuoteAnalysis?.trunk ?? mergedTrunk;
const structurePattern = reportedQuoteAnalysis?.pattern
  ?? semanticAnalysis?.pattern
  ?? closeReading?.structure.pattern;
const fallbackStructureExplanation = (
  closeReading?.structure.explanation
    .replace(/^主干可先读作[“"].+?[”"]。?/, '')
    .trim()
  || closeReading?.structure.explanation
);
const structureExplanation = reportedQuoteAnalysis?.explanation
  ?? semanticAnalysis?.explanation
  ?? fallbackStructureExplanation;
---

<div
  class:list={['sentence-note', closeReading && 'has-close-reading']}
  data-sentence-note={closeReading ? true : undefined}
  data-note-number={number}
>
  <span class="sentence-number" aria-hidden="true">{number}</span>
  <div class="sentence-content">
    <div
      class="sentence-original"
      role={sentence ? 'group' : undefined}
      aria-label={sentence ? `${number}. ${sentence}` : undefined}
    >
      {sentence ? (
        <span class="sentence-text" lang="en">
          {sentenceRender.map((group) => {
            const content = group.segments.map((segment) => segment.role ? (
              <span class={`grammar-role grammar-${segment.role}`}>{segment.text}</span>
            ) : segment.text);
            return group.glossary ? (
              <button
                class="inline-glossary-term"
                type="button"
                data-glossary-term={group.glossary.term}
                data-glossary-meaning={group.glossary.explanation}
                data-glossary-pos={group.glossary.partOfSpeech}
                aria-label={`查看 ${group.glossary.term} 的释义`}
                aria-controls={glossaryId}
                aria-expanded="false"
              >{content}</button>
            ) : content;
          })}
        </span>
      ) : <slot />}
      {closeReading && (
        <button
          class="close-reading-mark"
          type="button"
          aria-expanded="false"
          aria-controls={detailId}
          aria-label="展开精读"
          title="精读"
          data-close-reading-toggle
        >
          <BookOpenText size={14} stroke-width={1.8} aria-hidden="true" />
        </button>
      )}
    </div>

    {closeReading && (
      <>
        <div
          class="close-reading-detail"
          id={detailId}
          aria-hidden="true"
          lang="zh-CN"
          data-close-reading-detail
        >
          <div class="close-reading-detail-inner" data-close-reading-detail-inner></div>
        </div>
        <template data-close-reading-template>
          <section class="close-reading-block trunk-block">
            <p class="close-reading-label"><span>01</span>先抓一句话主干</p>
            <div class="sentence-trunk" lang="en">
              {visibleTrunk.map((item) => (
                <span class={`grammar-role grammar-${item.role}`}>
                  <small>{roleHelp[item.role]}</small>{item.text}
                </span>
              ))}
            </div>
            <p class="beginner-tip">先只读这些核心成分，再回到上方原句补上时间、原因、条件和修饰信息。</p>
          </section>

          {hasSegmentGuide && (
            <section class="close-reading-block segments-block">
              {isBlogExperience ? (
                <>
                  <p class="close-reading-label"><span>02</span>中英意群对照</p>
                  <ol class="sense-group-list">
                    {segmentGuide.map((segment, index) => (
                      <li>
                        <span class="sense-group-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                        <span class="sense-group-copy">
                          <span lang="en">{segment.source.trim()}</span>
                          <span lang="zh-CN">{segment.translation.trim()}</span>
                        </span>
                      </li>
                    ))}
                  </ol>
                  <p class="sense-group-tip">按编号依次读英文，再用下一行中文确认这一意群的意思。</p>
                </>
              ) : (
                <>
                  <p class="close-reading-label"><span>02</span>按意群停顿</p>
                  <p class="sense-group-line" lang="en">
                    {segmentGuide.map((segment, index) => (
                      <>
                        <span>{segment.source.trim()}</span>
                        {index < segmentGuide.length - 1 && <i aria-hidden="true">/</i>}
                      </>
                    ))}
                  </p>
                  <p class="sense-group-tip">先按斜线自然停顿读一遍，再看下方整句翻译。</p>
                </>
              )}
            </section>
          )}

          <section class="close-reading-block translation-block">
            <p class="close-reading-label"><span>{translationStep}</span>自然翻译</p>
            <p lang="zh-CN">{closeReading.translation}</p>
          </section>

          <section class="close-reading-block vocabulary-block">
            <p class="close-reading-label"><span>{vocabularyStep}</span>重点单词短语</p>
            <ul lang="zh-CN">
              {closeReading.vocabulary.map((item) => (
                <li><strong>{item.term}</strong><span>{item.explanation}</span></li>
              ))}
            </ul>
          </section>

          <section class="close-reading-block structure-block">
            <p class="close-reading-label"><span>{structureStep}</span>完整句子结构</p>
            <p class="sentence-pattern">{structurePattern}</p>
            <p lang="zh-CN">{structureExplanation}</p>
            <div class="structure-rows">
              {structureHighlights.map((item) => (
                <div class={`structure-row role-${item.role}`}>
                  <span><i aria-hidden="true"></i>{item.label ?? roleLabels[item.role]}<small>{roleHelp[item.role]}</small></span>
                  <code lang="en">{item.text}</code>
                </div>
              ))}
            </div>
            <ul class="role-legend" aria-label="句子成分颜色">
              {[...new Set(structureHighlights.map((item) => item.role))].map((role) => (
                <li class={`role-${role}`}><span aria-hidden="true"></span>{roleLabels[role]}</li>
              ))}
            </ul>
          </section>
        </template>
      </>
    )}
  </div>
</div>

<script>
  let activeGlossaryPopover: HTMLElement | null = null;
  let activeGlossaryButton: HTMLButtonElement | null = null;

  const closeActiveGlossary = () => {
    activeGlossaryPopover?.setAttribute('aria-hidden', 'true');
    activeGlossaryButton?.setAttribute('aria-expanded', 'false');
    activeGlossaryPopover = null;
    activeGlossaryButton = null;
  };

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest?.('[data-glossary-term]')) closeActiveGlossary();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeActiveGlossary();
  });
  window.addEventListener('resize', closeActiveGlossary);
  window.addEventListener('scroll', closeActiveGlossary, { passive: true, capture: true });

  const hydrateCloseReading = (note: HTMLElement) => {
    const detailInner = note.querySelector<HTMLElement>('[data-close-reading-detail-inner]');
    const template = note.querySelector<HTMLTemplateElement>('[data-close-reading-template]');
    if (!detailInner || !template) return;
    detailInner.append(template.content.cloneNode(true));
    template.remove();
  };

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const toggle = target.closest<HTMLButtonElement>('[data-close-reading-toggle]');
    if (toggle) {
      const note = toggle.closest<HTMLElement>('[data-sentence-note]');
      const detail = note?.querySelector<HTMLElement>('[data-close-reading-detail]');
      if (!note || !detail) return;
      closeActiveGlossary();
      hydrateCloseReading(note);
      const open = !note.hasAttribute('data-open');
      note.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '收起精读' : '展开精读');
      detail.setAttribute('aria-hidden', String(!open));
      return;
    }

    const button = target.closest<HTMLButtonElement>('[data-glossary-term]');
    if (!button) return;
    event.stopPropagation();
    const note = button.closest<HTMLElement>('[data-sentence-note]');
    if (!note || note.hasAttribute('data-open')) return;
    if (activeGlossaryButton === button) {
      closeActiveGlossary();
      return;
    }

    const glossaryPopover = document.querySelector<HTMLElement>('[data-inline-glossary-popover]');
    const glossaryTerm = glossaryPopover?.querySelector<HTMLElement>('[data-inline-glossary-term]');
    const glossaryPos = glossaryPopover?.querySelector<HTMLElement>('[data-inline-glossary-pos]');
    const glossaryMeaning = glossaryPopover?.querySelector<HTMLElement>('[data-inline-glossary-meaning]');
    if (!glossaryPopover || !glossaryTerm || !glossaryPos || !glossaryMeaning) return;

    closeActiveGlossary();
    glossaryTerm.textContent = button.dataset.glossaryTerm ?? '';
    glossaryPos.textContent = button.dataset.glossaryPos ?? '';
    glossaryMeaning.textContent = button.dataset.glossaryMeaning ?? '';
    glossaryPopover.setAttribute('aria-hidden', 'false');
    button.setAttribute('aria-expanded', 'true');
    activeGlossaryPopover = glossaryPopover;
    activeGlossaryButton = button;

    const buttonRect = button.getBoundingClientRect();
    const maxLeft = Math.max(8, window.innerWidth - glossaryPopover.offsetWidth - 8);
    const left = Math.min(Math.max(8, buttonRect.left), maxLeft);
    const roomBelow = buttonRect.bottom + glossaryPopover.offsetHeight + 18 <= window.innerHeight;
    const top = roomBelow
      ? buttonRect.bottom + 10
      : Math.max(8, buttonRect.top - glossaryPopover.offsetHeight - 10);
    glossaryPopover.style.left = `${left}px`;
    glossaryPopover.style.top = `${top}px`;
  });
</script>

<style>
  .sentence-note {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 24px 0 26px;
    border-top: 1px solid #e0e4e1;
  }

  .sentence-number {
    padding-top: 4px;
    color: #707873;
    font-family: 'Inter Variable', Inter, sans-serif;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .sentence-content {
    position: relative;
    min-width: 0;
  }

  .sentence-original {
    color: #17201c;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.18rem;
    font-weight: 450;
    line-height: 1.7;
  }

  .sentence-original :global(p) { margin: 0; }

  .has-close-reading .sentence-original :global(p) { display: inline; }

  .inline-glossary-term {
    display: inline;
    margin: 0;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    line-height: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 140ms ease, box-shadow 140ms ease, color 140ms ease;
  }

  .inline-glossary-term:hover,
  .inline-glossary-term:focus-visible {
    color: #17201c;
    background: #eef2ef;
    box-shadow: 0 1px 0 #aebbb2;
    outline: none;
  }

  [data-open] .inline-glossary-term {
    background: transparent;
    box-shadow: none;
    pointer-events: none;
  }

  :global(.inline-glossary-popover) {
    position: fixed;
    z-index: 120;
    display: grid;
    gap: 5px;
    width: max-content;
    max-width: min(320px, calc(100% - 16px));
    padding: 9px 11px 10px;
    border: 1px solid #e2ce91;
    border-radius: 8px;
    color: #3c3522;
    background: #fffdf5;
    box-shadow: 0 9px 24px rgba(69, 57, 22, 0.16);
    font-family: 'Inter Variable', Inter, sans-serif;
    pointer-events: none;
    transform-origin: top left;
    transition: opacity 120ms ease, transform 120ms ease;
  }

  :global(.inline-glossary-popover-head) {
    display: flex;
    gap: 7px;
    align-items: baseline;
  }

  :global(.inline-glossary-popover[aria-hidden='true']) {
