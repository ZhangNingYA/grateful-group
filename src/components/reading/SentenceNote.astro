---
import { BookOpenText, X } from 'lucide-astro';
import { sentenceCloseReadings, type SentenceRole } from '../../data/reading/2025-12-cet6-1';

interface Props {
  number: string;
}

const { number } = Astro.props;
const closeReading = sentenceCloseReadings[number];

if (!closeReading) {
  throw new Error(`Missing close-reading data for sentence ${number}`);
}

const highlightRoles: Record<SentenceRole, string[]> = {
  subject: closeReading.highlights?.subject ?? closeReading.roles.subject,
  predicate: closeReading.highlights?.predicate ?? closeReading.roles.predicate,
  object: closeReading.highlights?.object ?? closeReading.roles.object,
};

const detailId = `close-reading-${number.toLowerCase()}`;
---

<div
  class="sentence-note"
  data-sentence-note
  data-highlight-roles={JSON.stringify(highlightRoles)}
>
  <span class="sentence-number" aria-hidden="true">{number}</span>
  <div class="sentence-content">
    <div class="sentence-row">
      <div class="sentence-original"><slot /></div>
      <button
        class="sentence-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={detailId}
        aria-label={`Open close reading for ${number}`}
        title="Open close reading"
        data-sentence-toggle
      >
        <span class="toggle-open" aria-hidden="true"><BookOpenText size={16} stroke-width={1.8} /></span>
        <span class="toggle-close" aria-hidden="true"><X size={16} stroke-width={1.8} /></span>
      </button>
    </div>

    <div class="sentence-detail" id={detailId} aria-hidden="true" data-sentence-detail>
      <div class="sentence-detail-inner">
        <div class="translation-line">
          <span class="detail-label">翻译</span>
          <p lang="zh-CN">{closeReading.translation}</p>
        </div>

        <div class="reading-facts">
          <div class="vocabulary-line">
            <span class="detail-label">重点</span>
            <ul lang="zh-CN">
              {closeReading.vocabulary.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <dl class="sentence-roles" lang="zh-CN">
            <div class="role-subject-item">
              <dt><span aria-hidden="true"></span>主语</dt>
              <dd>{closeReading.roles.subject.join(' / ')}</dd>
            </div>
            <div class="role-predicate-item">
              <dt><span aria-hidden="true"></span>谓语</dt>
              <dd>{closeReading.roles.predicate.join(' / ')}</dd>
            </div>
            <div class="role-object-item">
              <dt><span aria-hidden="true"></span>宾语</dt>
              <dd>{closeReading.roles.object.join(' / ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  type HighlightRole = 'subject' | 'predicate' | 'object';
  type HighlightMatch = { start: number; end: number; role: HighlightRole };

  const normalizeForMatch = (value: string) => value
    .replace(/[‘’]/g, "'")
    .replace(/[“”]/g, '"');

  const prepareHighlights = (note: HTMLElement) => {
    const original = note.querySelector<HTMLElement>('.sentence-original p');
    if (!original || original.dataset.highlighted === 'true') return;

    const sourceText = original.textContent ?? '';
    const normalizedSource = normalizeForMatch(sourceText);
    const roles = JSON.parse(note.dataset.highlightRoles ?? '{}') as Record<HighlightRole, string[]>;
    const matches: HighlightMatch[] = [];
    const missing: string[] = [];

    (['subject', 'predicate', 'object'] as HighlightRole[]).forEach((role) => {
      let searchFrom = 0;
      (roles[role] ?? []).forEach((value) => {
        if (!value || value === '—' || value.startsWith('(')) return;

        const normalizedValue = normalizeForMatch(value);
        const start = normalizedSource.indexOf(normalizedValue, searchFrom);
        if (start === -1) {
          missing.push(`${role}:${value}`);
          return;
        }

        matches.push({ start, end: start + normalizedValue.length, role });
        searchFrom = start + normalizedValue.length;
      });
    });

    matches.sort((a, b) => a.start - b.start || b.end - a.end);
    const nonOverlapping = matches.filter((match, index, all) => (
      index === 0 || match.start >= all[index - 1].end
    ));
    const fragment = document.createDocumentFragment();
    let cursor = 0;

    nonOverlapping.forEach((match) => {
      if (match.start > cursor) fragment.append(sourceText.slice(cursor, match.start));
      const span = document.createElement('span');
      span.className = `grammar-role grammar-${match.role}`;
      span.textContent = sourceText.slice(match.start, match.end);
      fragment.append(span);
      cursor = match.end;
    });

    if (cursor < sourceText.length) fragment.append(sourceText.slice(cursor));
    original.replaceChildren(fragment);
    original.dataset.highlighted = 'true';
    if (missing.length) note.dataset.highlightMissing = missing.join('|');
  };

  document.querySelectorAll<HTMLElement>('[data-sentence-note]').forEach((note) => {
    const toggle = note.querySelector<HTMLButtonElement>('[data-sentence-toggle]');
    const detail = note.querySelector<HTMLElement>('[data-sentence-detail]');
    if (!toggle || !detail) return;

    prepareHighlights(note);
    toggle.addEventListener('click', () => {
      const open = !note.hasAttribute('data-open');
      note.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', `${open ? 'Close' : 'Open'} close reading`);
      toggle.setAttribute('title', `${open ? 'Close' : 'Open'} close reading`);
      detail.setAttribute('aria-hidden', String(!open));
    });
  });
</script>

<style>
  .sentence-note {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;
    padding: 24px 0 26px;
    border-top: 1px solid #e0e4e1;
  }

  .sentence-number {
    padding-top: 4px;
    color: #707873;
    font-family: 'Inter Variable', Inter, sans-serif;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .sentence-content { min-width: 0; }

  .sentence-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px;
    gap: 14px;
    align-items: end;
  }

  .sentence-original {
    min-width: 0;
    color: #17201c;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.18rem;
    font-weight: 450;
    line-height: 1.7;
  }

  .sentence-original :global(p) { margin: 0; }

  .sentence-toggle {
    display: grid;
    width: 30px;
    height: 30px;
    margin-bottom: 2px;
    padding: 0;
    place-items: center;
    border: 1px solid #cfd5d1;
    border-radius: 50%;
    color: #646d68;
    background: transparent;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }

  .sentence-toggle:hover {
    border-color: #7d8781;
    color: #17201c;
    background: #eef1ee;
  }

  .sentence-toggle:focus-visible {
    outline: 3px solid rgba(49, 95, 155, 0.22);
    outline-offset: 3px;
  }

  .toggle-open,
  .toggle-close { display: grid; place-items: center; }
  .toggle-close { display: none; }

  [data-open] .sentence-toggle {
    border-color: #17201c;
    color: #fff;
    background: #17201c;
  }

  [data-open] .toggle-open { display: none; }
  [data-open] .toggle-close { display: grid; }

  .sentence-detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 220ms ease, opacity 160ms ease;
  }

  .sentence-detail-inner {
    min-height: 0;
    overflow: hidden;
  }

  [data-open] .sentence-detail {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .translation-line {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 14px;
    margin-top: 18px;
    padding: 17px 18px 16px;
    border-top: 1px solid #d6dcd8;
    background: #f1f4f1;
  }

  .detail-label {
    padding-top: 2px;
    color: #727b76;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .translation-line p {
    margin: 0;
    color: #29322d;
    font-size: 0.92rem;
    line-height: 1.72;
  }

  .reading-facts {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 28px;
    padding: 0 18px 18px 86px;
    border-bottom: 1px solid #d6dcd8;
    background: #f1f4f1;
  }

  .vocabulary-line {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 14px;
    margin-left: -68px;
    padding-top: 4px;
  }

  .vocabulary-line ul {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vocabulary-line li {
    color: #5e6762;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .vocabulary-line li::before {
    color: #a3aaa6;
    content: '· ';
  }

  .sentence-roles {
    display: grid;
    gap: 7px;
    margin: 2px 0 0;
  }

  .sentence-roles > div {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 8px;
  }

  .sentence-roles dt {
    display: flex;
    gap: 7px;
    align-items: baseline;
    color: #727b76;
    font-size: 0.68rem;
    font-weight: 650;
  }

  .sentence-roles dt span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .role-subject-item dt { color: #26705c; }
  .role-predicate-item dt { color: #315f9b; }
  .role-object-item dt { color: #966226; }

  .sentence-roles dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: #4f5853;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  [data-open] .sentence-original :global(.grammar-role) {
    border-radius: 2px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: color 180ms ease, background-color 180ms ease;
  }

  [data-open] .sentence-original :global(.grammar-subject) {
    color: #17624e;
    background: rgba(38, 112, 92, 0.1);
  }

  [data-open] .sentence-original :global(.grammar-predicate) {
    color: #28558e;
    background: rgba(49, 95, 155, 0.1);
  }

  [data-open] .sentence-original :global(.grammar-object) {
    color: #87551e;
    background: rgba(150, 98, 38, 0.1);
  }

  @media (max-width: 720px) {
    .sentence-note {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 8px;
      padding: 20px 0 22px;
    }

    .sentence-row {
      grid-template-columns: minmax(0, 1fr) 30px;
      gap: 8px;
    }

    .sentence-original { font-size: 1.05rem; }

    .sentence-toggle {
      width: 28px;
      height: 28px;
    }

    .translation-line {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 8px;
      padding: 15px 12px 13px;
    }

    .translation-line p { font-size: 0.86rem; }

    .reading-facts {
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 0 12px 16px 62px;
    }

    .vocabulary-line {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 8px;
      margin-left: -50px;
    }

    .vocabulary-line ul { display: grid; gap: 3px; }

    .sentence-roles > div {
      grid-template-columns: 48px minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sentence-toggle,
    .sentence-detail,
    [data-open] .sentence-original :global(.grammar-role) { transition: none; }
  }
</style>
