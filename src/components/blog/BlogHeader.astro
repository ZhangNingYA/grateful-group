---
import { Menu, X } from 'lucide-astro';
import TendWordmark from '../TendWordmark.astro';

interface Props {
  active?: 'works' | 'reading' | 'study' | 'papers' | 'about';
  theme?: 'light' | 'dark';
}

const { active, theme = 'light' } = Astro.props;
---

<header class:list={['site-header', theme === 'dark' && 'theme-dark']} data-site-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Tend home">
      <TendWordmark />
    </a>

    <nav id="primary-navigation" class="site-nav" aria-label="Primary navigation">
      <a href="/works/" aria-current={active === 'works' ? 'page' : undefined}>Projects</a>
      <a href="/blog/" aria-current={active === 'reading' ? 'page' : undefined}>Reading</a>
      <a href="/study/" aria-current={active === 'study' ? 'page' : undefined}>Study</a>
      <a href="/papers/" aria-current={active === 'papers' ? 'page' : undefined}>Papers</a>
      <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
      data-menu-toggle
    >
      <span class="menu-open-icon" aria-hidden="true"><Menu size={20} stroke-width={1.8} /></span>
      <span class="menu-close-icon" aria-hidden="true"><X size={20} stroke-width={1.8} /></span>
    </button>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = header.querySelector<HTMLElement>('#primary-navigation');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    window.matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #dfe3e0;
    background: rgba(247, 248, 245, 0.93);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    width: min(1160px, calc(100% - 48px));
    min-height: 62px;
    margin: 0 auto;
    display: flex;
    align-items: center;
  }

  .brand {
    display: inline-flex;
    width: max-content;
    align-items: center;
    color: #19201c;
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .brand:hover { color: #3e4842; }

  .site-nav {
    display: flex;
    min-height: 62px;
    align-items: stretch;
    gap: 28px;
    margin-left: auto;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: #68706b;
    font-family: 'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-nav a::after {
    position: absolute;
    bottom: -1px;
    left: 50%;
    width: 18px;
    height: 2px;
    border-radius: 99px;
    background: #d9654b;
    content: '';
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: #19201c;
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: translateX(-50%) scaleX(1);
  }

  .menu-toggle {
    width: 34px;
    height: 34px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #68706b;
    background: transparent;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .menu-toggle:hover {
    color: #19201c;
    background: #ecefeb;
  }

  .menu-toggle {
    display: none;
    padding: 0;
    cursor: pointer;
  }

  .menu-open-icon,
  .menu-close-icon {
    display: grid;
    place-items: center;
  }

  .menu-close-icon { display: none; }

  .site-header.theme-dark {
    border-bottom-color: rgba(190, 213, 255, 0.16);
    background: rgba(8, 11, 18, 0.9);
  }

  .theme-dark .brand { color: #eef4ff; }
  .theme-dark .brand:hover { color: #ffd8cf; }
  .theme-dark .site-nav a,
  .theme-dark .menu-toggle { color: #aebbd2; }
  .theme-dark .site-nav a:hover,
  .theme-dark .site-nav a[aria-current='page'],
  .theme-dark .menu-toggle:hover { color: #ffffff; }
  .theme-dark .menu-toggle:hover { background: rgba(255, 255, 255, 0.08); }

  :is(.brand, .site-nav a, .menu-toggle):focus-visible {
    outline: 3px solid rgba(217, 101, 75, 0.3);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .header-inner {
      width: calc(100% - 32px);
      min-height: 58px;
      justify-content: space-between;
    }

    .brand { font-size: 1.375rem; }

    .menu-toggle { display: grid; }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      min-height: 0;
      gap: 0;
      margin: 0;
      padding: 8px 24px 16px;
      border-bottom: 1px solid #dfe3e0;
      background: #f7f8f5;
      box-shadow: 0 18px 34px rgba(25, 32, 28, 0.08);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    }

    .site-header.is-menu-open .site-nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .site-header.is-menu-open .menu-open-icon { display: none; }
    .site-header.is-menu-open .menu-close-icon { display: grid; }

    .site-nav a {
      display: flex;
      min-height: 48px;
      justify-content: space-between;
      border-top: 1px solid #e4e8e4;
      font-size: 1rem;
    }

    .site-nav a::after {
      right: 2px;
      bottom: 50%;
      left: auto;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      transform: translateY(50%) scale(0);
    }

    .site-nav a:hover::after,
    .site-nav a[aria-current='page']::after {
      transform: translateY(50%) scale(1);
    }

    .theme-dark .site-nav {
      border-bottom-color: rgba(190, 213, 255, 0.16);
      background: #080b12;
      box-shadow: 0 18px 34px rgba(0, 0, 0, 0.28);
    }

    .theme-dark .site-nav a { border-top-color: rgba(190, 213, 255, 0.14); }
  }
</style>
