---
interface Props {
  active?: 'works' | 'journal' | 'papers' | 'about';
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Quiet Lab 首页">
      <span class="brand-mark" aria-hidden="true">QL</span>
      <span>Quiet Lab</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a href="/works/" aria-current={active === 'works' ? 'page' : undefined}>Works</a>
      <a href="/blog/" aria-current={active === 'journal' ? 'page' : undefined}>Journal</a>
      <a href="/papers/" aria-current={active === 'papers' ? 'page' : undefined}>Papers</a>
      <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
    </nav>

    <a class="rss-link" href="/rss.xml" aria-label="订阅 RSS" title="订阅 RSS">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #dfe3e8;
    background: rgba(248, 249, 247, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    width: min(1160px, calc(100% - 48px));
    min-height: 64px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 10px;
    color: #17201c;
    font-size: 0.94rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 6px;
    background: #17201c;
    color: #f8f9f7;
    font-size: 0.66rem;
    letter-spacing: 0;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    align-self: stretch;
    gap: 24px;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: #626b66;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: #e06b4f;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 160ms ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: #17201c;
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .rss-link {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    justify-self: end;
    border: 1px solid #d7dcd8;
    border-radius: 50%;
    color: #4f5953;
    background: #fff;
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .rss-link:hover {
    border-color: #9ea7a1;
    color: #17201c;
    transform: translateY(-1px);
  }

  .rss-link svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  :is(.brand, .site-nav a, .rss-link):focus-visible {
    outline: 3px solid rgba(224, 107, 79, 0.3);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .header-inner {
      width: min(100% - 32px, 1160px);
      min-height: 58px;
      grid-template-columns: 1fr auto;
      gap: 16px;
    }

    .site-nav {
      order: 3;
      grid-column: 1 / -1;
      width: 100%;
      min-height: 42px;
      justify-content: space-between;
      gap: 12px;
      border-top: 1px solid #e6e9e6;
    }

    .site-nav a {
      justify-content: center;
      flex: 1;
      font-size: 0.76rem;
    }
  }
</style>
