---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'learning'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, headings = [] } = Astro.props;
const { hideHeader = false } = Astro.props;
const { hideTopbar = false } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Noto+Serif+SC:wght@400;500;600&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    {!hideTopbar && (
      <header class="topbar">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <span class="brand-core"></span>
          </span>
          <span class="brand-text">Quiet Lab</span>
        </a>
        <nav class="topnav" aria-label="Primary navigation">
          <a href="/works/"><span>Works</span></a>
          <a href="/blog/"><span>Journal</span></a>
          <a href="/papers/"><span>Papers</span></a>
          <a href="/about/"><span>About</span></a>
        </nav>
        <div class="status">
          <span class="status-dot"></span>
          <span class="status-text">Open · {year}</span>
        </div>
      </header>
    )}

    <main class:list={['page', hideTopbar && 'page-no-topbar']}>
      {hideTopbar && (
        <a href="/learning/" class="back-btn" aria-label="返回 Learning">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </a>
      )}
      {!hideHeader && (
        <header class="article-header">
          <div class="article-meta">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="meta-sep">·</span>
              <span>更新于 <FormattedDate date={updatedDate} /></span>
            )}
          </div>
          <h1 class="article-title">{title}</h1>
          {description && <p class="article-desc">{description}</p>}
        </header>
      )}

      <article class="article-body">
        <slot />
      </article>

      <footer class="article-footer">
        <a href="/learning/" class="footer-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          返回 Learning
        </a>
      </footer>
    </main>

    {headings.length > 0 && <TableOfContents headings={headings} />}
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #f6f0e6;
    color: #24211d;
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  .topbar {
    position: sticky;
    top: 12px;
    z-index: 100;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 10px 16px;
    background: rgba(255, 253, 248, 0.84);
    border: 1px solid #e8ddcb;
    border-radius: 999px;
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    box-shadow: 0 8px 24px rgba(74, 55, 40, 0.06), 0 1px 0 rgba(74, 55, 40, 0.04);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-left: 6px;
    color: #24211d;
    font-weight: 650;
    font-size: 1.02rem;
    text-decoration: none;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #9f6047 70%);
    box-shadow: 0 0 0 3px rgba(159, 96, 71, 0.14);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-core {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
  }

  .topnav {
    display: flex;
    gap: 6px;
    justify-self: center;
  }

  .topnav a {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #766b60;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .topnav a:hover {
    color: #24211d;
    background: rgba(159, 96, 71, 0.08);
    transform: translateY(-1px);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
    font-size: 0.74rem;
    color: #766b60;
    padding: 6px 12px;
    border: 1px solid #e8ddcb;
    border-radius: 999px;
    background: #fff;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #9f6047;
    box-shadow: 0 0 0 3px rgba(159, 96, 71, 0.14);
  }

  .page {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 58px 42px 92px;
  }

  .page-no-topbar {
    padding-top: 34px;
  }

  .back-btn {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fffdf8;
    border: 1px solid #e8ddcb;
    color: #9f6047;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(74, 55, 40, 0.08);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .back-btn:hover {
    border-color: #d7c3aa;
    box-shadow: 0 4px 16px rgba(74, 55, 40, 0.14);
    transform: scale(1.05);
  }

  .article-header {
    margin: 0 auto 44px;
    padding: 0 0 30px;
    max-width: 760px;
    border-bottom: 1px solid #e8ddcb;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.8rem;
    color: #9c8f80;
  }

  .meta-sep { color: #cfc2b2; }

  .article-title {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    font-weight: 650;
    letter-spacing: 0;
    color: #24211d;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .article-desc {
    font-size: 0.95rem;
    color: #6b6258;
    line-height: 1.75;
    max-width: 700px;
  }

  .article-body {
    animation: fade-in 0.5s ease both;
    max-width: 760px;
    margin: 0 auto;
  }

  :global(.article-body > :first-child) { margin-top: 0; }

  :global(.article-body p) {
    margin: 1.1rem 0;
    font-size: 0.96rem;
    line-height: 1.85;
    color: #3b342e;
  }

  :global(.article-body h2) {
    margin: 2.8rem 0 0.9rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #24211d;
    letter-spacing: 0;
    line-height: 1.3;
    padding-bottom: 8px;
    border-bottom: 1px solid #e8ddcb;
  }

  :global(.article-body h3) {
    margin: 2rem 0 0.7rem;
    font-size: clamp(1.08rem, 2.2vw, 1.3rem);
    font-weight: 650;
    color: #3a332d;
    line-height: 1.35;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 1rem 0;
    padding-left: 1.4rem;
    color: #3b342e;
  }

  :global(.article-body li) {
    margin: 0.35rem 0;
    line-height: 1.8;
    font-size: 0.95rem;
  }

  :global(.article-body li::marker) { color: #9f6047; }
  :global(.article-body strong) { color: #24211d; font-weight: 600; }

  :global(.article-body a) {
    color: #9f6047;
    text-decoration: none;
    border-bottom: 1px solid rgba(63, 143, 98, 0.25);
    transition: all 0.15s ease;
  }

  :global(.article-body a:hover) {
    color: #7f4b37;
    border-bottom-color: rgba(127, 75, 55, 0.5);
  }

  :global(.article-body blockquote) {
    margin: 1.4rem 0;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid #c49a68;
    border-radius: 0 10px 10px 0;
    background: #fbf7ef;
    color: #5c5248;
    font-size: 0.93rem;
  }

  :global(.article-body blockquote p) {
    margin: 0.3rem 0;
    color: #5c5248;
  }

  :global(.article-body hr) {
    margin: 2.4rem 0;
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e8ddcb, transparent);
  }

  :global(.article-body img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border-radius: 12px;
    border: 1px solid #e8ddcb;
    box-shadow: 0 2px 16px rgba(74, 55, 40, 0.04);
  }

  :global(.article-body pre) {
    margin: 1.3rem 0;
    padding: 1rem 1.2rem;
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid #e8ddcb;
    background: #fffdf8;
    box-shadow: 0 1px 8px rgba(74, 55, 40, 0.03);
  }

  :global(.article-body code) {
    font-size: 0.86em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  :global(.article-body pre code) { color: #3b342e; }

  :global(.article-body :not(pre) > code) {
    padding: 2px 6px;
    border-radius: 5px;
    background: #f2e7d7;
    color: #9f6047;
    font-size: 0.84em;
  }

  :global(.article-body table) {
    width: 100%;
    margin: 1.3rem 0;
    border-collapse: collapse;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e8ddcb;
    font-size: 0.88rem;
    box-shadow: 0 1px 8px rgba(20, 60, 36, 0.03);
  }

  :global(.article-body th),
  :global(.article-body td) {
    padding: 9px 14px;
    text-align: left;
    border-bottom: 1px solid #e8ddcb;
  }

  :global(.article-body th) {
    background: #fbf7ef;
    font-weight: 600;
    color: #3a332d;
    font-size: 0.8rem;
  }

  :global(.article-body td) { color: #5c5248; }
  :global(.article-body tr:last-child td) { border-bottom: none; }

  :global(.article-body .katex-display) {
    margin: 1.4rem 0;
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    border-radius: 10px;
    background: #fbf7ef;
    border: 1px solid #e8ddcb;
  }

  :global(.article-body .katex) { color: #3a332d; }
  :global(.article-body > div) { margin: 2rem 0; }

  .article-footer {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid #e8ddcb;
  }

  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px 8px 12px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #e8ddcb;
    font-size: 0.82rem;
    font-weight: 500;
    color: #9f6047;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 10px rgba(63, 143, 98, 0.06);
  }

  .footer-back:hover {
    border-color: #b7dcc5;
    box-shadow: 0 4px 16px rgba(63, 143, 98, 0.12);
    transform: translateY(-1px);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .topbar {
      grid-template-columns: 1fr auto;
      gap: 12px;
      margin: 12px 14px 0;
      padding: 10px 14px;
    }

    .topnav { display: none; }

    .page { padding: 36px 20px 60px; }
  }

  @media (max-width: 480px) {
    .status .status-text { display: none; }
    .status { padding: 6px; }
    .page { padding: 28px 14px 48px; }
    .article-title { font-size: 1.5rem; }
    :global(.article-body > div) { margin: 1.5rem -6px; }
  }
</style>
