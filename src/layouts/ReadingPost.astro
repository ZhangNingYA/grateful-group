---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PanelLeftClose, PanelLeftOpen } from 'lucide-astro';
import '../styles/reading-post.css';

type ReadingLink = { href: string; title: string };
type Props = {
  title: string;
  description: string;
  pubDate: Date;
  archiveCount?: number;
  previous?: ReadingLink;
  next?: ReadingLink;
  archiveHref?: string;
  archiveLabel?: string;
  allLabel?: string;
  markReadingNav?: boolean;
  showHeader?: boolean;
  metaDescription?: string;
};

const {
  title,
  description,
  pubDate,
  archiveCount,
  previous,
  next,
  archiveHref = '/blog/',
  archiveLabel = archiveCount === undefined
    ? 'Reading / Archive'
    : `Reading / Archive ${String(archiveCount).padStart(2, '0')}`,
  allLabel = 'All reading',
  markReadingNav = true,
  showHeader = true,
  metaDescription = description || `${title} — English reading practice with sentence-by-sentence close reading.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} description={metaDescription} />
  </head>
  <body class:list={['reading-post-page', !showHeader && 'reading-post-page--headerless']}>
    {showHeader && <BlogHeader active={markReadingNav ? 'reading' : undefined} />}

    <main class="reading-post-shell">
      <header class="reading-post-header">
        <a class="reading-back" href={archiveHref}>{archiveLabel}</a>
        <h1>{title}</h1>
        {description && <p>{description}</p>}
        <div class="reading-post-meta">
          <span><FormattedDate date={pubDate} /></span>
        </div>
      </header>

      <nav class="reading-mobile-toc" aria-label="Page sections" data-reading-toc>
        <a href="#word-bank-cloze" aria-current="location">Cloze</a>
        <a href="#paragraph-matching">Matching</a>
        <a href="#reading-passages">Passages</a>
      </nav>

      <div class="reading-post-grid" data-reading-layout>
        <aside class="reading-post-rail" aria-label="Page sections">
          <button
            class="reading-post-rail-toggle"
            type="button"
            aria-controls="reading-page-sections"
            aria-expanded="true"
            aria-label="Hide contents"
            title="Hide contents"
            data-reading-rail-toggle
          >
            <PanelLeftClose class="rail-toggle-hide-icon" size={15} stroke-width={1.8} aria-hidden="true" />
            <PanelLeftOpen class="rail-toggle-show-icon" size={15} stroke-width={1.8} aria-hidden="true" />
          </button>
          <p>Contents <span>3 sections</span></p>
          <nav id="reading-page-sections" data-reading-toc>
            <a href="#word-bank-cloze" aria-current="location">
              <span>01</span>
              Word Bank Cloze
            </a>
            <a href="#paragraph-matching">
              <span>02</span>
              Paragraph Matching
            </a>
            <a href="#reading-passages">
              <span>03</span>
              Reading Passages
            </a>
          </nav>
        </aside>

        <article class="reading-article">
          <slot />
        </article>
      </div>
    </main>

    <nav class="reading-post-navigation" aria-label="Reading navigation">
      {previous ? (
        <a href={previous.href} rel="prev"><span>Previous</span><strong>{previous.title}</strong></a>
      ) : <span aria-hidden="true"></span>}
      <a class="reading-post-navigation-all" href={archiveHref}>{allLabel}</a>
      {next ? (
        <a href={next.href} rel="next"><span>Next</span><strong>{next.title}</strong></a>
      ) : <span aria-hidden="true"></span>}
    </nav>

    <footer class="reading-post-footer"><span>© {new Date().getFullYear()} Tend</span></footer>

    <div
      class="inline-glossary-popover"
      id="reading-inline-glossary-popover"
      role="status"
      aria-live="polite"
      aria-hidden="true"
      data-inline-glossary-popover
    >
      <span class="inline-glossary-popover-head">
        <strong class="inline-glossary-popover-term" data-inline-glossary-term></strong>
        <span class="inline-glossary-popover-pos" data-inline-glossary-pos></span>
      </span>
      <span class="inline-glossary-popover-meaning" data-inline-glossary-meaning></span>
    </div>

    <script>
      const headings = Array.from(
        document.querySelectorAll<HTMLElement>('.reading-article > h2[id]'),
      );
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-reading-toc] a'),
      );

      const updateCurrentSection = () => {
        if (!headings.length) return;

        let currentId = headings[0].id;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= 150) currentId = heading.id;
        }

        tocLinks.forEach((link) => {
          const isCurrent = link.hash === `#${currentId}`;
          if (isCurrent) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      updateCurrentSection();
      window.addEventListener('scroll', updateCurrentSection, { passive: true });
      window.addEventListener('resize', updateCurrentSection);

      const readingLayout = document.querySelector<HTMLElement>('[data-reading-layout]');
      const railToggle = document.querySelector<HTMLButtonElement>('[data-reading-rail-toggle]');

      railToggle?.addEventListener('click', () => {
        if (!readingLayout) return;

        const collapsed = !readingLayout.hasAttribute('data-rail-collapsed');
        readingLayout.toggleAttribute('data-rail-collapsed', collapsed);
        railToggle.setAttribute('aria-expanded', String(!collapsed));
        railToggle.setAttribute('aria-label', collapsed ? 'Show contents' : 'Hide contents');
        railToggle.setAttribute('title', collapsed ? 'Show contents' : 'Hide contents');
      });

      const readingStateKey = `reading-state:${window.location.pathname}`;
      type ReadingState = {
        scrollY?: number;
        openNotes?: string[];
        answers?: Record<string, string>;
        railCollapsed?: boolean;
      };

      const readState = (): ReadingState => {
        try {
          return JSON.parse(sessionStorage.getItem(readingStateKey) ?? '{}') as ReadingState;
        } catch {
          return {};
        }
      };

      const saveState = () => {
        const openNotes = Array.from(
          document.querySelectorAll<HTMLElement>('[data-sentence-note][data-open]'),
        ).map((note) => note.dataset.noteNumber).filter((number): number is string => Boolean(number));
        const answers = Object.fromEntries(
          Array.from(document.querySelectorAll<HTMLElement>('[data-reading-question][data-answered]'))
            .flatMap((question) => {
              const number = question.dataset.questionNumber;
              const selected = question.querySelector<HTMLElement>('[data-question-option].is-selected')
                ?.dataset.questionOption;
              return number && selected ? [[number, selected]] : [];
            }),
        );

        try {
          sessionStorage.setItem(readingStateKey, JSON.stringify({
            scrollY: window.scrollY,
            openNotes,
            answers,
            railCollapsed: readingLayout?.hasAttribute('data-rail-collapsed') ?? false,
          } satisfies ReadingState));
        } catch {
          // Reading remains fully functional when storage is unavailable.
        }
      };

      let saveFrame = 0;
      const scheduleSave = () => {
        cancelAnimationFrame(saveFrame);
        saveFrame = requestAnimationFrame(saveState);
      };

      document.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (target.closest('[data-close-reading-toggle], [data-question-option], [data-reading-rail-toggle]')) {
          scheduleSave();
        }
      });
      window.addEventListener('pagehide', saveState);

      const savedState = readState();
      if (savedState.railCollapsed && readingLayout && railToggle) railToggle.click();
      savedState.openNotes?.forEach((number) => {
        document.querySelector<HTMLElement>(
          `[data-sentence-note][data-note-number="${CSS.escape(number)}"] [data-close-reading-toggle]`,
        )?.click();
      });
      Object.entries(savedState.answers ?? {}).forEach(([number, answer]) => {
        document.querySelector<HTMLElement>(
          `[data-reading-question][data-question-number="${CSS.escape(number)}"] [data-question-option="${CSS.escape(answer)}"]`,
        )?.click();
      });
      if (!window.location.hash && typeof savedState.scrollY === 'number') {
        requestAnimationFrame(() => requestAnimationFrame(() => window.scrollTo(0, savedState.scrollY ?? 0)));
      }
    </script>
  </body>
</html>
