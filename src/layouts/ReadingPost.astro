---
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/reading-post.css';

type ReadingLink = { href: string; title: string };
type Props = {
  title: string;
  description: string;
  pubDate: Date;
  archiveCount?: number;
  previous?: ReadingLink;
  next?: ReadingLink;
  archiveHref?: string;
  archiveLabel?: string;
  allLabel?: string;
  markReadingNav?: boolean;
  showHeader?: boolean;
};

const {
  title,
  description,
  pubDate,
  archiveCount,
  previous,
  next,
  archiveHref = '/blog/',
  archiveLabel = archiveCount === undefined
    ? 'Reading / Archive'
    : `Reading / Archive ${String(archiveCount).padStart(2, '0')}`,
  allLabel = 'All reading',
  markReadingNav = true,
  showHeader = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} />
  </head>
  <body class:list={['reading-post-page', !showHeader && 'reading-post-page--headerless']}>
    {showHeader && <BlogHeader active={markReadingNav ? 'reading' : undefined} />}

    <main class="reading-post-shell">
      <header class="reading-post-header">
        <a class="reading-back" href={archiveHref}>{archiveLabel}</a>
        <h1>{title}</h1>
        {description && <p>{description}</p>}
        <div class="reading-post-meta">
          <span><FormattedDate date={pubDate} /></span>
        </div>
      </header>

      <nav class="reading-mobile-toc" aria-label="Page sections" data-reading-toc>
        <a href="#word-bank-cloze" aria-current="location">Cloze</a>
        <a href="#paragraph-matching">Matching</a>
        <a href="#reading-passages">Passages</a>
      </nav>

      <div class="reading-post-grid">
        <aside class="reading-post-rail" aria-label="Page sections">
          <p>Contents <span>3 sections</span></p>
          <nav data-reading-toc>
            <a href="#word-bank-cloze" aria-current="location">
              <span>01</span>
              Word Bank Cloze
            </a>
            <a href="#paragraph-matching">
              <span>02</span>
              Paragraph Matching
            </a>
            <a href="#reading-passages">
              <span>03</span>
              Reading Passages
            </a>
          </nav>
        </aside>

        <article class="reading-article">
          <slot />
        </article>
      </div>
    </main>

    <nav class="reading-post-navigation" aria-label="Reading navigation">
      {previous ? (
        <a href={previous.href} rel="prev"><span>Previous</span><strong>{previous.title}</strong></a>
      ) : <span aria-hidden="true"></span>}
      <a class="reading-post-navigation-all" href={archiveHref}>{allLabel}</a>
      {next ? (
        <a href={next.href} rel="next"><span>Next</span><strong>{next.title}</strong></a>
      ) : <span aria-hidden="true"></span>}
    </nav>

    <footer class="reading-post-footer"><span>© {new Date().getFullYear()} Tend</span></footer>

    <script>
      const headings = Array.from(
        document.querySelectorAll<HTMLElement>('.reading-article > h2[id]'),
      );
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-reading-toc] a'),
      );

      const updateCurrentSection = () => {
        if (!headings.length) return;

        let currentId = headings[0].id;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= 150) currentId = heading.id;
        }

        tocLinks.forEach((link) => {
          const isCurrent = link.hash === `#${currentId}`;
          if (isCurrent) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      updateCurrentSection();
      window.addEventListener('scroll', updateCurrentSection, { passive: true });
      window.addEventListener('resize', updateCurrentSection);
    </script>
  </body>
</html>
