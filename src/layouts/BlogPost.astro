---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <!-- 光标跟随 -->
    <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

    <nav class="nav">
      <a href="/blog" class="nav-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Blog
      </a>
    </nav>

    <main class="page">
      <!-- Article Header -->
      <header class="article-header">
        <div class="article-meta">
          <span class="meta-tag">
            <span class="tag-dot"></span>
            Post
          </span>
          <span class="meta-date"><FormattedDate date={pubDate} /></span>
          {updatedDate && (
            <span class="meta-updated">Updated · <FormattedDate date={updatedDate} /></span>
          )}
        </div>

        <h1 class="article-title">{title}</h1>

        {description && (
          <p class="article-desc">{description}</p>
        )}
      </header>

      <!-- Hero Image -->
      {heroImage && (
        <div class="hero-image">
          <Image width={1200} height={630} src={heroImage} alt={title} />
        </div>
      )}

      <!-- Divider -->
      <div class="divider">
        <span class="divider-line"></span>
        <span class="divider-text">正文</span>
        <span class="divider-line"></span>
      </div>

      <!-- Article Body -->
      <article class="article-body">
        <slot />
      </article>

      <!-- Footer -->
      <footer class="article-footer">
        <div class="divider">
          <span class="divider-line"></span>
          <span class="divider-text">End</span>
          <span class="divider-line"></span>
        </div>
        <a href="/blog" class="footer-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          返回文章列表
        </a>
      </footer>
    </main>

    <script>
      const glow = document.getElementById('cursorGlow');
      let mx = 0, my = 0, gx = 0, gy = 0;
      document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
      function tick() {
        gx += (mx - gx) * 0.06;
        gy += (my - gy) * 0.06;
        if (glow) glow.style.transform = `translate(${gx - 250}px, ${gy - 250}px)`;
        requestAnimationFrame(tick);
      }
      tick();
    </script>
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    background: #fafbfd;
    color: #1a1a2e;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* 光标光晕 */
  .cursor-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(99,102,241,0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    top: 0; left: 0;
    will-change: transform;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 20px 24px;
    backdrop-filter: blur(12px);
    background: rgba(250, 251, 253, 0.8);
  }

  .nav-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px 8px 12px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #eef2ff;
    font-size: 0.82rem;
    font-weight: 500;
    color: #6366f1;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 2px 12px rgba(99,102,241,0.06);
  }

  .nav-back:hover {
    border-color: #c7d2fe;
    box-shadow: 0 4px 16px rgba(99,102,241,0.12);
    transform: translateY(-1px);
  }

  /* Page */
  .page {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* Article Header */
  .article-header {
    text-align: center;
    margin-bottom: 36px;
    animation: fade-down 0.7s ease both;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .meta-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px 5px 8px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #eef2ff;
    font-size: 0.75rem;
    font-weight: 500;
    color: #6366f1;
    box-shadow: 0 2px 8px rgba(99,102,241,0.05);
  }

  .tag-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #10b981;
    animation: blink 2s ease-in-out infinite;
  }

  .meta-date,
  .meta-updated {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 400;
  }

  .article-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #0f0f23;
    line-height: 1.2;
    margin-bottom: 14px;
    text-wrap: balance;
  }

  .article-desc {
    font-size: 1.05rem;
    color: #64748b;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto;
  }

  /* Hero Image */
  .hero-image {
    margin-bottom: 32px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04);
    animation: fade-down 0.8s 0.1s ease both;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Divider */
  .divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  .divider-text {
    font-size: 0.72rem;
    font-weight: 500;
    color: #c7d2fe;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Article Body */
  .article-body {
    animation: fade-up 0.8s 0.2s ease both;
  }

  :global(.article-body > :first-child) {
    margin-top: 0;
  }

  :global(.article-body > :last-child) {
    margin-bottom: 0;
  }

  :global(.article-body p) {
    margin: 1.2rem 0;
    font-size: 1.02rem;
    line-height: 1.9;
    color: #374151;
  }

  :global(.article-body h2),
  :global(.article-body h3),
  :global(.article-body h4) {
    margin: 2.4rem 0 0.8rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #0f0f23;
  }

  :global(.article-body h2) {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    padding-bottom: 10px;
    border-bottom: 1px solid #f1f5f9;
  }

  :global(.article-body h3) {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
  }

  :global(.article-body h4) {
    font-size: 1.1rem;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 1.2rem 0;
    padding-left: 1.5rem;
    color: #374151;
  }

  :global(.article-body li) {
    margin: 0.5rem 0;
    line-height: 1.85;
  }

  :global(.article-body strong) {
    color: #0f0f23;
    font-weight: 600;
  }

  :global(.article-body a) {
    color: #6366f1;
    text-decoration: none;
    border-bottom: 1px solid rgba(99,102,241,0.3);
    transition: all 0.25s ease;
  }

  :global(.article-body a:hover) {
    color: #4f46e5;
    border-bottom-color: rgba(79,70,229,0.6);
  }

  :global(.article-body blockquote) {
    margin: 1.6rem 0;
    padding: 1rem 1.2rem;
    border-left: 3px solid #c7d2fe;
    border-radius: 0 12px 12px 0;
    background: #f8faff;
    color: #475569;
  }

  :global(.article-body blockquote p) {
    margin: 0.4rem 0;
    color: #475569;
  }

  :global(.article-body hr) {
    margin: 2.4rem 0;
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  :global(.article-body img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.6rem auto;
    border-radius: 16px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 24px rgba(0,0,0,0.04);
  }

  :global(.article-body pre) {
    margin: 1.4rem 0;
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid #f1f5f9;
    background: #fefeff;
    box-shadow: 0 2px 12px rgba(0,0,0,0.03);
  }

  :global(.article-body code) {
    font-size: 0.9em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  :global(.article-body :not(pre) > code) {
    padding: 2px 7px;
    border-radius: 6px;
    background: #f1f5f9;
    color: #6366f1;
    font-size: 0.88em;
  }

  :global(.article-body table) {
    width: 100%;
    margin: 1.4rem 0;
    border-collapse: collapse;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    box-shadow: 0 2px 12px rgba(0,0,0,0.03);
  }

  :global(.article-body th),
  :global(.article-body td) {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.92rem;
  }

  :global(.article-body th) {
    background: #f8faff;
    font-weight: 600;
    color: #0f0f23;
  }

  :global(.article-body tr:last-child td) {
    border-bottom: none;
  }

  /* Footer */
  .article-footer {
    margin-top: 60px;
  }

  .article-footer .divider {
    margin-bottom: 24px;
  }

  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px 12px 18px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #eef2ff;
    font-size: 0.88rem;
    font-weight: 500;
    color: #6366f1;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 2px 12px rgba(99,102,241,0.06);
  }

  .footer-back:hover {
    border-color: #c7d2fe;
    box-shadow: 0 6px 24px rgba(99,102,241,0.12);
    transform: translateY(-2px);
  }

  /* Animations */
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Responsive */
  @media (max-width: 480px) {
    .page {
      padding: 24px 16px 60px;
    }

    .article-title {
      font-size: 1.7rem;
    }

    .hero-image {
      border-radius: 14px;
    }

    :global(.article-body pre) {
      border-radius: 10px;
      padding: 0.9rem 1rem;
    }

    .cursor-glow {
      display: none;
    }
  }
</style>
