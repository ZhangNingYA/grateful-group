---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'threeD'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, headings = [] } = Astro.props;
const { hideHeader = false, hideTopbar = false } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="scene-bg" aria-hidden="true">
      <span class="grid"></span>
      <span class="panel panel-a"></span>
      <span class="panel panel-b"></span>
    </div>

    {!hideTopbar && (
      <header class="topbar">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>cyan</span>
        </a>
        <nav class="topnav" aria-label="Primary navigation">
          <a href="/works/"><span>Works</span></a>
          <a href="/blog/"><span>Journal</span></a>
          <a href="/papers/"><span>Papers</span></a>
          <a href="/about/"><span>About</span></a>
        </nav>
        <div class="status">
          <span class="status-dot"></span>
          <span>Render · {year}</span>
        </div>
      </header>
    )}

    <main class:list={['page', hideTopbar && 'page-no-topbar']}>
      {hideTopbar && (
        <a href="/threeD/" class="back-btn" aria-label="Back to ThreeD">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </a>
      )}

      {!hideHeader && (
        <header class="article-header">
          <div class="article-meta">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="meta-sep">/</span>
              <span>Updated <FormattedDate date={updatedDate} /></span>
            )}
          </div>
          <h1>{title}</h1>
          {description && <p>{description}</p>}
        </header>
      )}

      <article class="article-body">
        <slot />
      </article>

      <footer class="article-footer">
        <a href="/threeD/" class="footer-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Back to ThreeD
        </a>
      </footer>
    </main>

    {headings.length > 0 && <TableOfContents headings={headings} />}
  </body>
</html>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    min-height: 100vh;
    background: #080b12;
    color: #eef4ff;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  .scene-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 18%, rgba(84, 214, 255, 0.18), transparent 30%),
      radial-gradient(circle at 82% 10%, rgba(255, 183, 91, 0.12), transparent 26%),
      linear-gradient(180deg, #101827 0%, #080b12 48%, #05070c 100%);
  }

  .grid {
    position: absolute;
    inset: -30% -10% 0;
    background-image:
      linear-gradient(rgba(118, 150, 191, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(118, 150, 191, 0.18) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(620px) rotateX(62deg) translateY(18%);
    transform-origin: center bottom;
    opacity: 0.34;
  }

  .panel {
    position: absolute;
    border: 1px solid rgba(190, 213, 255, 0.14);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.02));
  }

  .panel-a {
    width: 220px;
    height: 150px;
    right: 8%;
    top: 18%;
    transform: rotateX(56deg) rotateZ(-18deg);
  }

  .panel-b {
    width: 160px;
    height: 160px;
    left: 8%;
    bottom: 12%;
    transform: rotateX(54deg) rotateZ(24deg);
  }

  .topbar {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin: 14px 24px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 10px 16px;
    border: 1px solid rgba(190, 213, 255, 0.18);
    border-radius: 999px;
    background: rgba(11, 16, 28, 0.72);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(14px) saturate(125%);
  }

  .brand,
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .brand {
    justify-self: start;
    padding-left: 6px;
    font-weight: 700;
  }

  .brand-mark {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: linear-gradient(135deg, #65d6ff, #ffbc67);
    box-shadow: 0 0 24px rgba(101, 214, 255, 0.22);
  }

  .topnav {
    display: flex;
    gap: 6px;
    justify-self: center;
  }

  .topnav a {
    padding: 8px 14px;
    border-radius: 999px;
    color: #aebbd2;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .topnav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }

  .status {
    justify-self: end;
    padding: 6px 12px;
    border: 1px solid rgba(190, 213, 255, 0.16);
    border-radius: 999px;
    color: #aebbd2;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #65d6ff;
    box-shadow: 0 0 14px rgba(101, 214, 255, 0.8);
  }

  .page {
    position: relative;
    z-index: 1;
    width: min(900px, calc(100% - 44px));
    margin: 0 auto;
    padding: 64px 0 88px;
  }

  .page-no-topbar { padding-top: 36px; }

  .back-btn {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 100;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(190, 213, 255, 0.18);
    border-radius: 12px;
    background: rgba(11, 16, 28, 0.76);
    color: #65d6ff;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(12px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .back-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(101, 214, 255, 0.48);
  }

  .article-header {
    max-width: 760px;
    margin: 0 auto 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(190, 213, 255, 0.16);
  }

  .article-meta {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    color: #8fa0bd;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }

  .article-header h1 {
    max-width: 760px;
    margin-bottom: 12px;
    color: #f8fbff;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .article-header p {
    color: #bac7dc;
    font-size: 1rem;
    line-height: 1.75;
  }

  .article-body {
    max-width: 760px;
    margin: 0 auto;
  }

  :global(.article-body p) {
    margin: 1.1rem 0;
    color: #d8e1f1;
    font-size: 1rem;
    line-height: 1.86;
  }

  :global(.article-body h2) {
    margin: 2.6rem 0 0.9rem;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(190, 213, 255, 0.14);
    color: #f8fbff;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.25;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 1rem 0;
    padding-left: 1.35rem;
    color: #d8e1f1;
  }

  :global(.article-body li) {
    margin: 0.45rem 0;
    line-height: 1.8;
  }

  :global(.article-body li::marker) { color: #65d6ff; }
  :global(.article-body strong) { color: #fff; }

  :global(.article-body code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(101, 214, 255, 0.1);
    color: #8de1ff;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84em;
  }

  .article-footer {
    max-width: 760px;
    margin: 58px auto 0;
    padding-top: 20px;
    border-top: 1px solid rgba(190, 213, 255, 0.14);
  }

  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px 8px 11px;
    border: 1px solid rgba(190, 213, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #8de1ff;
    font-size: 0.86rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .topbar {
      grid-template-columns: 1fr auto;
      margin: 12px 14px 0;
      gap: 12px;
    }

    .topnav { display: none; }
    .page { width: min(100% - 32px, 900px); padding: 44px 0 68px; }
  }

  @media (max-width: 480px) {
    .status span:last-child { display: none; }
    .status { padding: 6px; }
    .article-header h1 { font-size: 1.85rem; }
  }
</style>
