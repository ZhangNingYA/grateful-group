---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/editorial.css';

type Props = CollectionEntry<'works'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
  </head>
  <body class="editorial-page works-article-page">
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
    <BlogHeader active="works" />

    <main class="works-page">
      <header class="works-header">
        <a class="back-link" href="/works/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"></path></svg>
          Projects
        </a>
        <div class="works-meta">
          <span>Published <FormattedDate date={pubDate} /></span>
          {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <article class="works-body">
        <slot />
      </article>

      <footer class="works-footer">
        <span>Continue exploring</span>
        <a href="/works/">查看全部 Projects</a>
      </footer>
    </main>

    {headings.length > 0 && <TableOfContents headings={headings} />}

    <script>
      const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
      const updateProgress = () => {
        if (!progressBar) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
        progressBar.style.transform = `scaleX(${progress})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    </script>
  </body>
</html>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 200;
    height: 3px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .works-page {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
    padding-bottom: 72px;
  }

  .works-header {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 0 44px;
    border-bottom: 1px solid var(--ink);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 38px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .back-link svg {
    width: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .works-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .works-header h1 {
    margin: 0 0 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.35rem, 4.6vw, 4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .works-header > p {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .works-body {
    max-width: 720px;
    margin: 0 auto;
    padding: 44px 0 72px;
    color: #2a332e;
    font-size: 1.04rem;
    line-height: 1.9;
  }

  .works-body > :global(p:first-child) {
    margin-bottom: 1.65rem;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.18rem;
    line-height: 1.8;
  }

  .works-body :global(h2),
  .works-body :global(h3) {
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    letter-spacing: 0;
    scroll-margin-top: 92px;
  }

  .works-body :global(h2) {
    position: relative;
    margin: 4rem 0 1.35rem;
    padding-top: 1.55rem;
    border-top: 1px solid var(--line);
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    line-height: 1.2;
  }

  .works-body :global(h2::before) {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 3px;
    background: var(--accent);
  }

  .works-body :global(h3) {
    margin: 2.2rem 0 0.9rem;
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .works-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .works-body :global(a) {
    color: #b64f39;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .works-body :global(strong) {
    color: var(--ink);
  }

  .works-body :global(ul),
  .works-body :global(ol) {
    margin: 0 0 1.7rem;
    padding-left: 1.3rem;
  }

  .works-body :global(li) {
    margin-bottom: 0.65rem;
    padding-left: 0.35rem;
  }

  .works-body :global(li::marker) {
    color: var(--accent);
    font-weight: 700;
  }

  .works-body :global(blockquote) {
    margin: 2.2rem 0;
    padding: 1.15rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: #f0f3f0;
    color: #4f5953;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.14rem;
    line-height: 1.7;
  }

  .works-body :global(blockquote p) {
    margin: 0;
  }

  .works-body :global(pre) {
    margin: 2rem 0;
    padding: 22px 24px;
    overflow-x: auto;
    border: 1px solid #27302b;
    border-radius: 6px;
    background: #17201c;
    color: #edf1ee;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .works-body :global(:not(pre) > code) {
    padding: 0.12em 0.36em;
    border: 1px solid #d8ddd9;
    border-radius: 4px;
    background: #eef1ee;
    font-size: 0.9em;
  }

  .works-body :global(table) {
    display: table;
    width: 100%;
    margin: 2.2rem 0 2.4rem;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .works-body :global(th),
  .works-body :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .works-body :global(th) {
    border-top: 1px solid var(--ink);
    background: #eef1ee;
    color: var(--ink);
    font-weight: 700;
  }

  .works-body :global(td:first-child) {
    color: var(--ink);
    font-weight: 700;
  }

  .works-footer {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--ink);
    color: var(--muted);
    font-size: 0.82rem;
  }

  .works-footer a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .works-page {
      width: min(100% - 32px, 1160px);
    }

    .works-header {
      padding: 44px 0 36px;
    }

    .back-link {
      margin-bottom: 36px;
    }

    .works-header h1 {
      font-size: 2.35rem;
    }

    .works-body {
      padding: 36px 0 56px;
      font-size: 0.98rem;
      line-height: 1.82;
    }

    .works-body > :global(p:first-child) {
      font-size: 1.08rem;
      line-height: 1.72;
    }

    .works-body :global(h2) {
      margin-top: 3.2rem;
    }

    .works-body :global(table) {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    .works-body :global(th),
    .works-body :global(td) {
      padding: 10px 12px;
    }
  }
</style>
