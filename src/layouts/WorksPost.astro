---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'works'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, headings = [] } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a href="/works" class="back-btn" aria-label="返回 Works 列表">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </a>

    <main class="page">
      <header class="article-header">
        <div class="article-meta">
          <span class="meta-tag">Works</span>
          <span class="meta-sep">·</span>
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <>
              <span class="meta-sep">·</span>
              <span>更新于 <FormattedDate date={updatedDate} /></span>
            </>
          )}
        </div>
        <h1 class="article-title">{title}</h1>
        {description && <p class="article-desc">{description}</p>}
      </header>

      <!-- 双栏布局容器 -->
      <div class="content-wrapper">
        <article class="article-body">
          <slot />
        </article>

        <!-- 侧边 TOC -->
        {headings.length > 0 && (
          <aside class="toc-aside">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>

      <footer class="article-footer">
        <a href="/works" class="footer-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          返回 Works 列表
        </a>
      </footer>
    </main>
  </body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #fafbfd;
    color: #1a1a2e;
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* 固定返回按钮 */
  .back-btn {
    position: fixed;
    top: 20px;
    left: 20px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #eef2ff;
    color: #6366f1;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(99, 102, 241, 0.08);
    transition: all 0.2s ease;
  }
  .back-btn:hover {
    border-color: #c7d2fe;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.15);
    transform: scale(1.05);
  }

  /* Page */
  .page {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 36px 80px;
  }

  /* Header */
  .article-header {
    margin-bottom: 40px;
    padding-left: 4px;
    max-width: 1080px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .meta-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: #eef2ff;
    color: #6366f1;
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .meta-sep { color: #cbd5e1; }

  .article-title {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #0f0f23;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .article-desc {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 600px;
  }

  /* 双栏布局 */
  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 48px;
  }

  .toc-aside {
    /* grid stretch（默认）让此列和文章等高，sticky 才有滑动空间 */
  }

  /* Body */
  .article-body {
    min-width: 0;
    animation: fade-in 0.5s ease both;
  }

  :global(.article-body > :first-child) { margin-top: 0; }

  :global(.article-body p) {
    margin: 1.1rem 0;
    font-size: 0.96rem;
    line-height: 1.85;
    color: #374151;
  }

  :global(.article-body h2) {
    margin: 2.8rem 0 0.9rem;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
    color: #0f0f23;
    letter-spacing: -0.02em;
    line-height: 1.3;
    padding-bottom: 8px;
    border-bottom: 1px solid #f1f5f9;
  }

  :global(.article-body h3) {
    margin: 2rem 0 0.7rem;
    font-size: clamp(1.08rem, 2.2vw, 1.3rem);
    font-weight: 650;
    color: #1e293b;
    line-height: 1.35;
  }

  :global(.article-body h4) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: #334155;
  }

  :global(.article-body ul),
  :global(.article-body ol) {
    margin: 1rem 0;
    padding-left: 1.4rem;
    color: #374151;
  }
  :global(.article-body li) {
    margin: 0.35rem 0;
    line-height: 1.8;
    font-size: 0.95rem;
  }
  :global(.article-body li::marker) { color: #c7d2fe; }

  :global(.article-body strong) {
    color: #0f0f23;
    font-weight: 600;
  }

  :global(.article-body a) {
    color: #6366f1;
    text-decoration: none;
    border-bottom: 1px solid rgba(99, 102, 241, 0.25);
    transition: all 0.15s ease;
  }
  :global(.article-body a:hover) {
    color: #4f46e5;
    border-bottom-color: rgba(79, 70, 229, 0.5);
  }

  :global(.article-body blockquote) {
    margin: 1.4rem 0;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid #c7d2fe;
    border-radius: 0 10px 10px 0;
    background: #f8faff;
    color: #475569;
    font-size: 0.93rem;
  }
  :global(.article-body blockquote p) {
    margin: 0.3rem 0;
    color: #475569;
  }

  :global(.article-body hr) {
    margin: 2.4rem 0;
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  :global(.article-body img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem auto;
    border-radius: 12px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
  }

  :global(.article-body pre) {
    margin: 1.3rem 0;
    padding: 1rem 1.2rem;
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid #f1f5f9;
    background: #fafbfd;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
  }

  :global(.article-body code) {
    font-size: 0.86em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }
  :global(.article-body pre code) { color: #334155; }
  :global(.article-body :not(pre) > code) {
    padding: 2px 6px;
    border-radius: 5px;
    background: #f1f5f9;
    color: #6366f1;
    font-size: 0.84em;
  }

  /* 表格 */
  :global(.article-body table) {
    width: 100%;
    margin: 1.3rem 0;
    border-collapse: collapse;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    font-size: 0.88rem;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.03);
  }
  :global(.article-body th),
  :global(.article-body td) {
    padding: 9px 14px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
  }
  :global(.article-body th) {
    background: #f8faff;
    font-weight: 600;
    color: #1e293b;
    font-size: 0.8rem;
  }
  :global(.article-body td) { color: #475569; }
  :global(.article-body tr:last-child td) { border-bottom: none; }

  /* KaTeX */
  :global(.article-body .katex-display) {
    margin: 1.4rem 0;
    padding: 0.9rem 1.1rem;
    overflow-x: auto;
    border-radius: 10px;
    background: #f8faff;
    border: 1px solid #eef2ff;
  }
  :global(.article-body .katex) { color: #1e293b; }

  /* R3F / interactive container — let the component decide */
  :global(.article-body > div) { margin: 2rem 0; }

  /* Footer */
  .article-footer {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
  }
  .footer-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px 8px 12px;
    border-radius: 100px;
    background: #fff;
    border: 1px solid #eef2ff;
    font-size: 0.82rem;
    font-weight: 500;
    color: #6366f1;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 10px rgba(99, 102, 241, 0.06);
  }
  .footer-back:hover {
    border-color: #c7d2fe;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.12);
    transform: translateY(-1px);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .toc-aside {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .page { padding: 36px 20px 60px; }
    .back-btn { top: 14px; left: 14px; width: 32px; height: 32px; }
  }

  @media (max-width: 480px) {
    .page { padding: 28px 14px 48px; }
    .article-title { font-size: 1.5rem; }
    :global(.article-body > div) { margin: 1.5rem -6px; }
  }
</style>
