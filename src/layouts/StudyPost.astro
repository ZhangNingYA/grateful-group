---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import StudyMath from '../components/study/StudyMath.jsx';
import 'katex/dist/katex.min.css';
import '../styles/study.css';

type Props = CollectionEntry<'study'>['data'] & {
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  mode = 'lab',
  subject = 'Guided study',
  part,
  headings = [],
} = Astro.props;

const modeLabels = {
  lab: 'Concept lab',
  reading: 'Close reading',
  derivation: 'Derivation notebook',
  build: 'Build lab',
} as const;

const sections = headings.filter((heading) => heading.depth === 2);
const estimatedMinutes = part ? Math.max(35, sections.length * 10) : Math.max(10, sections.length * 3);
const kalmanSequence = [
  { href: '/study/kalman-filter/', title: '课程地图' },
  { href: '/study/kalman-filter-foundations/', title: '状态、证据与概率模型' },
  { href: '/study/kalman-filter-recursion/', title: '把递推式推导出来' },
  { href: '/study/kalman-filter-tuning/', title: 'Q、R、P 与动态响应' },
  { href: '/study/kalman-filter-diagnostics/', title: '创新检验与失效模式' },
  { href: '/study/kalman-filter-implementation/', title: '从方程到可靠软件' },
];
const sequenceIndex = Astro.url.pathname.startsWith('/study/kalman-filter') ? (part ?? 0) : -1;
const previousChapter = sequenceIndex > 0 ? kalmanSequence[sequenceIndex - 1] : undefined;
const nextChapter = sequenceIndex >= 0 ? kalmanSequence[sequenceIndex + 1] : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body
    class="textbook-page"
    data-study-page
    data-study-course={Astro.url.pathname}
    data-study-title={title}
  >
    <BlogHeader active="study" />

    <header class="textbook-cover">
      <div class="textbook-cover-inner">
        <a class="textbook-back" href="/study/">
          <span aria-hidden="true">←</span> Study desk
        </a>
        <div class="textbook-cover-grid">
          <div class="textbook-cover-copy">
            <div class="textbook-overline"><span>{part ? `Chapter ${String(part).padStart(2, '0')}` : 'Course map'}</span><span>{modeLabels[mode]}</span><span>{subject}</span></div>
            <h1>{title}</h1>
            <p class="textbook-subtitle">{description}</p>
            <div class="textbook-cover-actions">
              <a class="textbook-primary-action" href={`#${sections[0]?.slug ?? ''}`}>从第一节开始 <span aria-hidden="true">↓</span></a>
              <span class="textbook-reading-time">约 {estimatedMinutes} 分钟 · {sections.length} 个单元</span>
            </div>
          </div>
          <div class="textbook-cover-diagram" aria-label="本章学习循环">
            <div class="diagram-orbit diagram-orbit-one"></div>
            <div class="diagram-orbit diagram-orbit-two"></div>
            <div class="diagram-core"><StudyMath expression={'\\hat x'} /><small>estimate</small></div>
            <span class="diagram-label diagram-label-top">model</span>
            <span class="diagram-label diagram-label-right">evidence</span>
            <span class="diagram-label diagram-label-bottom">feedback</span>
          </div>
        </div>
        <div class="textbook-cover-footer">
          <span>Published <FormattedDate date={pubDate} /></span>
          {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
          <span>阅读时请边做推导，边完成检查。</span>
        </div>
      </div>
    </header>

    <main class="textbook-layout">
      <aside class="textbook-rail" aria-label="章节导航">
        <div class="rail-sticky">
          <div class="rail-heading"><span>Contents</span><b>{String(sections.length).padStart(2, '0')}</b></div>
          <ol>
            {sections.map((heading, index) => (
              <li>
                <a href={`#${heading.slug}`} data-study-nav-link={heading.slug}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <em>{heading.text.replace(/^\d+\s*\/\s*/, '')}</em>
                </a>
              </li>
            ))}
          </ol>
          <div class="rail-rule"></div>
          <p class="rail-note">这不是线性文章。可以先实验，再回到公式；每次回来都从上次留下的问题继续。</p>
        </div>
      </aside>

      <article
        class="textbook-content"
        data-study-document
        data-study-title={title}
        data-study-description={description}
      >
        <div class="textbook-introduction">
          <span class="textbook-label">How to use this chapter</span>
          <p>把它当成一本可以操作的教科书：先形成预测，再让数据反驳它；先写下自己的解释，再查看下一层公式。页面会记住你看过的章节和留下的笔记。</p>
        </div>
        <slot />
        {sequenceIndex >= 0 && (
          <nav class="textbook-course-nav" aria-label="课程章节导航">
            {previousChapter ? (
              <a href={previousChapter.href} rel="prev"><span>← 上一章</span><strong>{previousChapter.title}</strong></a>
            ) : <span></span>}
            {nextChapter ? (
              <a class="is-next" href={nextChapter.href} rel="next"><span>下一章 →</span><strong>{nextChapter.title}</strong></a>
            ) : (
              <a class="is-next" href="/study/kalman-filter/"><span>课程完成</span><strong>回到课程地图</strong></a>
            )}
          </nav>
        )}
        <footer class="textbook-endnote">
          <span>End of chapter</span>
          <a href="/study/">回到 Study desk →</a>
        </footer>
      </article>

      <aside class="textbook-inspector" aria-label="学习状态">
        <div class="inspector-sticky">
          <div class="inspector-card inspector-progress">
            <div class="inspector-card-head"><span>Chapter progress</span><b data-study-progress-percent>0%</b></div>
            <div class="inspector-progress-track"><span data-study-progress-bar></span></div>
            <p><strong data-study-progress-count>00</strong> / {String(sections.length).padStart(2, '0')} sections explored</p>
          </div>
          <div class="inspector-card inspector-current">
            <span class="textbook-label">现在所在</span>
            <strong data-study-current>开篇</strong>
            <span>滚动到下一节，页面会自动更新。</span>
          </div>
          <div class="inspector-card inspector-glossary">
            <span class="textbook-label">本章词典</span>
            <dl>
              <div><dt>状态 <StudyMath expression="x_k" /></dt><dd>真正想知道的量</dd></div>
              <div><dt>测量 <StudyMath expression="z_k" /></dt><dd>传感器给出的证据</dd></div>
              <div><dt>协方差 <StudyMath expression="P_k" /></dt><dd>对估计不确定性的量化</dd></div>
              <div><dt>增益 <StudyMath expression="K_k" /></dt><dd>这次如何映射创新</dd></div>
            </dl>
          </div>
        </div>
      </aside>
    </main>

    <script
      type="application/json"
      id="study-document-meta"
      set:html={JSON.stringify({
        title,
        description,
        course: Astro.url.pathname,
        sections: sections.map((section) => ({ id: section.slug, title: section.text })),
      })}
    ></script>

    <script define:vars={{ sectionCount: sections.length, sectionSlugs: sections.map((section) => section.slug) }}>
      const progressKey = `textbook-progress:${window.location.pathname}`;
      const headings = Array.from(document.querySelectorAll('.textbook-content h2'));
      const navLinks = Array.from(document.querySelectorAll('[data-study-nav-link]'));
      const completed = new Set();
      const progressBar = document.querySelector('[data-study-progress-bar]');
      const progressPercent = document.querySelector('[data-study-progress-percent]');
      const progressCount = document.querySelector('[data-study-progress-count]');
      const currentLabel = document.querySelector('[data-study-current]');

      document.querySelectorAll('.textbook-content h2').forEach((heading) => {
        if (heading.id) heading.dataset.studySection = heading.id;
      });

      try {
        JSON.parse(window.localStorage.getItem(progressKey) || '[]').forEach((key) => completed.add(key));
      } catch {
        // The textbook remains usable when storage is disabled.
      }

      const updateProgress = () => {
        const amount = Math.min(completed.size, sectionCount);
        const percent = sectionCount ? Math.round((amount / sectionCount) * 100) : 0;
        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressPercent) progressPercent.textContent = `${percent}%`;
        if (progressCount) progressCount.textContent = String(amount).padStart(2, '0');
      };

      const markComplete = (slug) => {
        if (!slug) return;
        completed.add(slug);
        try {
          window.localStorage.setItem(progressKey, JSON.stringify([...completed]));
        } catch {
          // Ignore persistence failures.
        }
        updateProgress();
      };

      const setCurrent = (slug) => {
        const heading = document.getElementById(slug);
        if (!heading) return;
        navLinks.forEach((link) => link.classList.toggle('is-current', link.dataset.studyNavLink === slug));
        if (currentLabel) currentLabel.textContent = heading.textContent || '当前章节';
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const slug = entry.target.getAttribute('id');
            markComplete(slug);
            setCurrent(slug);
          });
        }, { rootMargin: '-15% 0px -65% 0px', threshold: 0 });
        headings.forEach((heading) => observer.observe(heading));
      }

      navLinks.forEach((link) => link.addEventListener('click', () => setCurrent(link.dataset.studyNavLink)));
      updateProgress();
      setCurrent(sectionSlugs[0]);
    </script>
  </body>
</html>
