---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { ArrowLeft } from 'lucide-astro';
import BaseHead from '../components/BaseHead.astro';
import BlogHeader from '../components/blog/BlogHeader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import 'katex/dist/katex.min.css';
import '../styles/papers.css';

type Props = CollectionEntry<'papers'>['data'] & { headings: MarkdownHeading[] };
const { title, description, pubDate, updatedDate, authors, venue, year, topic, headings } = Astro.props;
const questions = headings.filter((heading) => heading.depth === 2 && heading.text.startsWith('问：'));
const reference = headings.find((heading) => heading.depth === 2 && heading.text === '原论文');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${title} · 论文笔记`} description={description} />
  </head>
  <body class="papers-page paper-note">
    <a class="papers-skip" href="#main">跳至正文</a>
    <BlogHeader active="papers" />

    <main id="main" class:list={['papers-shell', 'paper-document', { 'has-questions': questions.length > 0 }]}>
      <a class="paper-back" href="/papers/"><ArrowLeft size={15} stroke-width={1.6} /> All paper notes</a>

      <header class="paper-cover">
        <p class="papers-eyebrow"><span class="papers-dot" aria-hidden="true"></span> Reading note <span class="paper-cover-topic">{topic}</span></p>
        <h1>{title}</h1>
        <p class="paper-bibliography">{authors?.join('、')}{venue && <span>{venue}</span>}{year && <span>{year}</span>}</p>
        <p class="paper-cover-description">{description}</p>
        <div class="paper-cover-bottom">
          <span>Noted <FormattedDate date={pubDate} />{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}</span>
          {questions.length > 0 && <span>{String(questions.length).padStart(2, '0')} questions & answers</span>}
        </div>
      </header>

      <div class="paper-reading-layout">
        {questions.length > 0 && (
          <aside class="paper-contents" aria-label="问题导航">
            <div class="paper-contents-inner">
              <details open>
                <summary><span>On this page</span><span class="paper-contents-toggle" aria-hidden="true"></span></summary>
                <nav aria-label="问题目录">
                  <ol>
                    {questions.map((question, index) => (
                      <li>
                        <a href={`#${question.slug}`} data-question-link>
                          <span class="paper-nav-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                          <span>{question.text.replace(/^问：\s*/, '')}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                  {reference && <a class="paper-source-nav" href={`#${reference.slug}`}>原论文 <span aria-hidden="true">↗</span></a>}
                </nav>
              </details>
            </div>
          </aside>
        )}

        <article class="paper-prose" aria-label="论文笔记">
          <slot />
        </article>
      </div>
    </main>

    <footer class="papers-footer papers-shell">
      <a href="/">Tend <span> / A personal practice</span></a>
      <span>Stay curious.</span>
    </footer>

    <script>
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-question-link]'));
      const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));

      if (links.length) {
        const updateCurrentQuestion = () => {
          let current = -1;
          sections.forEach((section, index) => {
            if (section && section.getBoundingClientRect().top <= 180) current = index;
          });
          links.forEach((link, index) => {
            if (index === current) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        };

        let pending = false;
        window.addEventListener('scroll', () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => {
            updateCurrentQuestion();
            pending = false;
          });
        }, { passive: true });
        updateCurrentQuestion();
      }

      document.querySelectorAll<HTMLElement>('.paper-prose .katex-display').forEach((formula) => {
        formula.tabIndex = 0;
        formula.setAttribute('role', 'region');
        formula.setAttribute('aria-label', '公式，可使用左右方向键横向滚动');
      });
    </script>
  </body>
</html>
